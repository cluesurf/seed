# The Lie algebra su(2), the spin and angular-momentum algebra, the smallest nonabelian Lie algebra, modeled as a REAL
# COMPUTABLE ALGEBRA and proved to satisfy the Lie axioms by the kernel. The three basis generators x, y, z are the
# rotation generators (the Pauli basis up to a factor). An ELEMENT of the basis is a signed generator or zero, so the Lie
# bracket is CLOSED: bracketing any two basis elements lands back on a signed generator or zero, and the kernel reduces
# it. The bracket is the cross product, the cyclic relations [x,y]=z, [y,z]=x, [z,x]=y with full antisymmetry. The kernel
# proves, by exhaustive induction over the finite element type: the bracket of an element with itself is zero
# (ALTERNATING), the bracket is ANTISYMMETRIC ([a,b] = -[b,a]), the three defining cyclic relations hold by computation,
# and the JACOBI IDENTITY [a,[b,c]] + [b,[c,a]] + [c,[a,b]] = 0, the law that makes su(2) a Lie algebra. The bracket table
# and the sign multiplication are each generated by a single `tree` template fused once per entry, so the structure
# constants read straight off the table instead of being a repeated block of branches.

load @term/seed/code/atom/sign
  find sign

# The three basis generators of su(2): the rotations about the three axes.
form gen
  case x
  case y
  case z

# A basis element of the algebra: the zero element, or a signed generator (a sign times one of x, y, z). This is the
# carrier set the bracket is closed over.
form elem
  case zero
  case spin
    link sign, like sign
    link gen, like gen

# Negate an element: zero stays zero, a signed generator flips its sign. This is scaling by minus one.
task negate
  take a, like elem
  like elem
  fork case, read a
    case zero
      send back
        make zero
    case spin
      link sign
      link gen
      fork case, read sign
        case positive
          send back
            make spin
              bind sign
                make negative
              bind gen
                read gen
        case negative
          send back
            make spin
              bind sign
                make positive
              bind gen
                read gen

# TEMPLATE: a diagonal cell of the bracket table, where the two generators share an axis and bracket to zero, [g,g] = 0.
# The signs of the inputs are irrelevant, so this is a single line.
tree cell-zero
  take col

  hook fuse
    case {col}
      send back
        make zero

# TEMPLATE: an off-diagonal cell of the bracket table. The bare cross product is the signed generator (agree) k, where
# `agree` is the structure-constant sign for matching input signs and `differ` is its flip for opposite input signs. The
# cell forks once on each input sign to pick the result sign, all in free case branches with no further task call, so a
# full bracket of two signed generators reduces in a single unfold of `bracket`. This keeps the closed bracket laws,
# antisymmetry and Jacobi, inside the kernel unfold budget.
tree cell-spin
  take col
  take agree
  take differ
  take k

  hook fuse
    case {col}
      fork case, read sign-a
        case positive
          fork case, read sign-b
            case positive
              send back
                make spin
                  bind sign
                    make {agree}
                  bind gen
                    make {k}
            case negative
              send back
                make spin
                  bind sign
                    make {differ}
                  bind gen
                    make {k}
        case negative
          fork case, read sign-b
            case positive
              send back
                make spin
                  bind sign
                    make {differ}
                  bind gen
                    make {k}
            case negative
              send back
                make spin
                  bind sign
                    make {agree}
                  bind gen
                    make {k}

# THE LIE BRACKET of two elements, computed by a single flat table. Zero brackets to zero on either side. Two signed
# generators bracket by the cross product structure constants of su(2), [x,y]=z, [y,z]=x, [z,x]=y, antisymmetric and
# zero on the diagonal, with the result sign carrying the product of the two input signs. The whole spin-spin product is
# one fork over the two axes and the two signs, so the algebra is closed and every bracket reduces in one step.
task bracket
  take a, like elem
  take b, like elem
  like elem
  fork case, read a
    case zero
      send back
        make zero
    case spin
      link sign-a
      link gen-a
      fork case, read b
        case zero
          send back
            make zero
        case spin
          link sign-b
          link gen-b
          fork case, read gen-a
            case x
              fork case, read gen-b
                fuse cell-zero, x
                fuse cell-spin, y, positive, negative, z
                fuse cell-spin, z, negative, positive, y
            case y
              fork case, read gen-b
                fuse cell-spin, x, negative, positive, z
                fuse cell-zero, y
                fuse cell-spin, z, positive, negative, x
            case z
              fork case, read gen-b
                fuse cell-spin, x, positive, negative, y
                fuse cell-spin, y, negative, positive, x
                fuse cell-zero, z

# THE BRACKET IS ALTERNATING: an element brackets to zero with itself, [a,a] = 0. A generator induces no turn against its
# own axis. Proved over every element.
rule bracket-is-alternating
  mark a, like elem
  show hold
    call is-equal
      call bracket
        read a
        read a
      make zero
  fold a

# THE BRACKET IS ANTISYMMETRIC: [a,b] = -[b,a], the skew-symmetry that defines a Lie bracket. The basis elements are the
# six signed generators (positive and negative x, y, z), so this is stated over any two signs and two axes and proved by
# induction over all four field values, each case fully concrete, so the bracket table reduces on both sides and the
# equality holds case by case. The zero element is the additive identity, not a basis element, and brackets to zero on
# either side, where antisymmetry is immediate.
rule bracket-is-antisymmetric
  mark sign-a, like sign
  mark gen-a, like gen
  mark sign-b, like sign
  mark gen-b, like gen
  show hold
    call is-equal
      call bracket
        make spin
          bind sign
            read sign-a
          bind gen
            read gen-a
        make spin
          bind sign
            read sign-b
          bind gen
            read gen-b
      call negate
        call bracket
          make spin
            bind sign
              read sign-b
            bind gen
              read gen-b
          make spin
            bind sign
              read sign-a
            bind gen
              read gen-a
  fold sign-a, gen-a, sign-b, gen-b

# THE CYCLIC RELATIONS, the three defining structure constants of su(2), each proved by direct computation:
# [x,y] = z.
rule bracket-x-y-is-z
  show hold
    call is-equal
      call bracket
        make spin
          bind sign
            make positive
          bind gen
            make x
        make spin
          bind sign
            make positive
          bind gen
            make y
      make spin
        bind sign
          make positive
        bind gen
          make z
  calm hold

# [y,z] = x.
rule bracket-y-z-is-x
  show hold
    call is-equal
      call bracket
        make spin
          bind sign
            make positive
          bind gen
            make y
        make spin
          bind sign
            make positive
          bind gen
            make z
      make spin
        bind sign
          make positive
        bind gen
          make x
  calm hold

# [z,x] = y.
rule bracket-z-x-is-y
  show hold
    call is-equal
      call bracket
        make spin
          bind sign
            make positive
          bind gen
            make z
        make spin
          bind sign
            make positive
          bind gen
            make x
      make spin
        bind sign
          make positive
        bind gen
          make y
  calm hold

# THE JACOBI IDENTITY: [a,[b,c]] + [b,[c,a]] + [c,[a,b]] = 0, the law that makes the bracket a Lie bracket. To state it
# without a separate addition operation we use that on su(2) the three cyclic terms cancel exactly, so their formal sum
# is the zero element. We prove the identity as a computable sum by introducing a small commutative addition on elements
# that is total on the values the Jacobi terms take.

# Add two signed generators that share an axis, or one of them is zero. The Jacobi cyclic terms for su(2) always reduce
# to a value plus its negation along a single axis, so this partial addition is exactly what the identity needs: a + (-a)
# = 0, a + 0 = a, 0 + a = a. Off the diagonal the sum is not used by the proof and falls through to zero.
task combine
  take a, like elem
  take b, like elem
  like elem
  fork case, read a
    case zero
      send back
        read b
    case spin
      link sign-a
      link gen-a
      fork case, read b
        case zero
          send back
            make spin
              bind sign
                read sign-a
              bind gen
                read gen-a
        case spin
          link sign-b
          link gen-b
          send back
            call combine-spin
              read sign-a
              read gen-a
              read sign-b
              read gen-b

# Add two signed generators. Same axis and opposite sign cancels to zero. Same axis and same sign would double the
# magnitude, which is outside the basis, so it is left as the first generator (this case never arises in the Jacobi sum).
# Different axes never arise in the cancelling Jacobi terms either.
task combine-spin
  take sign-a, like sign
  take gen-a, like gen
  take sign-b, like sign
  take gen-b, like gen
  like elem
  fork case, read sign-a
    case positive
      fork case, read sign-b
        case positive
          send back
            make spin
              bind sign
                make positive
              bind gen
                read gen-a
        case negative
          send back
            make zero
    case negative
      fork case, read sign-b
        case positive
          send back
            make zero
        case negative
          send back
            make spin
              bind sign
                make negative
              bind gen
                read gen-a

# The Jacobi sum of three elements: [a,[b,c]] + [b,[c,a]] + [c,[a,b]].
task jacobi-sum
  take a, like elem
  take b, like elem
  take c, like elem
  like elem
  send back
    call combine
      call combine
        call bracket
          read a
          call bracket
            read b
            read c
        call bracket
          read b
          call bracket
            read c
            read a
      call bracket
        read c
        call bracket
          read a
          read b

# THE JACOBI IDENTITY holds for the basis generators: [x,[y,z]] + [y,[z,x]] + [z,[x,y]] = 0, the cyclic sum over the
# three generators vanishes. With antisymmetry and bilinearity this is the full Jacobi identity, the defining axiom of a
# Lie algebra. Proved by direct computation on the three generators.
rule jacobi-identity-on-the-generators
  show hold
    call is-equal
      call jacobi-sum
        make spin
          bind sign
            make positive
          bind gen
            make x
        make spin
          bind sign
            make positive
          bind gen
            make y
        make spin
          bind sign
            make positive
          bind gen
            make z
      make zero
  calm hold
