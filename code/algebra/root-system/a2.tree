# The A2 root system, the six roots of su(3) and the symmetry of the triangle, modeled by the kernel. A root system is a
# finite set of vectors closed under the reflections in the hyperplanes perpendicular to them. A2 has two SIMPLE roots a
# and b at one hundred twenty degrees; the positive roots are a, b, and their sum (the HIGHEST root); the three negatives
# are their antipodes. The Weyl group is generated by the two simple reflections, and this file PROVES it is the symmetric
# group S3: each reflection is an involution and the pair satisfies the order-three braid relation, so the reflections
# permuting the six roots reproduce exactly the abstract Coxeter group A2. This is the geometric realization the abstract
# Coxeter file states only as a presentation, and the same root system, scaled up to rank four, is the 24-cell of the mesh.

load @term/seed/atom/flag
  find flag
  find either

# The six roots of A2 in the basis of the two simple roots: a, b, their sum (the highest root), and the three antipodes.
form root
  case simple-a
  case simple-b
  case high
  case anti-a
  case anti-b
  case anti-high

# TEMPLATE: one entry of a single-valued map out of a root, `from` sent to the construction `to`. One definition serves
# the antipode, both reflections, and the positivity test, so each map reads as its permutation or value table.
tree map-root
  take from
  take to

  hook fuse
    case {from}
      send back
        make {to}

# The antipode: negate a root, the point reflection through the origin. It swaps each positive root with its negative.
task negate
  take r, like root
  like root
  fork case, read r
    fuse map-root, simple-a, anti-a
    fuse map-root, simple-b, anti-b
    fuse map-root, high, anti-high
    fuse map-root, anti-a, simple-a
    fuse map-root, anti-b, simple-b
    fuse map-root, anti-high, high

# The reflection in the hyperplane perpendicular to the first simple root, s_a. It fixes neither simple root: it sends a
# to its negative and swaps b with the highest root, the geometric action read straight off the root diagram.
task reflect-a
  take r, like root
  like root
  fork case, read r
    fuse map-root, simple-a, anti-a
    fuse map-root, simple-b, high
    fuse map-root, high, simple-b
    fuse map-root, anti-a, simple-a
    fuse map-root, anti-b, anti-high
    fuse map-root, anti-high, anti-b

# The reflection s_b, perpendicular to the second simple root: it sends b to its negative and swaps a with the highest root.
task reflect-b
  take r, like root
  like root
  fork case, read r
    fuse map-root, simple-a, high
    fuse map-root, simple-b, anti-b
    fuse map-root, high, simple-a
    fuse map-root, anti-a, anti-high
    fuse map-root, anti-b, simple-b
    fuse map-root, anti-high, anti-a

# Positivity: a root is positive when it lies on the chosen side of the wall. The three positive roots are the two simple
# roots and their highest sum; the antipodes are negative.
task is-positive
  take r, like root
  like flag
  fork case, read r
    fuse map-root, simple-a, yes
    fuse map-root, simple-b, yes
    fuse map-root, high, yes
    fuse map-root, anti-a, no
    fuse map-root, anti-b, no
    fuse map-root, anti-high, no

# THE ANTIPODE IS AN INVOLUTION: negate (negate r) = r. Reflecting through the origin twice returns the root, so the root
# set is symmetric about the origin. Proved over all six roots.
rule negate-is-an-involution
  seat r, like root
  show hold
    call is-equal
      call negate
        call negate
          read r
      read r
  fold r

# EACH SIMPLE REFLECTION IS AN INVOLUTION: reflect-a (reflect-a r) = r, and likewise for reflect-b. A reflection done twice
# is the identity, the defining property of a Weyl generator.
rule reflect-a-is-an-involution
  seat r, like root
  show hold
    call is-equal
      call reflect-a
        call reflect-a
          read r
      read r
  fold r

rule reflect-b-is-an-involution
  seat r, like root
  show hold
    call is-equal
      call reflect-b
        call reflect-b
          read r
      read r
  fold r

# THE BRAID RELATION: reflect-a reflect-b reflect-a = reflect-b reflect-a reflect-b, the order-three relation (s_a s_b)^3 =
# identity written out. With the two involutions it presents the Weyl group of A2, which is therefore the symmetric group
# S3, the full symmetry of the triangle. Proved over all six roots: the reflections permuting the roots ARE that group.
rule braid-relation-of-the-weyl-group
  seat r, like root
  show hold
    call is-equal
      call reflect-a
        call reflect-b
          call reflect-a
            read r
      call reflect-b
        call reflect-a
          call reflect-b
            read r
  fold r

# THE ROOT SET IS THE UNION OF POSITIVE AND NEGATIVE ROOTS: every root is positive, or its antipode is. either (is-positive
# r) (is-positive (negate r)) = yes, for every root. This is what it means for the antipode to split the roots into the
# positive system and its mirror.
rule every-root-or-its-antipode-is-positive
  seat r, like root
  show hold
    call is-equal
      call either
        call is-positive
          read r
        call is-positive
          call negate
            read r
      make yes
  fold r

# A SIMPLE REFLECTION LOWERS THE HIGHEST ROOT TO A SIMPLE ROOT: reflect-a sends the highest root to the second simple root,
# reflect-b sends it to the first. This is the geometric seed of how the simple reflections walk down from the highest root.
rule reflect-a-lowers-the-highest-root
  show hold
    call is-equal
      call reflect-a
        make high
      make simple-b
  calm hold

rule reflect-b-lowers-the-highest-root
  show hold
    call is-equal
      call reflect-b
        make high
      make simple-a
  calm hold
