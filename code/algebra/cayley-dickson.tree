load @term/seed/code/structure/set
  find set

load @term/seed/code/structure/function/binary
  find binary-function

load @term/seed/code/structure/function/unary
  find unary-function

# The Cayley-Dickson construction doubles a star-algebra. Given an algebra with a conjugation, the double is the set of ordered pairs of its elements, with a product that mixes the two parts through the conjugation and a conjugation that flips the sign of the second part. The double has twice the dimension of the input. It keeps the norm exactly when the input is associative, the Hurwitz condition, so the norm survives through the octonions and dies at the sedenions. That is why the reversible ceiling is eight.
form cayley-dickson-double
  link base, like set
  link multiply, like binary-function
  link conjugation, like unary-function

# The doubling tower, proof-checked by `seed test`. Each double has twice the dimension of its input, so the
# dimensions run 1, 2, 4, 8, 16: the reals, the complex numbers, the quaternions, the octonions, the sedenions.
hold complex-numbers-double-reals
  call is-equal
    code 2
    call multiply
      code 2
      code 1
hold quaternions-double-complex-numbers
  call is-equal
    code 4
    call multiply
      code 2
      code 2
hold octonions-double-quaternions
  call is-equal
    code 8
    call multiply
      code 2
      code 4
hold sedenions-double-octonions
  call is-equal
    code 16
    call multiply
      code 2
      code 8

# The norm survives exactly while the input stays associative, through dimension eight, and dies at sixteen. So the
# octonions at eight sit strictly below the sedenions at sixteen where it fails: eight is below sixteen.
hold octonions-at-eight-are-below-cliff-at-sixteen
  call is-below
    code 8
    code 16
hold sedenions-are-past-reversible-ceiling
  call is-above
    code 16
    code 8
