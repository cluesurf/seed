# The Clifford algebra Cl(3,0), the geometric algebra of three-dimensional space and the home of the Pauli spinors,
# modeled as a REAL COMPUTABLE algebra. Three generators e1, e2, e3 each square to PLUS ONE and ANTICOMMUTE; their
# products give eight basis blades: the scalar one, the three vectors e1 e2 e3, the three bivectors e12 e13 e23, and the
# pseudoscalar e123. You multiply any two blades and the kernel computes a SIGNED blade (a sign times one of the eight),
# exactly the geometric product, and proves the defining facts: each generator squares to plus one, distinct generators
# anticommute (e1 e2 = - e2 e1, and the rest), the pseudoscalar e123 squares to MINUS one so it behaves like the
# imaginary unit, and the even subalgebra (one, e12, e13, e23) is closed and reproduces the QUATERNIONS, each even
# bivector squaring to minus one with e12 e13 = - e23. The full sixty-four-entry blade product is generated by a single
# `tree` TEMPLATE, one fused line per entry, never a hand-repeated block. Cl(3,0) is the Pauli algebra, the two-by-two
# complex matrices, the smallest geometric algebra that carries the spin-one-half structure of ordinary three-space.

form sign
  case pos
  case neg

# The eight basis blades of Cl(3,0): one scalar, three vectors, three bivectors, one pseudoscalar.
form blade
  case one
  case e1
  case e2
  case e3
  case e12
  case e13
  case e23
  case e123

# A Clifford element in this finite model: a signed basis blade.
form cliff
  case scaled
    link sign, like sign
    link blade, like blade

task mul-sign
  take a, like sign
  take b, like sign
  like sign
  fork case, read a
    case pos
      send back
        read b
    case neg
      fork case, read b
        case pos
          send back
            make neg
        case neg
          send back
            make pos

task flip-sign
  take s, like sign
  like sign
  fork case, read s
    case pos
      send back
        make neg
    case neg
      send back
        make pos

# TEMPLATE: one entry of the blade product table. Given the second blade and the resulting signed blade, emit the case
# branch. This single definition replaces every repeated `case .. / send back / make scaled / ..` block.
tree mul-entry
  take col
  take s
  take res

  hook fuse
    case {col}
      send back
        make scaled
          bind sign
            make {s}
          bind blade
            make {res}

# THE BLADE PRODUCT, the geometric product of two basis blades. Each blade is a product of distinct generators in sorted
# order; multiplying concatenates them, anticommutes generators back into sorted order (each swap a minus), and cancels
# equal generators (each square plus one). The result is always a signed basis blade, so the algebra is closed. Each row
# fuses the template eight times, read straight off that computation.
task mul-blade
  take a, like blade
  take b, like blade
  like cliff
  fork case, read a
    case one
      fork case, read b
        fuse mul-entry, one, pos, one
        fuse mul-entry, e1, pos, e1
        fuse mul-entry, e2, pos, e2
        fuse mul-entry, e3, pos, e3
        fuse mul-entry, e12, pos, e12
        fuse mul-entry, e13, pos, e13
        fuse mul-entry, e23, pos, e23
        fuse mul-entry, e123, pos, e123
    case e1
      fork case, read b
        fuse mul-entry, one, pos, e1
        fuse mul-entry, e1, pos, one
        fuse mul-entry, e2, pos, e12
        fuse mul-entry, e3, pos, e13
        fuse mul-entry, e12, pos, e2
        fuse mul-entry, e13, pos, e3
        fuse mul-entry, e23, pos, e123
        fuse mul-entry, e123, pos, e23
    case e2
      fork case, read b
        fuse mul-entry, one, pos, e2
        fuse mul-entry, e1, neg, e12
        fuse mul-entry, e2, pos, one
        fuse mul-entry, e3, pos, e23
        fuse mul-entry, e12, neg, e1
        fuse mul-entry, e13, neg, e123
        fuse mul-entry, e23, pos, e3
        fuse mul-entry, e123, neg, e13
    case e3
      fork case, read b
        fuse mul-entry, one, pos, e3
        fuse mul-entry, e1, neg, e13
        fuse mul-entry, e2, neg, e23
        fuse mul-entry, e3, pos, one
        fuse mul-entry, e12, pos, e123
        fuse mul-entry, e13, neg, e1
        fuse mul-entry, e23, neg, e2
        fuse mul-entry, e123, pos, e12
    case e12
      fork case, read b
        fuse mul-entry, one, pos, e12
        fuse mul-entry, e1, neg, e2
        fuse mul-entry, e2, pos, e1
        fuse mul-entry, e3, pos, e123
        fuse mul-entry, e12, neg, one
        fuse mul-entry, e13, neg, e23
        fuse mul-entry, e23, pos, e13
        fuse mul-entry, e123, neg, e3
    case e13
      fork case, read b
        fuse mul-entry, one, pos, e13
        fuse mul-entry, e1, neg, e3
        fuse mul-entry, e2, neg, e123
        fuse mul-entry, e3, pos, e1
        fuse mul-entry, e12, pos, e23
        fuse mul-entry, e13, neg, one
        fuse mul-entry, e23, neg, e12
        fuse mul-entry, e123, pos, e2
    case e23
      fork case, read b
        fuse mul-entry, one, pos, e23
        fuse mul-entry, e1, pos, e123
        fuse mul-entry, e2, neg, e3
        fuse mul-entry, e3, pos, e2
        fuse mul-entry, e12, neg, e13
        fuse mul-entry, e13, pos, e12
        fuse mul-entry, e23, neg, one
        fuse mul-entry, e123, neg, e1
    case e123
      fork case, read b
        fuse mul-entry, one, pos, e123
        fuse mul-entry, e1, pos, e23
        fuse mul-entry, e2, neg, e13
        fuse mul-entry, e3, pos, e12
        fuse mul-entry, e12, neg, e3
        fuse mul-entry, e13, pos, e2
        fuse mul-entry, e23, neg, e1
        fuse mul-entry, e123, neg, one

task apply-signs
  take sx, like sign
  take sy, like sign
  take prod, like cliff
  like cliff
  fork case, read prod
    case scaled
      link sp
      link bp
      send back
        make scaled
          bind sign
            call mul-sign
              call mul-sign
                read sx
                read sy
              read sp
          bind blade
            read bp

# THE GEOMETRIC PRODUCT of two Clifford elements: multiply any two, the result is always a Clifford element.
task mul
  take x, like cliff
  take y, like cliff
  like cliff
  fork case, read x
    case scaled
      link sx
      link bx
      fork case, read y
        case scaled
          link sy
          link by
          send back
            call apply-signs
              read sx
              read sy
              call mul-blade
                read bx
                read by

# Negate a signed blade: flip its sign.
task negate
  take x, like cliff
  like cliff
  fork case, read x
    case scaled
      link s
      link b
      send back
        make scaled
          bind sign
            call flip-sign
              read s
          bind blade
            read b

# TEMPLATE: a single product fact, mul (pos a) (pos b) = (sign) c, as one line.
tree product
  take name
  take a
  take b
  take rs
  take rc

  hook fuse
    rule {name}
      show hold
        call is-equal
          call mul
            make scaled
              bind sign
                make pos
              bind blade
                make {a}
            make scaled
              bind sign
                make pos
              bind blade
                make {b}
          make scaled
            bind sign
              make {rs}
            bind blade
              make {rc}
      calm hold

# THE GENERATORS SQUARE TO PLUS ONE. This is the (3,0) signature: positive-definite, unlike Cl(0,2) where they square to
# minus one. One line each.
fuse product, e1-squared-is-plus-one, e1, e1, pos, one
fuse product, e2-squared-is-plus-one, e2, e2, pos, one
fuse product, e3-squared-is-plus-one, e3, e3, pos, one

# THE VECTOR PRODUCTS that name the bivectors, e1 e2 = e12 and the rest.
fuse product, e1-times-e2-is-the-bivector-e12, e1, e2, pos, e12
fuse product, e1-times-e3-is-the-bivector-e13, e1, e3, pos, e13
fuse product, e2-times-e3-is-the-bivector-e23, e2, e3, pos, e23

# THE PSEUDOSCALAR e123 SQUARES TO MINUS ONE. The top blade behaves like the imaginary unit i, the hallmark of Cl(3,0).
# It also commutes with everything, which is why complex structure lives in the center of the Pauli algebra.
fuse product, pseudoscalar-squares-to-minus-one, e123, e123, neg, one

# THE EVEN SUBALGEBRA, the blades of even grade (one, e12, e13, e23), is closed under the product and IS the quaternions.
# Each bivector squares to minus one, the imaginary-unit relation. One line each.
fuse product, e12-squared-is-minus-one, e12, e12, neg, one
fuse product, e13-squared-is-minus-one, e13, e13, neg, one
fuse product, e23-squared-is-minus-one, e23, e23, neg, one

# The quaternion CYCLE inside the even subalgebra: e12 e13 = - e23, e23 e12 = - e13, e13 e23 = - e12. With i = e23,
# j = - e13, k = e12 these are the quaternion relations i j = k and the cycle, so the even part is the quaternion algebra.
fuse product, e12-times-e13-is-minus-e23, e12, e13, neg, e23
fuse product, e23-times-e12-is-minus-e13, e23, e12, neg, e13
fuse product, e13-times-e23-is-minus-e12, e13, e23, neg, e12

# ANTICOMMUTATION of the three generators, the defining relation of a Clifford algebra for distinct generators. The
# forward product e1 e2 = pos e12 and the reverse e2 e1 = neg e12 carry OPPOSITE signs, so e1 e2 = - e2 e1, and likewise
# for the other two pairs. Each reverse is a one-line literal product fact, the negative of its forward partner above.
# (The kernel `calm hold` normalizes one computed product against a literal, so anticommutation is witnessed by the pair
# of signed facts rather than by a single `negate`-of-a-product comparison, which would normalize two product chains at
# once and exceeds the tactic's reduction budget.)
fuse product, e2-times-e1-is-minus-e12, e2, e1, neg, e12
fuse product, e3-times-e1-is-minus-e13, e3, e1, neg, e13
fuse product, e3-times-e2-is-minus-e23, e3, e2, neg, e23

# THE IDENTITY: the scalar one times any Clifford element is itself, over all signed blades.
rule one-is-the-identity
  seat x, like cliff
  show hold
    call is-equal
      call mul
        make scaled
          bind sign
            make pos
          bind blade
            make one
        read x
      read x
  fold x

# NEGATION FLIPS THE SIGN: negating the forward product e1 e2 = pos e12 gives neg e12, exactly the reverse product
# e2 e1. This exercises `negate` against a literal and shows the two anticommuting products are negatives of each other.
rule negate-e1-e2-is-the-reverse-product
  show hold
    call is-equal
      call negate
        call mul
          make scaled
            bind sign
              make pos
            bind blade
              make e1
          make scaled
            bind sign
              make pos
            bind blade
              make e2
      make scaled
        bind sign
          make neg
        bind blade
          make e12
  calm hold
