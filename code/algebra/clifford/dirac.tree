# The Dirac algebra Cl(1,3), the spacetime Clifford algebra and the home of the Dirac equation and relativistic
# spinors, modeled as a REAL COMPUTABLE algebra. Four generators gamma0 gamma1 gamma2 gamma3 carry the Minkowski
# signature: the timelike gamma0 squares to PLUS ONE, the three spacelike gamma1 gamma2 gamma3 each square to MINUS
# ONE, and distinct generators ANTICOMMUTE. The defining Clifford relation is the anticommutator gamma_mu gamma_nu +
# gamma_nu gamma_mu = 2 eta_{mu nu}, the spacetime metric with diagonal plus minus minus minus. Multiplying the four
# generators in all distinct combinations yields the sixteen basis blades: the scalar one, four vectors, six bivectors,
# four trivectors, and the pseudoscalar gamma0123. You multiply any two blades and the kernel computes a SIGNED blade,
# exactly the geometric product, so the algebra is closed and finite.
#
# In the Dirac equation (i gamma^mu partial_mu - m) psi = 0 the gammas turn the relativistic energy-momentum relation
# into a first-order operator, and the square of the Dirac operator reproduces the Klein-Gordon equation precisely
# because the gammas obey the Clifford relation above. The CHIRALITY element gamma5 = gamma0 gamma1 gamma2 gamma3 is
# the pseudoscalar. It squares to MINUS ONE and ANTICOMMUTES with every gamma_mu, which is why it splits a Dirac
# spinor into left-handed and right-handed (chiral) parts: the projectors are (one plus or minus gamma5) over two.
#
# The full two-hundred-fifty-six-entry blade product is generated by a single `tree` TEMPLATE, one fused line per
# entry, never a hand-repeated block. Each row was computed once by concatenating index lists, anticommuting back into
# sorted order (each swap a minus), and cancelling equal generators (each square plus one for index 0, minus one for
# indices 1 2 3, the signature).

form sign
  case pos
  case neg

# The sixteen basis blades of Cl(1,3): one scalar, four vectors, six bivectors, four trivectors, one pseudoscalar.
# A blade name records the distinct generator indices in sorted order, so g013 is gamma0 gamma1 gamma3.
form blade
  case one
  case g0
  case g1
  case g2
  case g3
  case g01
  case g02
  case g03
  case g12
  case g13
  case g23
  case g012
  case g013
  case g023
  case g123
  case g0123

# A Clifford element in this finite model: a signed basis blade.
form cliff
  case scaled
    link sign, like sign
    link blade, like blade

task mul-sign
  take a, like sign
  take b, like sign
  like sign
  fork case, read a
    case pos
      send back
        read b
    case neg
      fork case, read b
        case pos
          send back
            make neg
        case neg
          send back
            make pos

task flip-sign
  take s, like sign
  like sign
  fork case, read s
    case pos
      send back
        make neg
    case neg
      send back
        make pos

# TEMPLATE: one entry of the blade product table. Given the second blade and the resulting signed blade, emit the case
# branch. This single definition replaces every repeated `case .. / send back / make scaled / ..` block.
tree mul-entry
  take col
  take s
  take res

  hook fuse
    case {col}
      send back
        make scaled
          bind sign
            make {s}
          bind blade
            make {res}

# THE BLADE PRODUCT, the geometric product of two basis blades. Each blade is a product of distinct gammas in sorted
# order; multiplying concatenates them, anticommutes generators back into sorted order (each swap a minus), and cancels
# equal generators by their square (plus one for the timelike gamma0, minus one for the spacelike gamma1 gamma2 gamma3).
# The result is always a signed basis blade, so the algebra is closed. Each row fuses the template sixteen times, read
# straight off that computation.
task mul-blade
  take a, like blade
  take b, like blade
  like cliff
  fork case, read a
    case one
      fork case, read b
        fuse mul-entry, one, pos, one
        fuse mul-entry, g0, pos, g0
        fuse mul-entry, g1, pos, g1
        fuse mul-entry, g2, pos, g2
        fuse mul-entry, g3, pos, g3
        fuse mul-entry, g01, pos, g01
        fuse mul-entry, g02, pos, g02
        fuse mul-entry, g03, pos, g03
        fuse mul-entry, g12, pos, g12
        fuse mul-entry, g13, pos, g13
        fuse mul-entry, g23, pos, g23
        fuse mul-entry, g012, pos, g012
        fuse mul-entry, g013, pos, g013
        fuse mul-entry, g023, pos, g023
        fuse mul-entry, g123, pos, g123
        fuse mul-entry, g0123, pos, g0123
    case g0
      fork case, read b
        fuse mul-entry, one, pos, g0
        fuse mul-entry, g0, pos, one
        fuse mul-entry, g1, pos, g01
        fuse mul-entry, g2, pos, g02
        fuse mul-entry, g3, pos, g03
        fuse mul-entry, g01, pos, g1
        fuse mul-entry, g02, pos, g2
        fuse mul-entry, g03, pos, g3
        fuse mul-entry, g12, pos, g012
        fuse mul-entry, g13, pos, g013
        fuse mul-entry, g23, pos, g023
        fuse mul-entry, g012, pos, g12
        fuse mul-entry, g013, pos, g13
        fuse mul-entry, g023, pos, g23
        fuse mul-entry, g123, pos, g0123
        fuse mul-entry, g0123, pos, g123
    case g1
      fork case, read b
        fuse mul-entry, one, pos, g1
        fuse mul-entry, g0, neg, g01
        fuse mul-entry, g1, neg, one
        fuse mul-entry, g2, pos, g12
        fuse mul-entry, g3, pos, g13
        fuse mul-entry, g01, pos, g0
        fuse mul-entry, g02, neg, g012
        fuse mul-entry, g03, neg, g013
        fuse mul-entry, g12, neg, g2
        fuse mul-entry, g13, neg, g3
        fuse mul-entry, g23, pos, g123
        fuse mul-entry, g012, pos, g02
        fuse mul-entry, g013, pos, g03
        fuse mul-entry, g023, neg, g0123
        fuse mul-entry, g123, neg, g23
        fuse mul-entry, g0123, pos, g023
    case g2
      fork case, read b
        fuse mul-entry, one, pos, g2
        fuse mul-entry, g0, neg, g02
        fuse mul-entry, g1, neg, g12
        fuse mul-entry, g2, neg, one
        fuse mul-entry, g3, pos, g23
        fuse mul-entry, g01, pos, g012
        fuse mul-entry, g02, pos, g0
        fuse mul-entry, g03, neg, g023
        fuse mul-entry, g12, pos, g1
        fuse mul-entry, g13, neg, g123
        fuse mul-entry, g23, neg, g3
        fuse mul-entry, g012, neg, g01
        fuse mul-entry, g013, pos, g0123
        fuse mul-entry, g023, pos, g03
        fuse mul-entry, g123, pos, g13
        fuse mul-entry, g0123, neg, g013
    case g3
      fork case, read b
        fuse mul-entry, one, pos, g3
        fuse mul-entry, g0, neg, g03
        fuse mul-entry, g1, neg, g13
        fuse mul-entry, g2, neg, g23
        fuse mul-entry, g3, neg, one
        fuse mul-entry, g01, pos, g013
        fuse mul-entry, g02, pos, g023
        fuse mul-entry, g03, pos, g0
        fuse mul-entry, g12, pos, g123
        fuse mul-entry, g13, pos, g1
        fuse mul-entry, g23, pos, g2
        fuse mul-entry, g012, neg, g0123
        fuse mul-entry, g013, neg, g01
        fuse mul-entry, g023, neg, g02
        fuse mul-entry, g123, neg, g12
        fuse mul-entry, g0123, pos, g012
    case g01
      fork case, read b
        fuse mul-entry, one, pos, g01
        fuse mul-entry, g0, neg, g1
        fuse mul-entry, g1, neg, g0
        fuse mul-entry, g2, pos, g012
        fuse mul-entry, g3, pos, g013
        fuse mul-entry, g01, pos, one
        fuse mul-entry, g02, neg, g12
        fuse mul-entry, g03, neg, g13
        fuse mul-entry, g12, neg, g02
        fuse mul-entry, g13, neg, g03
        fuse mul-entry, g23, pos, g0123
        fuse mul-entry, g012, pos, g2
        fuse mul-entry, g013, pos, g3
        fuse mul-entry, g023, neg, g123
        fuse mul-entry, g123, neg, g023
        fuse mul-entry, g0123, pos, g23
    case g02
      fork case, read b
        fuse mul-entry, one, pos, g02
        fuse mul-entry, g0, neg, g2
        fuse mul-entry, g1, neg, g012
        fuse mul-entry, g2, neg, g0
        fuse mul-entry, g3, pos, g023
        fuse mul-entry, g01, pos, g12
        fuse mul-entry, g02, pos, one
        fuse mul-entry, g03, neg, g23
        fuse mul-entry, g12, pos, g01
        fuse mul-entry, g13, neg, g0123
        fuse mul-entry, g23, neg, g03
        fuse mul-entry, g012, neg, g1
        fuse mul-entry, g013, pos, g123
        fuse mul-entry, g023, pos, g3
        fuse mul-entry, g123, pos, g013
        fuse mul-entry, g0123, neg, g13
    case g03
      fork case, read b
        fuse mul-entry, one, pos, g03
        fuse mul-entry, g0, neg, g3
        fuse mul-entry, g1, neg, g013
        fuse mul-entry, g2, neg, g023
        fuse mul-entry, g3, neg, g0
        fuse mul-entry, g01, pos, g13
        fuse mul-entry, g02, pos, g23
        fuse mul-entry, g03, pos, one
        fuse mul-entry, g12, pos, g0123
        fuse mul-entry, g13, pos, g01
        fuse mul-entry, g23, pos, g02
        fuse mul-entry, g012, neg, g123
        fuse mul-entry, g013, neg, g1
        fuse mul-entry, g023, neg, g2
        fuse mul-entry, g123, neg, g012
        fuse mul-entry, g0123, pos, g12
    case g12
      fork case, read b
        fuse mul-entry, one, pos, g12
        fuse mul-entry, g0, pos, g012
        fuse mul-entry, g1, pos, g2
        fuse mul-entry, g2, neg, g1
        fuse mul-entry, g3, pos, g123
        fuse mul-entry, g01, pos, g02
        fuse mul-entry, g02, neg, g01
        fuse mul-entry, g03, pos, g0123
        fuse mul-entry, g12, neg, one
        fuse mul-entry, g13, pos, g23
        fuse mul-entry, g23, neg, g13
        fuse mul-entry, g012, neg, g0
        fuse mul-entry, g013, pos, g023
        fuse mul-entry, g023, neg, g013
        fuse mul-entry, g123, neg, g3
        fuse mul-entry, g0123, neg, g03
    case g13
      fork case, read b
        fuse mul-entry, one, pos, g13
        fuse mul-entry, g0, pos, g013
        fuse mul-entry, g1, pos, g3
        fuse mul-entry, g2, neg, g123
        fuse mul-entry, g3, neg, g1
        fuse mul-entry, g01, pos, g03
        fuse mul-entry, g02, neg, g0123
        fuse mul-entry, g03, neg, g01
        fuse mul-entry, g12, neg, g23
        fuse mul-entry, g13, neg, one
        fuse mul-entry, g23, pos, g12
        fuse mul-entry, g012, neg, g023
        fuse mul-entry, g013, neg, g0
        fuse mul-entry, g023, pos, g012
        fuse mul-entry, g123, pos, g2
        fuse mul-entry, g0123, pos, g02
    case g23
      fork case, read b
        fuse mul-entry, one, pos, g23
        fuse mul-entry, g0, pos, g023
        fuse mul-entry, g1, pos, g123
        fuse mul-entry, g2, pos, g3
        fuse mul-entry, g3, neg, g2
        fuse mul-entry, g01, pos, g0123
        fuse mul-entry, g02, pos, g03
        fuse mul-entry, g03, neg, g02
        fuse mul-entry, g12, pos, g13
        fuse mul-entry, g13, neg, g12
        fuse mul-entry, g23, neg, one
        fuse mul-entry, g012, pos, g013
        fuse mul-entry, g013, neg, g012
        fuse mul-entry, g023, neg, g0
        fuse mul-entry, g123, neg, g1
        fuse mul-entry, g0123, neg, g01
    case g012
      fork case, read b
        fuse mul-entry, one, pos, g012
        fuse mul-entry, g0, pos, g12
        fuse mul-entry, g1, pos, g02
        fuse mul-entry, g2, neg, g01
        fuse mul-entry, g3, pos, g0123
        fuse mul-entry, g01, pos, g2
        fuse mul-entry, g02, neg, g1
        fuse mul-entry, g03, pos, g123
        fuse mul-entry, g12, neg, g0
        fuse mul-entry, g13, pos, g023
        fuse mul-entry, g23, neg, g013
        fuse mul-entry, g012, neg, one
        fuse mul-entry, g013, pos, g23
        fuse mul-entry, g023, neg, g13
        fuse mul-entry, g123, neg, g03
        fuse mul-entry, g0123, neg, g3
    case g013
      fork case, read b
        fuse mul-entry, one, pos, g013
        fuse mul-entry, g0, pos, g13
        fuse mul-entry, g1, pos, g03
        fuse mul-entry, g2, neg, g0123
        fuse mul-entry, g3, neg, g01
        fuse mul-entry, g01, pos, g3
        fuse mul-entry, g02, neg, g123
        fuse mul-entry, g03, neg, g1
        fuse mul-entry, g12, neg, g023
        fuse mul-entry, g13, neg, g0
        fuse mul-entry, g23, pos, g012
        fuse mul-entry, g012, neg, g23
        fuse mul-entry, g013, neg, one
        fuse mul-entry, g023, pos, g12
        fuse mul-entry, g123, pos, g02
        fuse mul-entry, g0123, pos, g2
    case g023
      fork case, read b
        fuse mul-entry, one, pos, g023
        fuse mul-entry, g0, pos, g23
        fuse mul-entry, g1, pos, g0123
        fuse mul-entry, g2, pos, g03
        fuse mul-entry, g3, neg, g02
        fuse mul-entry, g01, pos, g123
        fuse mul-entry, g02, pos, g3
        fuse mul-entry, g03, neg, g2
        fuse mul-entry, g12, pos, g013
        fuse mul-entry, g13, neg, g012
        fuse mul-entry, g23, neg, g0
        fuse mul-entry, g012, pos, g13
        fuse mul-entry, g013, neg, g12
        fuse mul-entry, g023, neg, one
        fuse mul-entry, g123, neg, g01
        fuse mul-entry, g0123, neg, g1
    case g123
      fork case, read b
        fuse mul-entry, one, pos, g123
        fuse mul-entry, g0, neg, g0123
        fuse mul-entry, g1, neg, g23
        fuse mul-entry, g2, pos, g13
        fuse mul-entry, g3, neg, g12
        fuse mul-entry, g01, pos, g023
        fuse mul-entry, g02, neg, g013
        fuse mul-entry, g03, pos, g012
        fuse mul-entry, g12, neg, g3
        fuse mul-entry, g13, pos, g2
        fuse mul-entry, g23, neg, g1
        fuse mul-entry, g012, pos, g03
        fuse mul-entry, g013, neg, g02
        fuse mul-entry, g023, pos, g01
        fuse mul-entry, g123, pos, one
        fuse mul-entry, g0123, neg, g0
    case g0123
      fork case, read b
        fuse mul-entry, one, pos, g0123
        fuse mul-entry, g0, neg, g123
        fuse mul-entry, g1, neg, g023
        fuse mul-entry, g2, pos, g013
        fuse mul-entry, g3, neg, g012
        fuse mul-entry, g01, pos, g23
        fuse mul-entry, g02, neg, g13
        fuse mul-entry, g03, pos, g12
        fuse mul-entry, g12, neg, g03
        fuse mul-entry, g13, pos, g02
        fuse mul-entry, g23, neg, g01
        fuse mul-entry, g012, pos, g3
        fuse mul-entry, g013, neg, g2
        fuse mul-entry, g023, pos, g1
        fuse mul-entry, g123, pos, g0
        fuse mul-entry, g0123, neg, one

task apply-signs
  take sx, like sign
  take sy, like sign
  take prod, like cliff
  like cliff
  fork case, read prod
    case scaled
      link sp
      link bp
      send back
        make scaled
          bind sign
            call mul-sign
              call mul-sign
                read sx
                read sy
              read sp
          bind blade
            read bp

# THE GEOMETRIC PRODUCT of two Clifford elements: multiply any two, the result is always a Clifford element.
task mul
  take x, like cliff
  take y, like cliff
  like cliff
  fork case, read x
    case scaled
      link sx
      link bx
      fork case, read y
        case scaled
          link sy
          link by
          send back
            call apply-signs
              read sx
              read sy
              call mul-blade
                read bx
                read by

# Negate a signed blade: flip its sign.
task negate
  take x, like cliff
  like cliff
  fork case, read x
    case scaled
      link s
      link b
      send back
        make scaled
          bind sign
            call flip-sign
              read s
          bind blade
            read b

# The four generators as named Clifford elements, each a positive single-generator blade. `make gamma0` and the rest
# build them, and `mul gamma0 gamma1` computes their geometric product.
task gamma0
  like cliff
  send back
    make scaled
      bind sign
        make pos
      bind blade
        make g0

task gamma1
  like cliff
  send back
    make scaled
      bind sign
        make pos
      bind blade
        make g1

task gamma2
  like cliff
  send back
    make scaled
      bind sign
        make pos
      bind blade
        make g2

task gamma3
  like cliff
  send back
    make scaled
      bind sign
        make pos
      bind blade
        make g3

# The chirality element gamma5 = gamma0 gamma1 gamma2 gamma3, the positive pseudoscalar blade.
task gamma5
  like cliff
  send back
    make scaled
      bind sign
        make pos
      bind blade
        make g0123

# TEMPLATE: a single product fact, mul (pos a) (pos b) = (sign) c, as one line.
tree product
  take name
  take a
  take b
  take rs
  take rc

  hook fuse
    rule {name}
      show hold
        call is-equal
          call mul
            make scaled
              bind sign
                make pos
              bind blade
                make {a}
            make scaled
              bind sign
                make pos
              bind blade
                make {b}
          make scaled
            bind sign
              make {rs}
            bind blade
              make {rc}
      calm hold

# THE MINKOWSKI SIGNATURE. The timelike generator gamma0 squares to PLUS ONE, the three spacelike generators gamma1
# gamma2 gamma3 each square to MINUS ONE. These are the diagonal entries 2 eta_{mu mu} of the spacetime metric plus
# minus minus minus, halved, and they are exactly what makes the square of the Dirac operator the Klein-Gordon
# operator. One line each.
fuse product, gamma0-squared-is-plus-one, g0, g0, pos, one
fuse product, gamma1-squared-is-minus-one, g1, g1, neg, one
fuse product, gamma2-squared-is-minus-one, g2, g2, neg, one
fuse product, gamma3-squared-is-minus-one, g3, g3, neg, one

# THE VECTOR PRODUCTS that name the bivectors, gamma0 gamma1 = g01 and the rest of the six oriented planes.
fuse product, gamma0-gamma1-is-the-bivector-g01, g0, g1, pos, g01
fuse product, gamma0-gamma2-is-the-bivector-g02, g0, g2, pos, g02
fuse product, gamma0-gamma3-is-the-bivector-g03, g0, g3, pos, g03
fuse product, gamma1-gamma2-is-the-bivector-g12, g1, g2, pos, g12
fuse product, gamma1-gamma3-is-the-bivector-g13, g1, g3, pos, g13
fuse product, gamma2-gamma3-is-the-bivector-g23, g2, g3, pos, g23

# ANTICOMMUTATION of the distinct generators, the off-diagonal Clifford relation gamma_mu gamma_nu = - gamma_nu
# gamma_mu for mu not equal to nu (the anticommutator vanishes because eta_{mu nu} = 0 off the diagonal). The forward
# product gamma0 gamma1 = pos g01 and the reverse gamma1 gamma0 = neg g01 carry OPPOSITE signs, so the two are
# negatives of each other. Each reverse is a one-line literal product fact, the negative of its forward partner above.
# (The kernel `calm hold` normalizes one computed product against a literal, so anticommutation is witnessed by the
# pair of signed facts rather than by a single `negate`-of-a-product comparison, which would normalize two product
# chains at once and exceeds the tactic's reduction budget. The same faithful form Cl(3,0) uses.)
fuse product, gamma1-gamma0-is-minus-g01, g1, g0, neg, g01
fuse product, gamma2-gamma0-is-minus-g02, g2, g0, neg, g02
fuse product, gamma3-gamma0-is-minus-g03, g3, g0, neg, g03
fuse product, gamma2-gamma1-is-minus-g12, g2, g1, neg, g12
fuse product, gamma3-gamma1-is-minus-g13, g3, g1, neg, g13
fuse product, gamma3-gamma2-is-minus-g23, g3, g2, neg, g23

# THE CHIRALITY ELEMENT gamma5 = gamma0 gamma1 gamma2 gamma3. The first fact confirms the named blade g0123 IS that
# ordered product of the four generators: gamma012 (the product of the first three) times gamma3 gives pos g0123.
fuse product, gamma012-times-gamma3-is-gamma5, g012, g3, pos, g0123

# gamma5 SQUARES TO MINUS ONE, the Dirac pseudoscalar. In the standard chiral convention this is i gamma0 gamma1
# gamma2 gamma3 squaring to plus one; here the bare product of the four real generators squares to minus one, so it
# behaves like the imaginary unit and supplies the complex structure that the chiral projectors ride on.
fuse product, gamma5-squared-is-minus-one, g0123, g0123, neg, one

# gamma5 ANTICOMMUTES WITH EVERY GENERATOR. This is the defining property of chirality: because gamma5 flips sign past
# each gamma_mu, the chiral projectors (one plus or minus gamma5) over two commute with the Dirac kinetic term and
# split a spinor into independent left-handed and right-handed pieces. The forward product gamma_mu gamma5 and the
# reverse gamma5 gamma_mu carry OPPOSITE signs for each of the four generators, witnessed by the pair of signed facts.
fuse product, gamma0-times-gamma5-is-plus-g123, g0, g0123, pos, g123
fuse product, gamma5-times-gamma0-is-minus-g123, g0123, g0, neg, g123
fuse product, gamma1-times-gamma5-is-plus-g023, g1, g0123, pos, g023
fuse product, gamma5-times-gamma1-is-minus-g023, g0123, g1, neg, g023
fuse product, gamma2-times-gamma5-is-minus-g013, g2, g0123, neg, g013
fuse product, gamma5-times-gamma2-is-plus-g013, g0123, g2, pos, g013
fuse product, gamma3-times-gamma5-is-plus-g012, g3, g0123, pos, g012
fuse product, gamma5-times-gamma3-is-minus-g012, g0123, g3, neg, g012

# THE IDENTITY: the scalar one times any Clifford element is itself, over all sixteen signed blades. Proven by
# structural induction with `fold` rather than a single literal.
rule one-is-the-identity
  seat x, like cliff
  show hold
    call is-equal
      call mul
        make scaled
          bind sign
            make pos
          bind blade
            make one
        read x
      read x
  fold x

# NEGATION FLIPS THE SIGN: negating the forward product gamma0 gamma1 = pos g01 gives neg g01, exactly the reverse
# product gamma1 gamma0. This exercises `negate` against a literal and shows the two anticommuting generators give
# products that are negatives of each other, the content of the off-diagonal Clifford relation.
rule negate-gamma0-gamma1-is-the-reverse-product
  show hold
    call is-equal
      call negate
        call mul
          make scaled
            bind sign
              make pos
            bind blade
              make g0
          make scaled
            bind sign
              make pos
            bind blade
              make g1
      make scaled
        bind sign
          make neg
        bind blade
          make g01
  calm hold
