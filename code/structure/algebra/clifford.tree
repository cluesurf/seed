load @term/seed/code/structure/space/vector
  find vector-space

load @term/seed/code/structure/function/binary
  find binary-function

load @term/seed/code/structure/function/unary
  find unary-function

# A Clifford algebra: the universal associative algebra built from a vector space with a quadratic form, in which every
# vector squares to its quadratic-form value, v times v equals Q(v), a scalar. From that one relation everything follows:
# the grading into even and odd parts, the wedge product (the quadratic form set to zero), and the Pin and Spin groups
# as the unit versors. The left-multiplications of the octonions form a Clifford algebra on seven generators, which is
# why the octonions speak the language of spin. The form carries the vector space, the quadratic form, and the product;
# the defining relation v times v equals Q(v) is the law, and the dimension facts are machine-checked in the Clifford
# file under the algebra folder.
form clifford-algebra
  link space, like vector-space
  link quadratic-form, like unary-function
  link product, like binary-function
