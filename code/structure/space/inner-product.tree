load @term/seed/code/structure/space/vector
  find vector-space

load @term/seed/code/structure/function/binary
  find binary-function

# An inner-product space: a vector space with an inner product, a way to multiply two vectors into a scalar that is
# linear in each argument, symmetric, and positive-definite (a vector's product with itself is zero only for the zero
# vector). The inner product gives length and angle, and its square root is the norm. The form carries the vector space
# and the inner product; the bilinearity, symmetry, and positivity are the axioms.
form inner-product-space
  link space, like vector-space
  link inner-product, like binary-function
