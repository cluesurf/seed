load @term/seed/structure/field
  find field

load @term/seed/group/abelian
  find abelian-group

load @term/seed/structure/function/binary
  find binary-function

# A vector space: an abelian group of vectors that can be scaled by the elements of a field, with the scaling
# associative, distributive over both additions, and trivial for the field's identity. It is a module whose scalars form
# a field. Vector spaces are where dimension lives, and the eight-dimensional real vector space carrying the octonions
# is the arena the whole theory plays out in. The form carries the field of scalars, the abelian group of vectors, and
# the scalar action; the linearity laws are the axioms.
form vector-space
  link field, like field
  link vectors, like abelian-group
  link action, like binary-function
