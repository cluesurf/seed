load @term/seed/structure/set
  find set

load @term/seed/structure/function/binary
  find binary-function

# A magma: the barest algebraic structure, a set with one binary operation closed on it and nothing more, no
# associativity, no identity, no inverse. Every richer structure (semigroup, monoid, group) is a magma with laws added.
# The octonions under multiplication are very nearly a bare magma, keeping only alternativity, which is why they sit at
# the wild top of the tower. The form carries the set and the operation; closure is the single law.
form magma
  link set, like set
  link operation, like binary-function
