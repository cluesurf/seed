load @term/seed/structure/set
  find set

load @term/seed/structure/function/binary
  find binary-function

# A monoid: a set with one associative binary operation and a two-sided identity element. It is a group without the
# demand that every element be invertible, the half-step between a bare set with an operation and a full group. The
# natural numbers under addition are a monoid, and so are the strings under concatenation. The axioms (associativity of
# the operation, and an identity the operation leaves every element unchanged against) are the laws an instance must
# satisfy; the form carries the carrier set and the operation.
form monoid
  link set, like set
  link operation, like binary-function
