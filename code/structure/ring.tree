load @term/seed/structure/set
  find set

load @term/seed/structure/function/binary
  find binary-function

load @term/seed/structure/function/unary
  find unary-function

# A ring: a set with two operations, an addition that makes it an abelian group and a multiplication that is
# associative and distributes over the addition. The integers are the first ring, and every number system in the tower
# is a ring (the reals, the complex numbers, the quaternions, dropping commutativity at the fourth rung). The axioms
# (additive associativity and commutativity, an additive identity and inverses, multiplicative associativity, and
# distributivity of multiplication over addition) are the laws an instance satisfies; the form carries the set, the two
# operations, and the additive negation. The machine-checked ring identities over the integers live in the number and
# polynomial files.
form ring
  link set, like set
  link addition, like binary-function
  link multiplication, like binary-function
  link negation, like unary-function
