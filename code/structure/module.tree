load @term/seed/structure/ring
  find ring

load @term/seed/group/abelian
  find abelian-group

load @term/seed/structure/function/binary
  find binary-function

# A module: an abelian group whose elements can be scaled by the elements of a ring, the generalization of a vector
# space from a field of scalars to a ring of scalars. The scalar action is associative and distributes over both the
# ring's addition and the group's addition, and the ring's identity acts trivially. When the ring is a field the module
# is a vector space. The form carries the scalar ring, the abelian group of elements, and the scalar action; the
# distributivity and compatibility laws are the axioms.
form module
  link ring, like ring
  link group, like abelian-group
  link action, like binary-function
