# The order meets the arithmetic: the maximum is the smaller end plus the gap, `max a b = a + (b - a)`. When a <= b the
# truncated difference b - a fills the gap up to b; when a > b the difference is zero and the maximum is a. This bridges
# the lattice (max), addition, and truncated subtraction (monus), proved by simultaneous induction on a and b. It is the
# arithmetic content of "max is the join", and the companion `min a b = a - (a - b)` reads the same way from the meet.

form natural
  case zero
  case succ
    link prior, like natural

task plus
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      send back
        make succ
          bind prior
            call plus
              read prior
              read b

task pred
  take n, like natural
  like natural
  fork case, read n
    case zero
      send back
        make zero
    case succ
      send back
        read prior

task monus
  take a, like natural
  take b, like natural
  like natural
  fork case, read b
    case zero
      send back
        read a
    case succ
      send back
        call pred
          call monus
            read a
            read prior

task max
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      link ap
      fork case, read b
        case zero
          send back
            make succ
              bind prior
                read ap
        case succ
          link bp
          send back
            make succ
              bind prior
                call max
                  read ap
                  read bp

rule monus-succ-right-steps
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call monus
        read a
        make succ
          bind prior
            read b
      call pred
        call monus
          read a
          read b
  calm hold

rule pred-succ-is-prior
  seat n, like natural
  show hold
    call is-equal
      call pred
        make succ
          bind prior
            read n
      read n
  calm hold

rule monus-zero-left
  seat n, like natural
  show hold
    call is-equal
      call monus
        make zero
        read n
      make zero
  fold n
    cite monus-succ-right-steps

rule monus-succ-succ-cancels
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call monus
        make succ
          bind prior
            read a
        make succ
          bind prior
            read b
      call monus
        read a
        read b
  fold b
    cite monus-succ-right-steps
    cite pred-succ-is-prior

rule monus-zero-right
  seat a, like natural
  show hold
    call is-equal
      call monus
        read a
        make zero
      read a
  calm hold

rule plus-succ-left-steps
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call plus
        make succ
          bind prior
            read a
        read b
      make succ
        bind prior
          call plus
            read a
            read b
  calm hold

rule max-succ-both-steps
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call max
        make succ
          bind prior
            read a
        make succ
          bind prior
            read b
      make succ
        bind prior
          call max
            read a
            read b
  calm hold

rule plus-zero-right
  seat n, like natural
  show hold
    call is-equal
      call plus
        read n
        make zero
      read n
  fold n

# max via arithmetic: max a b = a + (b - a). When a <= b the difference fills the gap; when a > b it is zero and max is
# a. Proved by simultaneous induction on a and b.
rule max-is-plus-monus
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call max
        read a
        read b
      call plus
        read a
        call monus
          read b
          read a
  fold a, b
    cite max-succ-both-steps
    cite monus-succ-succ-cancels
    cite monus-zero-left
    cite monus-zero-right
    cite plus-succ-left-steps
    cite plus-zero-right

rule plus-succ-right-steps
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call plus
        read a
        make succ
          bind prior
            read b
      make succ
        bind prior
          call plus
            read a
            read b
  fold a

# The companion form of the bridge: (a - b) + b = max a b. When a >= b the difference plus b rebuilds a; when a < b the
# difference is zero and the sum is b. Together with `max a b = a + (b - a)` this gives both arithmetic readings of the
# join. Proved by simultaneous induction on a and b.
rule monus-plus-is-max
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call plus
        call monus
          read a
          read b
        read b
      call max
        read a
        read b
  fold a, b
    cite monus-succ-succ-cancels
    cite monus-zero-left
    cite monus-zero-right
    cite plus-succ-right-steps
    cite plus-zero-right
    cite max-succ-both-steps
