# The characterizing laws of `max`, proved in the Seed kernel. These are exactly the specification the verification
# engine (deck/test) synthesizes `max` against: that it is the join of the order - idempotent, commutative, with zero
# as the bottom. Proving these laws certifies `max` is THE maximum on ALL naturals, not merely at sample points (the
# strongest form of correctness, an induction theorem). Self-contained per the kernel's one-file constraint.

form natural
  case zero
  case succ
    link prior, like natural

task max
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      link ap
      fork case, read b
        case zero
          send back
            make succ
              bind prior
                read ap
        case succ
          link bp
          send back
            make succ
              bind prior
                call max
                  read ap
                  read bp

# idempotent: max a a = a. The join of a with itself is a.
rule max-idempotent
  seat a, like natural
  show hold
    call is-equal
      call max
        read a
        read a
      read a
  fold a
    cite max-idempotent

# right identity: max a 0 = a. Zero is the bottom of the order.
rule max-zero-right
  seat a, like natural
  show hold
    call is-equal
      call max
        read a
        make zero
      read a
  fold a

# left identity: max 0 a = a (definitional).
rule max-zero-left
  seat a, like natural
  show hold
    call is-equal
      call max
        make zero
        read a
      read a
  calm hold

# commutative: max a b = max b a. The join is independent of argument order.
rule max-commutes
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call max
        read a
        read b
      call max
        read b
        read a
  fold a, b
    cite max-commutes
