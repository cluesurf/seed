# Sets as truth-valued tasks: a set of `a` is a task from `a` to `flag`, yes for the members. The type-theoretic
# reading every proof assistant uses (`a -> Prop`), with the library's `flag` in place of a proposition.
#
# The operations return sets, so they nest. Every law is stated by membership, `has(s, x)`, for every set and every
# element of every type, and holds by the kernel's truth table: `has(s, x)` is yes or no whatever `s` is, so trying
# both for each set decides the law. No law needs a proof step.
#
# Subset is "for every x, x in s implies x in t", which no task computes. It is stated pointwise, as `within(s, t, x)`,
# and its laws hold at every x under hypotheses at that x, which is what each law says of subset itself.
load @term/seed/atom/flag
  find flag
  find both
  find either
  find not-flag
  find implies

form set
  head a
  like task
    take x, like a
    like flag

# MEMBERSHIP: x is in s.
task has
  head a
  take s, like set a
  take x, like a

  like flag

  back s(x)

task empty
  head a

  like set a

  back
    task
      take x, like a
      like flag
      back make no

task full
  head a

  like set a

  back
    task
      take x, like a
      like flag
      back make yes

task union
  head a
  take s, like set a
  take t, like set a

  like set a

  back
    task
      take x, like a
      like flag
      back either(s(x), t(x))

task intersection
  head a
  take s, like set a
  take t, like set a

  like set a

  back
    task
      take x, like a
      like flag
      back both(s(x), t(x))

task complement
  head a
  take s, like set a

  like set a

  back
    task
      take x, like a
      like flag
      back not-flag(s(x))

task difference
  head a
  take s, like set a
  take t, like set a

  like set a

  back
    task
      take x, like a
      like flag
      back both(s(x), not-flag(t(x)))

# The PREIMAGE of s under f: the elements f sends into s.
task preimage
  head a
  head b
  take f
    like task
      take x, like a
      like b
  take s, like set b

  like set a

  back
    task
      take x, like a
      like flag
      back s(f(x))

# SUBSET, at one element: if x is in s, it is in t.
task within
  head a
  take s, like set a
  take t, like set a
  take x, like a

  like flag

  back implies(s(x), t(x))

# NOTHING IS IN THE EMPTY SET, AND EVERYTHING IS IN THE FULL ONE.
rule nothing-is-in-empty
  head a
  mark x, like a
  show hold, is-equal has(empty(), x), make no

rule everything-is-in-full
  head a
  mark x, like a
  show hold, is-equal has(full(), x), make yes

# COMMUTATIVITY.
rule union-commutes
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(union(s, t), x), has(union(t, s), x)

rule intersection-commutes
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, t), x), has(intersection(t, s), x)

# ASSOCIATIVITY.
rule union-associates
  head a
  mark s, like set a
  mark t, like set a
  mark r, like set a
  mark x, like a
  show hold, is-equal has(union(union(s, t), r), x), has(union(s, union(t, r)), x)

rule intersection-associates
  head a
  mark s, like set a
  mark t, like set a
  mark r, like set a
  mark x, like a
  show hold, is-equal has(intersection(intersection(s, t), r), x), has(intersection(s, intersection(t, r)), x)

# IDEMPOTENCE.
rule union-is-idempotent
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(union(s, s), x), has(s, x)

rule intersection-is-idempotent
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, s), x), has(s, x)

# IDENTITIES AND ANNIHILATORS: the empty set and the full set.
rule union-with-empty
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(union(s, empty()), x), has(s, x)

rule intersection-with-full
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, full()), x), has(s, x)

rule union-with-full
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(union(s, full()), x), make yes

rule intersection-with-empty
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, empty()), x), make no

# DISTRIBUTIVITY, both ways.
rule intersection-distributes-over-union
  head a
  mark s, like set a
  mark t, like set a
  mark r, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, union(t, r)), x), has(union(intersection(s, t), intersection(s, r)), x)

rule union-distributes-over-intersection
  head a
  mark s, like set a
  mark t, like set a
  mark r, like set a
  mark x, like a
  show hold, is-equal has(union(s, intersection(t, r)), x), has(intersection(union(s, t), union(s, r)), x)

# ABSORPTION.
rule intersection-absorbs-union
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, union(s, t)), x), has(s, x)

rule union-absorbs-intersection
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(union(s, intersection(s, t)), x), has(s, x)

# COMPLEMENTS: a set and its complement cover everything and share nothing, and the complement of the complement is
# the set.
rule union-with-complement
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(union(s, complement(s)), x), make yes

rule intersection-with-complement
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(intersection(s, complement(s)), x), make no

rule complement-twice
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal has(complement(complement(s)), x), has(s, x)

# DE MORGAN, both ways.
rule complement-of-union
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(complement(union(s, t)), x), has(intersection(complement(s), complement(t)), x)

rule complement-of-intersection
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(complement(intersection(s, t)), x), has(union(complement(s), complement(t)), x)

# DIFFERENCE is intersection with the complement.
rule difference-is-intersection-with-complement
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal has(difference(s, t), x), has(intersection(s, complement(t)), x)

# PREIMAGES commute with every operation.
rule preimage-of-union
  head a
  head b
  mark f
    like task
      take y, like a
      like b
  mark s, like set b
  mark t, like set b
  mark x, like a
  show hold, is-equal has(preimage(f, union(s, t)), x), has(union(preimage(f, s), preimage(f, t)), x)

rule preimage-of-intersection
  head a
  head b
  mark f
    like task
      take y, like a
      like b
  mark s, like set b
  mark t, like set b
  mark x, like a
  show hold, is-equal has(preimage(f, intersection(s, t)), x), has(intersection(preimage(f, s), preimage(f, t)), x)

rule preimage-of-complement
  head a
  head b
  mark f
    like task
      take y, like a
      like b
  mark s, like set b
  mark x, like a
  show hold, is-equal has(preimage(f, complement(s)), x), has(complement(preimage(f, s)), x)

# SUBSET IS A PARTIAL ORDER: reflexive, transitive, and antisymmetric, where subset both ways is equality.
rule within-is-reflexive
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal within(s, s, x), make yes

rule within-is-transitive
  head a
  mark s, like set a
  mark t, like set a
  mark r, like set a
  mark x, like a
  have s-within-t, is-equal within(s, t, x), make yes
  have t-within-r, is-equal within(t, r, x), make yes
  show hold, is-equal within(s, r, x), make yes

rule within-both-ways-is-equal
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  have s-within-t, is-equal within(s, t, x), make yes
  have t-within-s, is-equal within(t, s, x), make yes
  show hold, is-equal has(s, x), has(t, x)

# A union contains each side, an intersection is contained in each, and the empty and full sets are the bottom and top.
rule within-union
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal within(s, union(s, t), x), make yes

rule intersection-within
  head a
  mark s, like set a
  mark t, like set a
  mark x, like a
  show hold, is-equal within(intersection(s, t), s, x), make yes

rule empty-is-within
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal within(empty(), s, x), make yes

rule within-full
  head a
  mark s, like set a
  mark x, like a
  show hold, is-equal within(s, full(), x), make yes
