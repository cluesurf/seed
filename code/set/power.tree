# The power set of a two-element universe {a, b}, modeled as the four subsets and proved to be a Boolean algebra by the
# kernel. The subsets are the empty set, the singleton {a}, the singleton {b}, and the whole set {a, b}. Union and
# intersection are defined by their full tables, complement swaps a subset with its opposite. The kernel proves union and
# intersection are commutative, that complement is an involution, and DE MORGAN's law (the complement of a union is the
# intersection of the complements), by exhaustive induction over the four subsets. This is finite set theory, the lattice
# of subsets ordered by inclusion, the same Boolean structure the propositional connectives carry.

# The four subsets of {a, b}.
form subset
  case empty
  case only-a
  case only-b
  case whole

# TEMPLATE: one entry of a subset operation, the second operand `from` sent to the result `to`. Replaces every
# `case .. / send back / make ..` block in the union and intersection tables with one line per entry.
tree map-subset
  take from
  take to

  hook fuse
    case {from}
      send back
        make {to}

# Union of two subsets: the elements in either.
task union
  take p, like subset
  take q, like subset
  like subset
  fork case, read p
    case empty
      send back
        read q
    case only-a
      fork case, read q
        fuse map-subset, empty, only-a
        fuse map-subset, only-a, only-a
        fuse map-subset, only-b, whole
        fuse map-subset, whole, whole
    case only-b
      fork case, read q
        fuse map-subset, empty, only-b
        fuse map-subset, only-a, whole
        fuse map-subset, only-b, only-b
        fuse map-subset, whole, whole
    case whole
      send back
        make whole

# Intersection of two subsets: the elements in both.
task intersect
  take p, like subset
  take q, like subset
  like subset
  fork case, read p
    case empty
      send back
        make empty
    case only-a
      fork case, read q
        fuse map-subset, empty, empty
        fuse map-subset, only-a, only-a
        fuse map-subset, only-b, empty
        fuse map-subset, whole, only-a
    case only-b
      fork case, read q
        fuse map-subset, empty, empty
        fuse map-subset, only-a, empty
        fuse map-subset, only-b, only-b
        fuse map-subset, whole, only-b
    case whole
      send back
        read q

# Complement: the elements NOT in the subset. Empty and whole swap, the two singletons swap.
task complement
  take p, like subset
  like subset
  fork case, read p
    fuse map-subset, empty, whole
    fuse map-subset, only-a, only-b
    fuse map-subset, only-b, only-a
    fuse map-subset, whole, empty

# UNION IS COMMUTATIVE: union p q = union q p, over all sixteen pairs.
rule union-is-commutative
  seat p, like subset
  seat q, like subset
  show hold
    call is-equal
      call union
        read p
        read q
      call union
        read q
        read p
  fold p, q

# INTERSECTION IS COMMUTATIVE: intersect p q = intersect q p.
rule intersect-is-commutative
  seat p, like subset
  seat q, like subset
  show hold
    call is-equal
      call intersect
        read p
        read q
      call intersect
        read q
        read p
  fold p, q

# COMPLEMENT IS AN INVOLUTION: complement (complement p) = p. The complement of the complement is the original set.
rule complement-is-an-involution
  seat p, like subset
  show hold
    call is-equal
      call complement
        call complement
          read p
      read p
  fold p

# DE MORGAN: the complement of a union is the intersection of the complements, complement (union p q) = intersect
# (complement p) (complement q), over all sixteen pairs. The duality at the heart of Boolean algebra and set theory.
rule de-morgan-union
  seat p, like subset
  seat q, like subset
  show hold
    call is-equal
      call complement
        call union
          read p
          read q
      call intersect
        call complement
          read p
        call complement
          read q
  fold p, q
