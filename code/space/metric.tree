load @term/seed/code/structure/set
  find set

load @term/seed/code/structure/function/binary
  find binary-function

# A metric space: a set with a distance function assigning a non-negative number to each pair of points, zero only when
# the points coincide, symmetric, and obeying the triangle inequality (a detour is never shorter than the direct path).
# The distance turns the set into a shape with a notion of nearness, refining the topological space with actual lengths.
# The discrete metric of the substrate (one step per edge of the mesh) is the metric the geometry measures. The form
# carries the set and the distance; the three distance axioms are the laws.
form metric-space
  link set, like set
  link distance, like binary-function
