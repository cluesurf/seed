# Discrete holography, the bulk-boundary correspondence of anti-de-Sitter space, modeled by the kernel. The bulk of AdS
# is a hyperbolic space, and its discrete skeleton is a tree: from a center, two choices branch outward forever toward
# the boundary at infinity. A bulk point is a finite path from the center, and its DEPTH is the radial coordinate, the
# renormalization scale (shallow is infrared near the center, deep is ultraviolet near the boundary). The boundary region
# a bulk point governs is the set of ends below it, and one bulk point GOVERNS another (its entanglement wedge contains
# the other) exactly when its path is a prefix. This file proves the holographic essentials: the center reconstructs the
# whole boundary, the wedge relation is reflexive and nests, and a deep point cannot reconstruct the center (no ultraviolet
# point sees the full infrared). This is the discrete core of subregion duality and the Ryu-Takayanagi entanglement wedge.

load @term/seed/atom/flag
  find flag

# A branching direction at each bulk vertex, the two ways the boundary splits.
form way
  case left
  case right

# A bulk point: a finite path from the center toward the boundary. The center is the deepest interior point, each turn
# steps once toward the boundary. The path read center-to-boundary is the point's address.
form spot
  case core
  case turn
    link step, like way
    link rest, like spot

# The radial depth of a bulk point, its renormalization scale: the center is depth zero, each step toward the boundary is
# one deeper. Deep is ultraviolet (near the boundary), shallow is infrared (near the center).
form size
  case none
  case more
    link prior, like size

task depth
  take s, like spot
  like size
  fork case, read s
    case core
      send back
        make none
    case turn
      link step
      link rest
      send back
        make more
          bind prior
            call depth
              read rest

# The entanglement wedge containment: does bulk point a GOVERN bulk point b, that is, is a's path a prefix of b's path.
# The center governs everything. A turn governs another turn when their first steps agree and the rest is governed. A
# turn never governs the center, since a point nearer the boundary cannot contain the center's whole view.
task within
  take a, like spot
  take b, like spot
  like flag
  fork case, read a
    case core
      send back
        make yes
    case turn
      link step-a
      link rest-a
      fork case, read b
        case core
          send back
            make no
        case turn
          link step-b
          link rest-b
          fork case, read step-a
            case left
              fork case, read step-b
                case left
                  send back
                    call within
                      read rest-a
                      read rest-b
                case right
                  send back
                    make no
            case right
              fork case, read step-b
                case left
                  send back
                    make no
                case right
                  send back
                    call within
                      read rest-a
                      read rest-b

# THE CENTER RECONSTRUCTS THE WHOLE BOUNDARY: within core b = yes, for every bulk point b. The center of anti-de-Sitter
# governs the entire boundary, its entanglement wedge is everything. This is the deepest infrared point seeing all of the
# ultraviolet.
rule center-governs-the-whole-boundary
  seat b, like spot
  show hold
    call is-equal
      call within
        make core
        read b
      make yes
  calm hold

# THE WEDGE IS REFLEXIVE: within a a = yes, for every bulk point. A region governs itself, its entanglement wedge contains
# its own bulk point. Proved by induction over the path.
rule wedge-is-reflexive
  seat a, like spot
  show hold
    call is-equal
      call within
        read a
        read a
      make yes
  fold a

# A DEEP POINT CANNOT RECONSTRUCT THE CENTER: within (turn s r) core = no. A bulk point nearer the boundary does not
# govern the center, the ultraviolet cannot see the full infrared. This is the one-way nature of the radial direction.
rule boundary-point-does-not-govern-the-center
  seat s, like way
  seat r, like spot
  show hold
    call is-equal
      call within
        make turn
          bind step
            read s
          bind rest
            read r
        make core
      make no
  calm hold

# STEPPING TOWARD THE BOUNDARY DEEPENS THE SCALE: depth (turn s r) = more (depth r), one quantum deeper in the radial
# renormalization direction for each step out. The bulk grows one scale at a time toward the boundary.
rule a-step-out-deepens-the-scale
  seat s, like way
  seat r, like spot
  show hold
    call is-equal
      call depth
        make turn
          bind step
            read s
          bind rest
            read r
      make more
        bind prior
          call depth
            read r
  calm hold
