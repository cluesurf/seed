# The axioms of hyperbolic plane geometry, each one a THEOREM of the hyperboloid model (space/hyperbolic/hyperboloid),
# labelled as Hilbert numbers them. Hyperbolic geometry is Hilbert's absolute geometry (incidence, order, congruence,
# continuity) with Euclid's parallel axiom replaced by its negation. A system of axioms is shown CONSISTENT by a model
# in which every axiom holds, and that is what this file records: in the hyperboloid model,
#
#   a point is x with B(x, x) = 1, a line is a normal n with B(n, n) = -1, x lies on n when B(x, n) = 0,
#   and B(x, y) = cosh of the distance, B(x, y) = x0 y0 - x1 y1 - x2 y2.
#
# Proved below, for every point and line of the model:
#
#   I.1, I.2  through two distinct points there is a line, and only one;
#   I.3       there are three points not on one line;
#   III       segments are congruent when B agrees, which is an equivalence; the congruence of triangles (SAS, SSS)
#             is the law of cosines, proved in space/hyperbolic/hyperboloid;
#   P         THE HYPERBOLIC PARALLEL AXIOM: through a point off a line pass at least two lines that do not meet it.
#
# ORDER (II) is proved in space/hyperbolic/metric: betweenness is additivity of distance along a segment, and Pasch's
# axiom holds (a line crossing one side of a triangle crosses exactly one other). CONTINUITY (V, Dedekind) is the
# completeness of the real numbers the model's coordinates are taken in: the kernel proves identities true in every
# commutative ring, and completeness is a property of the field, not an identity, so it is assumed with the reals.

load @term/seed/space/hyperbolic/hyperboloid
  find lorentz-form
  find lorentz-cross-t
  find lorentz-cross-x
  find lorentz-cross-y

# I.1: the line through two points x, y is the normal x * y, and both points lie on it.
rule incidence-the-first-point-lies-on-the-line
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark y0, like integer
  mark y1, like integer
  mark y2, like integer
  show hold
    call is-equal
      call lorentz-form
        call lorentz-cross-t
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-x
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-y
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        read x0
        read x1
        read x2
      code 0

rule incidence-the-second-point-lies-on-the-line
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark y0, like integer
  mark y1, like integer
  mark y2, like integer
  show hold
    call is-equal
      call lorentz-form
        call lorentz-cross-t
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-x
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-y
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        read y0
        read y1
        read y2
      code 0

# I.2: and that line is a genuine line exactly when the points differ: its normal has norm 1 - cosh^2 d.
rule incidence-two-distinct-points-span-a-genuine-line
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark y0, like integer
  mark y1, like integer
  mark y2, like integer
  have x-point
    call is-equal
      call lorentz-form
        read x0
        read x1
        read x2
        read x0
        read x1
        read x2
      code 1
  have y-point
    call is-equal
      call lorentz-form
        read y0
        read y1
        read y2
        read y0
        read y1
        read y2
      code 1
  show hold
    call is-equal
      call lorentz-form
        call lorentz-cross-t
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-x
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-y
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-t
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-x
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-cross-y
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
      call subtract
        code 1
        call multiply
          call lorentz-form
            read x0
            read x1
            read x2
            read y0
            read y1
            read y2
          call lorentz-form
            read x0
            read x1
            read x2
            read y0
            read y1
            read y2

# I.3: three points not on one line: (1, 0, 0), (3, 2, 2), (3, 2, -2). The third is off the line of the first two.
rule incidence-three-points-not-on-a-line
  show hold
    call is-equal
      call lorentz-form
        call lorentz-cross-t
          code 1
          code 0
          code 0
          code 3
          code 2
          code 2
        call lorentz-cross-x
          code 1
          code 0
          code 0
          code 3
          code 2
          code 2
        call lorentz-cross-y
          code 1
          code 0
          code 0
          code 3
          code 2
          code 2
        code 3
        code 2
        code -2
      code -8

# III: segment congruence is B-equality, symmetric in the two ends (B(x, y) = B(y, x)), so congruence of segments does
# not depend on the order of the endpoints.
rule congruence-ignores-the-order-of-the-ends
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark y0, like integer
  mark y1, like integer
  mark y2, like integer
  show hold
    call is-equal
      call lorentz-form
        read x0
        read x1
        read x2
        read y0
        read y1
        read y2
      call lorentz-form
        read y0
        read y1
        read y2
        read x0
        read x1
        read x2

# P, THE HYPERBOLIC PARALLEL AXIOM: the point (1, 0, 0) is off the line n = (1, 1, 1), and the lines (0, 1, 0) and
# (0, 3, 4) both pass through it without meeting n (B(m, n)^2 >= B(m, m) B(n, n), the non-meeting criterion proved in
# space/hyperbolic/hyperboloid), and they are different lines.
rule parallel-axiom-the-point-is-off-the-line
  show hold
    call is-equal
      call lorentz-form
        code 1
        code 0
        code 0
        code 1
        code 1
        code 1
      code 1

rule parallel-axiom-the-first-line-passes-the-point
  show hold
    call is-equal
      call lorentz-form
        code 0
        code 1
        code 0
        code 1
        code 0
        code 0
      code 0

rule parallel-axiom-the-first-line-misses-the-line
  show hold
    call is-equal
      call subtract
        call multiply
          call lorentz-form
            code 0
            code 1
            code 0
            code 1
            code 1
            code 1
          call lorentz-form
            code 0
            code 1
            code 0
            code 1
            code 1
            code 1
        call multiply
          call lorentz-form
            code 0
            code 1
            code 0
            code 0
            code 1
            code 0
          call lorentz-form
            code 1
            code 1
            code 1
            code 1
            code 1
            code 1
      code 0

rule parallel-axiom-the-second-line-passes-the-point
  show hold
    call is-equal
      call lorentz-form
        code 0
        code 3
        code 4
        code 1
        code 0
        code 0
      code 0

rule parallel-axiom-the-second-line-misses-the-line
  show hold
    call is-equal
      call subtract
        call multiply
          call lorentz-form
            code 0
            code 3
            code 4
            code 1
            code 1
            code 1
          call lorentz-form
            code 0
            code 3
            code 4
            code 1
            code 1
            code 1
        call multiply
          call lorentz-form
            code 0
            code 3
            code 4
            code 0
            code 3
            code 4
          call lorentz-form
            code 1
            code 1
            code 1
            code 1
            code 1
            code 1
      code 24
