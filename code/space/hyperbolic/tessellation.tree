# Regular tessellations and the Schlafli classification, machine-checked by the kernel. A regular tiling is named by its
# SCHLAFLI SYMBOL {p, q}: regular p-sided polygons, q of them meeting at each vertex. {4, 4} is the square grid (four
# squares at a corner), {5, 4} the pentagrid, {7, 3} the ternary heptagrid. One arithmetic test decides which geometry a
# symbol lives in, by comparing the DEFECT (p - 2)(q - 2) to 4:
#
#   (p - 2)(q - 2) < 4  -> SPHERICAL, a finite tiling of the sphere. The five Platonic solids exhaust the cases:
#                          {3,3} {3,4} {4,3} {3,5} {5,3}.
#   (p - 2)(q - 2) = 4  -> EUCLIDEAN, a flat tiling of the ordinary plane. Exactly three solutions:
#                          {3,6} triangles, {4,4} squares, {6,3} hexagons.
#   (p - 2)(q - 2) > 4  -> HYPERBOLIC, a tiling of the Lobachevsky plane. INFINITELY many: {5,4}, {7,3}, {5,5}, {4,6},
#                          and endlessly more. The flat plane offers only three regular tilings, the hyperbolic plane an
#                          unbounded family, which is the whole reason Margenstern's machines run there.
#
# The defect is SYMMETRIC in p and q, since (p - 2)(q - 2) = (q - 2)(p - 2). So a symbol and its dual {q, p} always share
# a geometry. That DUALITY is proved below as a universal theorem over an enumeration of named tilings, not merely as a
# table of instances: classify {p, q} = classify {q, p} for every tiling.
#
# Two layers are checked. First, the arithmetic layer: each concrete defect is computed with the kernel's built-in
# integer arithmetic (multiply, subtract) and compared to 4, so the classification of every named tiling is verified from
# its raw side counts. Second, the structural layer: a `classify` lookup over an enum of tilings, with `flip` swapping a
# symbol for its dual, and `fold` proving duality and the flip-involution for every member at once.

load @term/seed/atom/flag
  find flag

# The three geometries a regular tiling can inhabit, by the sign of (p - 2)(q - 2) - 4.
form kind
  case spherical
  case euclidean
  case hyperbolic

# The named regular tilings this file classifies. Each chiral symbol {p, q} with p not equal to q appears in BOTH
# orientations (its dual is a separate case) so the duality theorem can quantify over the whole enum and land each tiling
# on its dual under `flip`. The self-dual symbols {p, p} ({3,3}, {4,4}, {5,5}) are their own flip.
form tiling
  # spherical, the Platonic solids
  case tetrahedron      # {3, 3}
  case octahedron       # {3, 4}
  case cube             # {4, 3}
  case icosahedron      # {3, 5}
  case dodecahedron     # {5, 3}
  # euclidean, the three flat tilings
  case triangle-grid    # {3, 6}
  case square-grid      # {4, 4}
  case hexagon-grid     # {6, 3}
  # hyperbolic, an infinite family (a finite sample)
  case pentagrid        # {5, 4}
  case order-five-square # {4, 5}, the dual of the pentagrid
  case heptagrid        # {7, 3}
  case order-seven-triangle # {3, 7}, the dual of the heptagrid
  case order-five-pentagon  # {5, 5}, self-dual
  case order-six-square     # {6, 4}
  case order-four-hexagon   # {4, 6}, the dual of {6, 4}

# THE ARITHMETIC LAYER. Each tiling's geometry, derived straight from its side counts by computing the defect
# (p - 2)(q - 2) with the kernel's integer arithmetic and comparing it to 4. These are the ground truth the structural
# `classify` lookup must agree with.

# SPHERICAL. The five Platonic solids, each with (p - 2)(q - 2) strictly below 4.

# {3, 3} the tetrahedron: (3 - 2)(3 - 2) = 1, below 4. The most basic Platonic solid.
hold tetrahedron-is-spherical
  call is-below
    call multiply
      call subtract
        code 3
        code 2
      call subtract
        code 3
        code 2
    code 4

# {3, 4} the octahedron and {4, 3} the cube are dual: both have defect (3 - 2)(4 - 2) = (4 - 2)(3 - 2) = 2, below 4.
hold octahedron-is-spherical
  call is-below
    call multiply
      call subtract
        code 3
        code 2
      call subtract
        code 4
        code 2
    code 4

hold cube-is-spherical
  call is-below
    call multiply
      call subtract
        code 4
        code 2
      call subtract
        code 3
        code 2
    code 4

# {3, 5} the icosahedron and {5, 3} the dodecahedron are dual: both have defect 1 * 3 = 3 * 1 = 3, below 4.
hold icosahedron-is-spherical
  call is-below
    call multiply
      call subtract
        code 3
        code 2
      call subtract
        code 5
        code 2
    code 4

hold dodecahedron-is-spherical
  call is-below
    call multiply
      call subtract
        code 5
        code 2
      call subtract
        code 3
        code 2
    code 4

# EUCLIDEAN. The three flat tilings, each with defect exactly 4. These are the COMPLETE solution set of (p - 2)(q - 2) = 4
# over the naturals (3 <= p, q): 1*4, 2*2, 4*1.

# {3, 6} triangles: (3 - 2)(6 - 2) = 1 * 4 = 4. Flat.
hold triangle-grid-is-euclidean
  call is-equal
    call multiply
      call subtract
        code 3
        code 2
      call subtract
        code 6
        code 2
    code 4

# {4, 4} squares, the self-dual square grid: (4 - 2)(4 - 2) = 2 * 2 = 4. Flat.
hold square-grid-is-euclidean
  call is-equal
    call multiply
      call subtract
        code 4
        code 2
      call subtract
        code 4
        code 2
    code 4

# {6, 3} hexagons, the dual of the triangle grid: (6 - 2)(3 - 2) = 4 * 1 = 4. Flat.
hold hexagon-grid-is-euclidean
  call is-equal
    call multiply
      call subtract
        code 6
        code 2
      call subtract
        code 3
        code 2
    code 4

# HYPERBOLIC. A finite sample of the infinite family, each with defect strictly above 4.

# {5, 4} the pentagrid (four right-angled pentagons at a vertex): (5 - 2)(4 - 2) = 3 * 2 = 6, above 4. The canonical
# hyperbolic tiling, the "hello world" of Margenstern's book.
hold pentagrid-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 5
        code 2
      call subtract
        code 4
        code 2
    code 4

# {4, 5} the order-five square tiling, dual of the pentagrid: (4 - 2)(5 - 2) = 2 * 3 = 6, above 4.
hold order-five-square-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 4
        code 2
      call subtract
        code 5
        code 2
    code 4

# {7, 3} the ternary heptagrid (three heptagons at a vertex): (7 - 2)(3 - 2) = 5 * 1 = 5, above 4 by one. The stage for
# the undecidability proof.
hold heptagrid-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 7
        code 2
      call subtract
        code 3
        code 2
    code 4

# {3, 7} the order-seven triangle tiling, dual of the heptagrid: (3 - 2)(7 - 2) = 1 * 5 = 5, above 4.
hold order-seven-triangle-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 3
        code 2
      call subtract
        code 7
        code 2
    code 4

# {5, 5} the order-five pentagon tiling, self-dual: (5 - 2)(5 - 2) = 3 * 3 = 9, above 4.
hold order-five-pentagon-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 5
        code 2
      call subtract
        code 5
        code 2
    code 4

# {6, 4} four hexagons at a vertex: (6 - 2)(4 - 2) = 4 * 2 = 8, above 4.
hold order-six-square-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 6
        code 2
      call subtract
        code 4
        code 2
    code 4

# {4, 6} the order-four hexagon tiling, dual of {6, 4}: (4 - 2)(6 - 2) = 2 * 4 = 8, above 4.
hold order-four-hexagon-is-hyperbolic
  call is-above
    call multiply
      call subtract
        code 4
        code 2
      call subtract
        code 6
        code 2
    code 4

# THE BOUNDARY IS SHARP. {6, 3} sits exactly at the flat threshold (defect 4) while its hyperbolic neighbour {6, 4} is
# strictly past it (defect 8 > 4). One step in q crosses from flat to hyperbolic, with nothing between: the defect jumps
# from 4 to 8 with no integer symbol in the gap. This is why the Euclidean tilings are a finite, isolated set and the
# hyperbolic ones an open-ended family.
hold flat-to-hyperbolic-is-a-clean-jump
  call is-equal
    call multiply
      call subtract
        code 6
        code 2
      call subtract
        code 3
        code 2
    code 4
  link is-above
    call multiply
      call subtract
        code 6
        code 2
      call subtract
        code 4
        code 2
    code 4

# THE STRUCTURAL LAYER. A lookup `classify` from each named tiling to its geometry, agreeing with the arithmetic layer
# above, and `flip` sending each symbol to its dual {q, p}. With these, `fold` proves the duality theorem and the
# flip-involution as universal statements over every tiling at once.

# TEMPLATE: one row of a single-valued table out of a tiling, `from` sent to the construction `to`. One definition serves
# both the classification lookup and the flip (dual) permutation, so each table reads cleanly as its rows.
tree map-tiling
  take from
  take to

  hook fuse
    case {from}
      send back
        make {to}

# The geometry of each named tiling. This lookup MUST match the arithmetic holds above (and does): every spherical case
# maps to `spherical`, every flat case to `euclidean`, every hyperbolic case to `hyperbolic`.
task classify
  take t, like tiling
  like kind
  fork case, read t
    fuse map-tiling, tetrahedron, spherical
    fuse map-tiling, octahedron, spherical
    fuse map-tiling, cube, spherical
    fuse map-tiling, icosahedron, spherical
    fuse map-tiling, dodecahedron, spherical
    fuse map-tiling, triangle-grid, euclidean
    fuse map-tiling, square-grid, euclidean
    fuse map-tiling, hexagon-grid, euclidean
    fuse map-tiling, pentagrid, hyperbolic
    fuse map-tiling, order-five-square, hyperbolic
    fuse map-tiling, heptagrid, hyperbolic
    fuse map-tiling, order-seven-triangle, hyperbolic
    fuse map-tiling, order-five-pentagon, hyperbolic
    fuse map-tiling, order-six-square, hyperbolic
    fuse map-tiling, order-four-hexagon, hyperbolic

# The dual: send {p, q} to {q, p}. Each chiral symbol swaps with its dual; each self-dual symbol ({3,3}, {4,4}, {5,5}) is
# fixed. This is the geometric duality of regular tilings, the polygon-vertex exchange.
task flip
  take t, like tiling
  like tiling
  fork case, read t
    fuse map-tiling, tetrahedron, tetrahedron
    fuse map-tiling, octahedron, cube
    fuse map-tiling, cube, octahedron
    fuse map-tiling, icosahedron, dodecahedron
    fuse map-tiling, dodecahedron, icosahedron
    fuse map-tiling, triangle-grid, hexagon-grid
    fuse map-tiling, square-grid, square-grid
    fuse map-tiling, hexagon-grid, triangle-grid
    fuse map-tiling, pentagrid, order-five-square
    fuse map-tiling, order-five-square, pentagrid
    fuse map-tiling, heptagrid, order-seven-triangle
    fuse map-tiling, order-seven-triangle, heptagrid
    fuse map-tiling, order-five-pentagon, order-five-pentagon
    fuse map-tiling, order-six-square, order-four-hexagon
    fuse map-tiling, order-four-hexagon, order-six-square

# DUALITY IS AN INVOLUTION: flip (flip t) = t, for every tiling. The dual of the dual is the original symbol, since
# swapping p and q twice restores them. Proved over all fifteen tilings by the kernel.
rule flip-is-an-involution
  seat t, like tiling
  show hold
    call is-equal
      call flip
        call flip
          read t
      read t
  fold t

# THE DUALITY THEOREM: a tiling and its dual share a geometry, classify t = classify (flip t), for EVERY tiling. This is
# the structural face of the symmetry (p - 2)(q - 2) = (q - 2)(p - 2): the defect does not change when p and q swap, so
# {p, q} and {q, p} land in the same kind. Proved as a universal statement by induction over the enum, not as a table of
# checked instances.
rule classification-is-self-dual
  seat t, like tiling
  show hold
    call is-equal
      call classify
        read t
      call classify
        call flip
          read t
  fold t

# CONCRETE DUAL PAIRS, read off the universal theorem. The pentagrid {5, 4} and its dual {4, 5} are both hyperbolic.
rule pentagrid-and-its-dual-agree
  show hold
    call is-equal
      call classify
        make pentagrid
      call classify
        make order-five-square
  calm hold

# The cube {4, 3} and the octahedron {3, 4} are both spherical, a dual Platonic pair.
rule cube-and-octahedron-agree
  show hold
    call is-equal
      call classify
        make cube
      call classify
        make octahedron
  calm hold

# The triangle grid {3, 6} and the hexagon grid {6, 3} are both Euclidean, the dual flat pair.
rule triangle-and-hexagon-grids-agree
  show hold
    call is-equal
      call classify
        make triangle-grid
      call classify
        make hexagon-grid
  calm hold

# A DISTINCTNESS CHECK: the three geometries are genuinely different. The square grid is Euclidean while the pentagrid is
# hyperbolic, so `classify` does not collapse the flat and curved cases. (If the two were equal, the kernel would reject
# this `miss` refutation.) This confirms the classification carries information, not a constant.
rule euclidean-and-hyperbolic-are-distinct
  show miss
    call is-equal
      call classify
        make square-grid
      call classify
        make pentagrid
  calm miss
