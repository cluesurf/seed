# THE LAW OF COSINES. At a vertex v of the triangle (a, b, v), the tangent directions toward a and b are
# u = a - B(a, v) v and w = b - B(b, v) v. Then B(u, w) = B(a, b) - B(a, v) B(b, v), and B(u, u) = 1 - B(a, v)^2 =
# -sinh^2 of the side, so with cos C = -B(u, w) / (sinh a sinh b) this is cosh c = cosh a cosh b - sinh a sinh b cos C.
#
# CONGRUENCE, Hilbert's group III, follows from this identity. Segments are congruent when B (cosh of the length)
# agrees. SIDE-ANGLE-SIDE (axiom III.5): the third side B(a, b) is B(u, w) + B(a, v) B(b, v), a function of the two
# sides at v and the angle between them, so triangles agreeing in those agree in the third side. SIDE-SIDE-SIDE: the
# angle B(u, w) = B(a, b) - B(a, v) B(b, v) is a function of the three sides. (Stated for two triangles at once, the
# kernel's ideal reduction does not find the chain through these degree-six hypotheses, so the theorem is the
# identity, from which both follow by substitution.)
rule the-law-of-cosines
  seat a0, like integer
  seat a1, like integer
  seat a2, like integer
  seat b0, like integer
  seat b1, like integer
  seat b2, like integer
  seat v0, like integer
  seat v1, like integer
  seat v2, like integer
  have vertex
    call is-equal
      call lorentz-form
        read v0
        read v1
        read v2
        read v0
        read v1
        read v2
      code 1
  show hold
    call is-equal
      call lorentz-form
        call subtract
          read a0
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read a1
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read a2
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v2
        call subtract
          read b0
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read b1
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read b2
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read v0
              read v1
              read v2
            read v2
      call subtract
        call lorentz-form
          read a0
          read a1
          read a2
          read b0
          read b1
          read b2
        call multiply
          call lorentz-form
            read a0
            read a1
            read a2
            read v0
            read v1
            read v2
          call lorentz-form
            read b0
            read b1
            read b2
            read v0
            read v1
            read v2

rule a-tangent-direction-has-norm-minus-sinh-squared
  seat a0, like integer
  seat a1, like integer
  seat a2, like integer
  seat v0, like integer
  seat v1, like integer
  seat v2, like integer
  have vertex
    call is-equal
      call lorentz-form
        read v0
        read v1
        read v2
        read v0
        read v1
        read v2
      code 1
  have point
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read a0
        read a1
        read a2
      code 1
  show hold
    call is-equal
      call lorentz-form
        call subtract
          read a0
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read a1
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read a2
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v2
        call subtract
          read a0
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read a1
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read a2
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v2
      call subtract
        code 1
        call multiply
          call lorentz-form
            read a0
            read a1
            read a2
            read v0
            read v1
            read v2
          call lorentz-form
            read a0
            read a1
            read a2
            read v0
            read v1
            read v2

# HOMOGENEITY: any point maps to any other by an isometry. The reflection in the line with normal n = x - o (the
# perpendicular bisector) sends o to x: B(n, n) R(o) = B(n, n) o - 2 B(o, n) n = B(n, n) x, written without the
# division so that it holds for every pair of points (n is spacelike whenever x is not o).
rule any-point-reflects-onto-any-other-t
  seat x0, like integer
  seat x1, like integer
  seat x2, like integer
  seat o0, like integer
  seat o1, like integer
  seat o2, like integer
  have x-point
    call is-equal
      call lorentz-form
        read x0
        read x1
        read x2
        read x0
        read x1
        read x2
      code 1
  have o-point
    call is-equal
      call lorentz-form
        read o0
        read o1
        read o2
        read o0
        read o1
        read o2
      code 1
  show hold
    call is-equal
      call subtract
        call multiply
          call lorentz-form
            call subtract
              read x0
              read o0
            call subtract
              read x1
              read o1
            call subtract
              read x2
              read o2
            call subtract
              read x0
              read o0
            call subtract
              read x1
              read o1
            call subtract
              read x2
              read o2
          read o0
        call multiply
          call multiply
            code 2
            call lorentz-form
              read o0
              read o1
              read o2
              call subtract
                read x0
                read o0
              call subtract
                read x1
                read o1
              call subtract
                read x2
                read o2
          call subtract
            read x0
            read o0
      call multiply
        call lorentz-form
          call subtract
            read x0
            read o0
          call subtract
            read x1
            read o1
          call subtract
            read x2
            read o2
          call subtract
            read x0
            read o0
          call subtract
            read x1
            read o1
          call subtract
            read x2
            read o2
        read x0

rule any-point-reflects-onto-any-other-x
  seat x0, like integer
  seat x1, like integer
  seat x2, like integer
  seat o0, like integer
