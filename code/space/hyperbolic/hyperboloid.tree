# CIRCLES, HOROCYCLES AND EQUIDISTANTS: the points at constant B(x, g) = k from a fixed vector g are a circle when g is
# a point, a horocycle when g is on the light cone (a point at infinity), and an equidistant of a line when g is
# spacelike. In the disk every one of them is a Euclidean circle: B(X, g) - k s = (g0 + k)|p|^2 - 2 (g1 p1 + g2 p2)
# + (g0 - k), a quadratic with equal coefficients on p1^2 and p2^2.
rule every-curve-of-constant-distance-is-a-circle-in-the-disk
  seat p1, like integer
  seat p2, like integer
  seat g0, like integer
  seat g1, like integer
  seat g2, like integer
  seat k, like integer
  show hold
    call is-equal
      call subtract
        call lorentz-form
          call add
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call multiply
            code 2
            read p1
          call multiply
            code 2
            read p2
          read g0
          read g1
          read g2
        call multiply
          read k
          call subtract
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
      call add
        call add
          call multiply
            call add
              read g0
              read k
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call subtract
            code 0
            call multiply
              code 2
              call add
                call multiply
                  read g1
                  read p1
                call multiply
                  read g2
                  read p2
        call subtract
          read g0
          read k

