# THE LAW OF COSINES. At a vertex v of the triangle (a, b, v), the tangent directions toward a and b are
# u = a - B(a, v) v and w = b - B(b, v) v. Then B(u, w) = B(a, b) - B(a, v) B(b, v), and B(u, u) = 1 - B(a, v)^2 =
# -sinh^2 of the side, so with cos C = -B(u, w) / (sinh a sinh b) this is cosh c = cosh a cosh b - sinh a sinh b cos C.
rule the-law-of-cosines
  mark a0, like integer
  mark a1, like integer
  mark a2, like integer
  mark b0, like integer
  mark b1, like integer
  mark b2, like integer
  mark v0, like integer
  mark v1, like integer
  mark v2, like integer
  have vertex
    call is-equal
      call lorentz-form
        read v0
        read v1
        read v2
        read v0
        read v1
        read v2
      code 1
  show hold
    call is-equal
      call lorentz-form
        call subtract
          read a0
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read a1
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read a2
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v2
        call subtract
          read b0
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read b1
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read b2
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read v0
              read v1
              read v2
            read v2
      call subtract
        call lorentz-form
          read a0
          read a1
          read a2
          read b0
          read b1
          read b2
        call multiply
          call lorentz-form
            read a0
            read a1
            read a2
            read v0
            read v1
            read v2
          call lorentz-form
            read b0
            read b1
            read b2
            read v0
            read v1
            read v2

rule a-tangent-direction-has-norm-minus-sinh-squared
  mark a0, like integer
  mark a1, like integer
  mark a2, like integer
  mark v0, like integer
  mark v1, like integer
  mark v2, like integer
  have vertex
    call is-equal
      call lorentz-form
        read v0
        read v1
        read v2
        read v0
        read v1
        read v2
      code 1
  have point
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read a0
        read a1
        read a2
      code 1
  show hold
    call is-equal
      call lorentz-form
        call subtract
          read a0
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read a1
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read a2
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v2
        call subtract
          read a0
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v0
        call subtract
          read a1
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v1
        call subtract
          read a2
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read v0
              read v1
              read v2
            read v2
      call subtract
        code 1
        call multiply
          call lorentz-form
            read a0
            read a1
            read a2
            read v0
            read v1
            read v2
          call lorentz-form
            read a0
            read a1
            read a2
            read v0
            read v1
            read v2

# CONGRUENCE: SIDE-ANGLE-SIDE, Hilbert's axiom III.5, as a theorem. Segments are congruent when B (cosh of the length)
# agrees, and the angle at a vertex is read from the tangent product B(u, w) (with equal sides, equal B(u, w) is equal
# cosine). If triangles (a, b, c) and (p, q, r) agree in the two sides at a and p and in the angle between them, their
# third sides agree: B(b, c) = B(q, r).
rule side-angle-side
  mark a0, like integer
  mark a1, like integer
  mark a2, like integer
  mark b0, like integer
  mark b1, like integer
  mark b2, like integer
  mark c0, like integer
  mark c1, like integer
  mark c2, like integer
  mark p0, like integer
  mark p1, like integer
  mark p2, like integer
  mark q0, like integer
  mark q1, like integer
  mark q2, like integer
  mark r0, like integer
  mark r1, like integer
  mark r2, like integer
  have a-point
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read a0
        read a1
        read a2
      code 1
  have p-point
    call is-equal
      call lorentz-form
        read p0
        read p1
        read p2
        read p0
        read p1
        read p2
      code 1
  have first-side
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read b0
        read b1
        read b2
      call lorentz-form
        read p0
        read p1
        read p2
        read q0
        read q1
        read q2
  have second-side
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read c0
        read c1
        read c2
      call lorentz-form
        read p0
        read p1
        read p2
        read r0
        read r1
        read r2
  have included-angle
    call is-equal
      call lorentz-form
        call subtract
          read b0
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read a0
              read a1
              read a2
            read a0
        call subtract
          read b1
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read a0
              read a1
              read a2
            read a1
        call subtract
          read b2
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read a0
              read a1
              read a2
            read a2
        call subtract
          read c0
          call multiply
            call lorentz-form
              read c0
              read c1
              read c2
              read a0
              read a1
              read a2
            read a0
        call subtract
          read c1
          call multiply
            call lorentz-form
              read c0
              read c1
              read c2
              read a0
              read a1
              read a2
            read a1
        call subtract
          read c2
          call multiply
            call lorentz-form
              read c0
              read c1
              read c2
              read a0
              read a1
              read a2
            read a2
      call lorentz-form
        call subtract
          read q0
          call multiply
            call lorentz-form
              read q0
              read q1
              read q2
              read p0
              read p1
              read p2
            read p0
        call subtract
          read q1
          call multiply
            call lorentz-form
              read q0
              read q1
              read q2
              read p0
              read p1
              read p2
            read p1
        call subtract
          read q2
          call multiply
            call lorentz-form
              read q0
              read q1
              read q2
              read p0
              read p1
              read p2
            read p2
        call subtract
          read r0
          call multiply
            call lorentz-form
              read r0
              read r1
              read r2
              read p0
              read p1
              read p2
            read p0
        call subtract
          read r1
          call multiply
            call lorentz-form
              read r0
              read r1
              read r2
              read p0
              read p1
              read p2
            read p1
        call subtract
          read r2
          call multiply
            call lorentz-form
              read r0
              read r1
              read r2
              read p0
              read p1
              read p2
            read p2
  show hold
    call is-equal
      call lorentz-form
        read b0
        read b1
        read b2
        read c0
        read c1
        read c2
      call lorentz-form
        read q0
        read q1
        read q2
        read r0
        read r1
        read r2

# SIDE-SIDE-SIDE: triangles with three congruent sides have congruent angles.
rule side-side-side-gives-the-angle
  mark a0, like integer
  mark a1, like integer
  mark a2, like integer
  mark b0, like integer
  mark b1, like integer
  mark b2, like integer
  mark c0, like integer
  mark c1, like integer
  mark c2, like integer
  mark p0, like integer
  mark p1, like integer
  mark p2, like integer
  mark q0, like integer
  mark q1, like integer
  mark q2, like integer
  mark r0, like integer
  mark r1, like integer
  mark r2, like integer
  have a-point
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read a0
        read a1
        read a2
      code 1
  have p-point
    call is-equal
      call lorentz-form
        read p0
        read p1
        read p2
        read p0
        read p1
        read p2
      code 1
  have first-side
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read b0
        read b1
        read b2
      call lorentz-form
        read p0
        read p1
        read p2
        read q0
        read q1
        read q2
  have second-side
    call is-equal
      call lorentz-form
        read a0
        read a1
        read a2
        read c0
        read c1
        read c2
      call lorentz-form
        read p0
        read p1
        read p2
        read r0
        read r1
        read r2
  have third-side
    call is-equal
      call lorentz-form
        read b0
        read b1
        read b2
        read c0
        read c1
        read c2
      call lorentz-form
        read q0
        read q1
        read q2
        read r0
        read r1
        read r2
  show hold
    call is-equal
      call lorentz-form
        call subtract
          read b0
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read a0
              read a1
              read a2
            read a0
        call subtract
          read b1
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read a0
              read a1
              read a2
            read a1
        call subtract
          read b2
          call multiply
            call lorentz-form
              read b0
              read b1
              read b2
              read a0
              read a1
              read a2
            read a2
        call subtract
          read c0
          call multiply
            call lorentz-form
              read c0
              read c1
              read c2
              read a0
              read a1
              read a2
            read a0
        call subtract
          read c1
          call multiply
            call lorentz-form
              read c0
              read c1
              read c2
              read a0
              read a1
              read a2
            read a1
        call subtract
          read c2
          call multiply
            call lorentz-form
              read c0
              read c1
              read c2
              read a0
              read a1
              read a2
            read a2
      call lorentz-form
        call subtract
          read q0
          call multiply
            call lorentz-form
              read q0
              read q1
              read q2
              read p0
              read p1
              read p2
            read p0
        call subtract
          read q1
          call multiply
            call lorentz-form
              read q0
              read q1
              read q2
              read p0
              read p1
              read p2
            read p1
        call subtract
          read q2
          call multiply
            call lorentz-form
              read q0
              read q1
              read q2
              read p0
              read p1
              read p2
            read p2
        call subtract
          read r0
          call multiply
            call lorentz-form
              read r0
              read r1
              read r2
              read p0
              read p1
              read p2
            read p0
        call subtract
          read r1
          call multiply
            call lorentz-form
              read r0
              read r1
              read r2
              read p0
              read p1
              read p2
            read p1
        call subtract
          read r2
          call multiply
            call lorentz-form
              read r0
              read r1
              read r2
              read p0
              read p1
              read p2
            read p2

# HOMOGENEITY: any point maps to any other by an isometry. The reflection in the line with normal n = x - o (the
# perpendicular bisector) sends o to x: B(n, n) R(o) = B(n, n) o - 2 B(o, n) n = B(n, n) x, written without the
# division so that it holds for every pair of points (n is spacelike whenever x is not o).
rule any-point-reflects-onto-any-other-t
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark o0, like integer
  mark o1, like integer
  mark o2, like integer
  have x-point
    call is-equal
      call lorentz-form
        read x0
        read x1
        read x2
        read x0
        read x1
        read x2
      code 1
  have o-point
    call is-equal
      call lorentz-form
        read o0
        read o1
        read o2
        read o0
        read o1
        read o2
      code 1
  show hold
    call is-equal
      call subtract
        call multiply
          call lorentz-form
            call subtract
              read x0
              read o0
            call subtract
              read x1
              read o1
            call subtract
              read x2
              read o2
            call subtract
              read x0
              read o0
            call subtract
              read x1
              read o1
            call subtract
              read x2
              read o2
          read o0
        call multiply
          call multiply
            code 2
            call lorentz-form
              read o0
              read o1
              read o2
              call subtract
                read x0
                read o0
              call subtract
                read x1
                read o1
              call subtract
                read x2
                read o2
          call subtract
            read x0
            read o0
      call multiply
        call lorentz-form
          call subtract
            read x0
            read o0
          call subtract
            read x1
            read o1
          call subtract
            read x2
            read o2
          call subtract
            read x0
            read o0
          call subtract
            read x1
            read o1
          call subtract
            read x2
            read o2
        read x0

rule any-point-reflects-onto-any-other-x
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark o0, like integer
  mark o1, like integer
  mark o2, like integer
  have x-point
    call is-equal
      call lorentz-form
        read x0
        read x1
        read x2
        read x0
        read x1
        read x2
      code 1
  have o-point
    call is-equal
      call lorentz-form
        read o0
        read o1
        read o2
        read o0
        read o1
        read o2
      code 1
  show hold
    call is-equal
      call subtract
        call multiply
          call lorentz-form
            call subtract
              read x0
              read o0
            call subtract
              read x1
              read o1
            call subtract
              read x2
              read o2
            call subtract
              read x0
              read o0
            call subtract
              read x1
              read o1
            call subtract
              read x2
              read o2
          read o1
        call multiply
          call multiply
            code 2
            call lorentz-form
              read o0
              read o1
              read o2
              call subtract
                read x0
                read o0
              call subtract
                read x1
                read o1
              call subtract
                read x2
                read o2
          call subtract
            read x1
            read o1
      call multiply
        call lorentz-form
          call subtract
            read x0
            read o0
          call subtract
            read x1
            read o1
          call subtract
            read x2
            read o2
          call subtract
            read x0
            read o0
          call subtract
            read x1
            read o1
          call subtract
            read x2
            read o2
        read x1

rule any-point-reflects-onto-any-other-y
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark o0, like integer
  mark o1, like integer
  mark o2, like integer
  have x-point
    call is-equal
      call lorentz-form
        read x0
        read x1
