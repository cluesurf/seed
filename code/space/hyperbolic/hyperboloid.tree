# THE POINCARE DISK. A point p of the unit disk lifts to x = (1 + |p|^2, 2 p) / (1 - |p|^2) on the hyperboloid: with
# X = (1 + |p|^2, 2 p1, 2 p2) and s = 1 - |p|^2, B(X, X) = s^2.
rule the-disk-lift-lands-on-the-hyperboloid
  mark p1, like integer
  mark p2, like integer
  show hold
    call is-equal
      call lorentz-form
        call add
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2
        call multiply
          code 2
          read p1
        call multiply
          code 2
          read p2
        call add
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2
        call multiply
          code 2
          read p1
        call multiply
          code 2
          read p2
      call multiply
        call subtract
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2
        call subtract
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2

# THE DISTANCE IN THE DISK: B(X, Y) - s t = 2 |p - q|^2, so cosh d = 1 + 2 |p - q|^2 / ((1 - |p|^2)(1 - |q|^2)).
# Inside the disk s, t > 0, so cosh d >= 1, the distance is real and positive, and it is 0 only at p = q.
rule the-disk-distance-formula
  mark p1, like integer
  mark p2, like integer
  mark q1, like integer
  mark q2, like integer
  show hold
    call is-equal
      call subtract
        call lorentz-form
          call add
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call multiply
            code 2
            read p1
          call multiply
            code 2
            read p2
          call add
            code 1
            call add
              call multiply
                read q1
                read q1
              call multiply
                read q2
                read q2
          call multiply
            code 2
            read q1
          call multiply
            code 2
            read q2
        call multiply
          call subtract
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call subtract
            code 1
            call add
              call multiply
                read q1
                read q1
              call multiply
                read q2
                read q2
      call multiply
        code 2
        call add
          call multiply
            call subtract
              read p1
              read q1
            call subtract
              read p1
              read q1
          call multiply
            call subtract
              read p2
              read q2
            call subtract
              read p2
              read q2

rule the-disk-distance-is-at-least-one-in-cosh
  mark p1, like integer
  mark p2, like integer
  mark q1, like integer
  mark q2, like integer
  show hold
    call is-minimum
      call subtract
        call lorentz-form
          call add
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call multiply
            code 2
            read p1
          call multiply
            code 2
            read p2
          call add
            code 1
            call add
              call multiply
                read q1
                read q1
              call multiply
                read q2
                read q2
          call multiply
            code 2
            read q1
          call multiply
            code 2
            read q2
        call multiply
          call subtract
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call subtract
            code 1
            call add
              call multiply
                read q1
                read q1
              call multiply
                read q2
                read q2
      code 0

# THE KLEIN DISK: the same point is k = 2 p / (1 + |p|^2), and (1 + |p|^2)^2 (1 - |k|^2) = (1 - |p|^2)^2, so the
# Klein point lies in the unit disk too, and the two disks are maps of one plane.
rule the-klein-point-lies-in-the-disk
  mark p1, like integer
  mark p2, like integer
  show hold
    call is-equal
      call subtract
        call multiply
          call add
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call add
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
        call multiply
          code 4
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2
      call multiply
        call subtract
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2
        call subtract
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2

# A LINE IN THE DISK IS A CIRCLE ORTHOGONAL TO THE BOUNDARY. The points of the line n are the p with
# n0 (1 + |p|^2) - 2 (n1 p1 + n2 p2) = 0: a circle with center (n1, n2) / n0 and |center|^2 - radius^2 = 1, the
# condition for meeting the unit circle at right angles (a diameter when n0 = 0). Its radius^2 is
# (n1^2 + n2^2 - n0^2) / n0^2 = -B(n, n) / n0^2 > 0 exactly because n is spacelike.
rule a-line-in-the-disk-is-a-circle
  mark p1, like integer
  mark p2, like integer
  mark n0, like integer
  mark n1, like integer
  mark n2, like integer
  show hold
    call is-equal
      call lorentz-form
        call add
          code 1
          call add
            call multiply
              read p1
              read p1
            call multiply
              read p2
              read p2
        call multiply
          code 2
          read p1
        call multiply
          code 2
          read p2
        read n0
        read n1
        read n2
      call subtract
        call subtract
          call multiply
            read n0
            call add
              code 1
              call add
                call multiply
                  read p1
                  read p1
                call multiply
                  read p2
                  read p2
          call multiply
            call multiply
              code 2
              read n1
            read p1
        call multiply
          call multiply
            code 2
            read n2
          read p2

# THE UPPER HALF PLANE. A Mobius map z -> (a z + b) / (c z + d) with real a, b, c, d and a d - b c = 1 multiplies
# Im z by 1 / |c z + d|^2: the imaginary part of (a z + b)(c conj(z) + d) is (a d - b c) Im z = Im z. So it keeps the
# upper half plane. And (a z + b)(c w + d) - (a w + b)(c z + d) = (a d - b c)(z - w), so it scales a difference by
# 1 / ((c z + d)(c w + d)), which with the first fact makes cosh d = 1 + |z - w|^2 / (2 Im z Im w) invariant.

# The imaginary part of a product of complex numbers (u1 + i u2)(v1 + i v2).
task complex-product-imaginary
  take u1, like integer
  take u2, like integer
  take v1, like integer
  take v2, like integer
  like integer
  send back
    call add
      call multiply
        read u1
        read v2
      call multiply
        read u2
        read v1

rule a-mobius-map-keeps-the-imaginary-part
  mark ma, like integer
  mark mb, like integer
  mark mc, like integer
  mark md, like integer
  mark zr, like integer
  mark zi, like integer
  have unimodular
    call is-equal
      call subtract
        call multiply
          read ma
          read md
        call multiply
          read mb
          read mc
      code 1
  show hold
    call is-equal
      call complex-product-imaginary
        call add
          call multiply
            read ma
            read zr
          read mb
        call multiply
          read ma
          read zi
        call add
          call multiply
            read mc
            read zr
          read md
        call subtract
          code 0
          call multiply
            read mc
            read zi
      read zi

rule a-mobius-map-scales-differences
  mark ma, like integer
  mark mb, like integer
  mark mc, like integer
  mark md, like integer
  mark z, like integer
  mark w, like integer
  show hold
    call is-equal
      call subtract
        call multiply
          call add
            call multiply
              read ma
              read z
            read mb
          call add
            call multiply
              read mc
              read w
            read md
        call multiply
          call add
            call multiply
              read ma
              read w
            read mb
          call add
            call multiply
              read mc
              read z
            read md
      call multiply
        call subtract
          call multiply
            read ma
            read md
          call multiply
            read mb
            read mc
        call subtract
          read z
          read w

# CIRCLES, HOROCYCLES AND EQUIDISTANTS: the points at constant B(x, g) = k from a fixed vector g are a circle when g is
# a point, a horocycle when g is on the light cone (a point at infinity), and an equidistant of a line when g is
# spacelike. In the disk every one of them is a Euclidean circle: B(X, g) - k s = (g0 + k)|p|^2 - 2 (g1 p1 + g2 p2)
# + (g0 - k), a quadratic with equal coefficients on p1^2 and p2^2.
rule every-curve-of-constant-distance-is-a-circle-in-the-disk
  mark p1, like integer
  mark p2, like integer
  mark g0, like integer
  mark g1, like integer
  mark g2, like integer
  mark k, like integer
  show hold
    call is-equal
      call subtract
        call lorentz-form
          call add
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call multiply
            code 2
            read p1
          call multiply
            code 2
            read p2
          read g0
          read g1
          read g2
        call multiply
          read k
          call subtract
            code 1
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
      call add
        call add
          call multiply
            call add
              read g0
              read k
            call add
              call multiply
                read p1
                read p1
              call multiply
                read p2
                read p2
          call subtract
            code 0
            call multiply
              code 2
              call add
                call multiply
                  read g1
                  read p1
                call multiply
                  read g2
                  read p2
        call subtract
          read g0
          read k

