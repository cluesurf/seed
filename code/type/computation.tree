# Kernel-COMPUTED proofs: the type theory's enum constructors and eliminator are derived as computing self-type terms,
# so the kernel actually reduces a match on a constructor (`match (v_i) ... -> branch_i`). The `calm` tactic then
# discharges an equation by the kernel checking both sides reduce to the same normal form (reflexivity / definitional
# equality), NOT by the arithmetic decision procedures. These are genuine dependent-type proofs checked by judge.ts.

# A bit: the two-element type, off and on.
form bit
  case off
  case on

# flip: swaps off and on, defined by a match (which the kernel reduces).
task flip
  take b, like bit
  like bit
  fork case, read b
    case off
      send back
        make on
    case on
      send back
        make off

# flip off computes to on: the kernel reduces flip off through the eliminator and checks it equals on. Proved by calm.
rule flip-off-is-on
  show hold
    call is-equal
      call flip
        make off
      make on
  calm hold

# flip on computes to off.
rule flip-on-is-off
  show hold
    call is-equal
      call flip
        make on
      make off
  calm hold

# flip is an involution at off: flipping twice returns off. The kernel performs TWO reductions and checks the result.
rule flip-flip-off-is-off
  show hold
    call is-equal
      call flip
        call flip
          make off
      make off
  calm hold

# Boolean conjunction: and off b = off, and on b = b. Defined by a match the kernel reduces.
task both
  take a, like bit
  take b, like bit
  like bit
  fork case, read a
    case off
      send back
        make off
    case on
      send back
        read b

# Boolean disjunction: or off b = b, or on b = on.
task some
  take a, like bit
  take b, like bit
  like bit
  fork case, read a
    case off
      send back
        read b
    case on
      send back
        make on

# UNIVERSAL law: off is the absorber of and. and off b = off, for every b. Definitional, proved by the kernel.
rule both-off-absorbs
  seat b, like bit
  show hold
    call is-equal
      call both
        make off
        read b
      make off
  calm hold

# UNIVERSAL law: on is the identity of and. and on b = b, for every b.
rule both-on-is-identity
  seat b, like bit
  show hold
    call is-equal
      call both
        make on
        read b
      read b
  calm hold

# UNIVERSAL law: on is the absorber of or. or on b = on, for every b.
rule some-on-absorbs
  seat b, like bit
  show hold
    call is-equal
      call some
        make on
        read b
      make on
  calm hold

# UNIVERSAL law: off is the identity of or. or off b = b, for every b.
rule some-off-is-identity
  seat b, like bit
  show hold
    call is-equal
      call some
        make off
        read b
      read b
  calm hold

# de Morgan, concretely: not (and on off) = or (not on) (not off). The kernel reduces both sides to on.
rule de-morgan-on-off
  show hold
    call is-equal
      call flip
        call both
          make on
          make off
      call some
        call flip
          make on
        call flip
          make off
  calm hold
