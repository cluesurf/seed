# The binary tree as an inductive self-type, with mirror and size by structural recursion and their laws PROVED BY THE
# KERNEL. A bush is empty (leaf) or a branch (node) carrying a left subtree, a value, and a right subtree. It is the
# canonical two-recursive-field inductive type, so its induction principle uses the hypothesis on BOTH subtrees at once.
# The name is `bush` because `tree` is reserved for the syntax AST, exactly as `roll` stands in for the reserved `list`.

# A natural number: zero, or the successor of a natural.
form natural
  case zero
  case succ
    link prior, like natural

# Addition by recursion on the first argument, used to size a tree by counting its nodes.
task plus
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      send back
        make succ
          bind prior
            call plus
              read prior
              read b

# A binary tree of naturals: a leaf, or a node with a left subtree, a value, and a right subtree.
form bush
  case leaf
  case node
    link left, like bush
    link value, like natural
    link right, like bush

# mirror reflects a tree left-to-right: leaf stays a leaf, and a node swaps its mirrored subtrees.
task mirror
  take t, like bush
  like bush
  fork case, read t
    case leaf
      send back
        make leaf
    case node
      send back
        make node
          bind left
            call mirror
              read right
          bind value
            read value
          bind right
            call mirror
              read left

# size counts the nodes: a leaf has none, a node has one plus the sizes of its two subtrees.
task size
  take t, like bush
  like natural
  fork case, read t
    case leaf
      send back
        make zero
    case node
      send back
        make succ
          bind prior
            call plus
              call size
                read left
              call size
                read right

# UNIVERSAL: mirroring a leaf gives a leaf. Definitional.
rule mirror-leaf-is-leaf
  show hold
    call is-equal
      call mirror
        make leaf
      make leaf
  calm hold

# UNIVERSAL: a leaf has size zero. Definitional.
rule size-leaf-is-zero
  show hold
    call is-equal
      call size
        make leaf
      make zero
  calm hold

# UNIVERSAL: mirror is an involution. mirror (mirror t) = t, for every tree t. Proved by induction on t: the leaf case
# computes, and the node case closes using the induction hypothesis on BOTH the left and the right subtree.
rule mirror-mirror-is-identity
  seat t, like bush
  show hold
    call is-equal
      call mirror, read t
        link mirror
      read t
  fold t

# helper plus laws (commutativity, for the swapped subtree sizes under mirror).
rule plus-zero-right-on-size
  seat n, like natural
  show hold
    call is-equal
      call plus
        read n
        make zero
      read n
  fold n

rule plus-succ-right-on-size
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call plus
        read a
        make succ
          bind prior
            read b
      make succ
        bind prior
          call plus
            read a
            read b
  fold a

rule plus-is-commutative-on-size
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call plus
        read a
        read b
      call plus
        read b
        read a
  fold a
    cite plus-zero-right-on-size
    cite plus-succ-right-on-size

# definitional step laws of mirror and size on a node.
rule mirror-node-steps
  seat l, like bush
  seat v, like natural
  seat r, like bush
  show hold
    call is-equal
      call mirror
        make node
          bind left
            read l
          bind value
            read v
          bind right
            read r
      make node
        bind left
          call mirror
            read r
        bind value
          read v
        bind right
          call mirror
            read l
  calm hold

rule size-node-steps
  seat l, like bush
  seat v, like natural
  seat r, like bush
  show hold
    call is-equal
      call size
        make node
          bind left
            read l
          bind value
            read v
          bind right
            read r
      make succ
        bind prior
          call plus
            call size
              read l
            call size
              read r
  calm hold

# mirror preserves size: size (mirror t) = size t, for every tree. By induction on t; the node case swaps the two
# subtree sizes, which agree by commutativity of addition (handled by AC normalization).
rule size-of-mirror-is-size
  seat t, like bush
  show hold
    call is-equal
      call mirror, read t
        link size
      call size
        read t
  fold t
    cite mirror-node-steps
    cite size-node-steps
    cite plus-is-commutative-on-size
