# The inductive cons-list as a self-type, with length and append defined by structural recursion and their laws PROVED
# BY THE KERNEL computing normal forms (the same dependent-proof path as the Peano naturals). A roll is empty (nil) or a
# head element consed onto a tail roll. It is the free monoid on naturals, the inductive sibling of the native `list`
# array: where `list` is a primitive container, a `roll` is built nil-then-cons and reduces under the kernel, so its
# equations check by reflexivity. This mirrors the list theory of agda-unimath / Lean's standard library, in seed .tree.
# The recursions descend on the matched tail, so they are verified terminating and the kernel unfolds them transparently.

# A natural number: zero, or the successor of a natural.
form natural
  case zero
  case succ
    link prior, like natural

# Addition by recursion on the first argument, needed to state the length homomorphism below.
task plus
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      send back
        make succ
          bind prior
            call plus
              read prior
              read b

# A roll of naturals: empty, or a head element consed onto a tail roll.
form roll
  case nil
  case cons
    link item, like natural
    link more, like roll

# the length of a roll, by recursion on its structure: length nil = 0, length (cons h t) = succ (length t).
task length
  take xs, like roll
  like natural
  fork case, read xs
    case nil
      send back
        make zero
    case cons
      send back
        make succ
          bind prior
            call length
              read more

# append two rolls, by recursion on the first: append nil ys = ys, append (cons h t) ys = cons h (append t ys).
task append
  take xs, like roll
  take ys, like roll
  like roll
  fork case, read xs
    case nil
      send back
        read ys
    case cons
      send back
        make cons
          bind item
            read item
          bind more
            call append
              read more
              read ys

# UNIVERSAL: the empty roll has length zero (the nil branch). Definitional, the kernel reduces length nil to zero.
rule length-of-nil-is-zero
  show hold
    call is-equal
      call length
        make nil
      make zero
  calm hold

# UNIVERSAL: nil is a left identity for append. append nil ys = ys, for every roll ys. Definitional.
rule append-nil-left-is-identity
  seat ys, like roll
  show hold
    call is-equal
      call append
        make nil
        read ys
      read ys
  calm hold

# UNIVERSAL: length steps through a cons. length (cons h t) = succ (length t), for every head h and tail t. Definitional.
rule length-of-cons-steps
  seat h, like natural
  seat t, like roll
  show hold
    call is-equal
      call length
        make cons
          bind item
            read h
          bind more
            read t
      make succ
        bind prior
          call length
            read t
  calm hold

# UNIVERSAL: append steps through a cons. append (cons h t) ys = cons h (append t ys), for every h, t, ys. Definitional.
rule append-of-cons-steps
  seat h, like natural
  seat t, like roll
  seat ys, like roll
  show hold
    call is-equal
      call append
        make cons
          bind item
            read h
          bind more
            read t
        read ys
      make cons
        bind item
          read h
        bind more
          call append
            read t
            read ys
  calm hold

# The laws below are NOT definitional: append recurses on its FIRST argument, so each is stuck on a variable list and is
# proved by structural induction on that list (`fold xs`). The nil case holds by computation; the cons case closes using
# the induction hypothesis on the tail. This is the inductive theory of lists, the same theorems agda-unimath / Lean
# prove for their list type, here checked by the kernel through the type's eliminator.

# nil is ALSO a right identity for append: append xs nil = xs, for every roll xs.
rule append-nil-right-is-identity
  seat xs, like roll
  show hold
    call is-equal
      call append
        read xs
        make nil
      read xs
  fold xs

# append is associative: append (append xs ys) zs = append xs (append ys zs), for every xs, ys, zs.
rule append-is-associative
  seat xs, like roll
  seat ys, like roll
  seat zs, like roll
  show hold
    call is-equal
      call append
        call append
          read xs
          read ys
        read zs
      call append
        read xs
        call append
          read ys
          read zs
  fold xs

# length is a monoid homomorphism from append to plus: length (append xs ys) = length xs + length ys, for every xs, ys.
rule length-of-append-adds
  seat xs, like roll
  seat ys, like roll
  show hold
    call is-equal
      call length
        call append
          read xs
          read ys
      call plus
        call length
          read xs
        call length
          read ys
  fold xs

# reverse: the list read back to front, built by appending each head as a one-element list at the end.
task reverse
  take xs, like roll
  like roll
  fork case, read xs
    case nil
      send back
        make nil
    case cons
      send back
        call append
          call reverse
            read more
          make cons
            bind item
              read item
            bind more
              make nil

rule reverse-nil-is-nil
  show hold
    call is-equal
      call reverse
        make nil
      make nil
  calm hold

rule reverse-cons-steps
  seat h, like natural
  seat t, like roll
  show hold
    call is-equal
      call reverse
        make cons
          bind item
            read h
          bind more
            read t
      call append
        call reverse
          read t
        make cons
          bind item
            read h
          bind more
            make nil
  calm hold

# reverse is an anti-homomorphism on append: reverse (append xs ys) = append (reverse ys) (reverse xs). By induction on
# xs, using the reverse and append step laws and associativity of append.
rule reverse-of-append
  seat xs, like roll
  seat ys, like roll
  show hold
    call is-equal
      call append
        read xs
        read ys
        link reverse
      call append
        call reverse
          read ys
        call reverse
          read xs
  fold xs
    cite reverse-nil-is-nil
    cite reverse-cons-steps
    cite append-of-cons-steps
    cite append-is-associative
    cite append-nil-right-is-identity

# reverse is an INVOLUTION: reverse (reverse xs) = xs, for every list. The canonical list theorem, by induction on xs
# citing the reverse-append anti-homomorphism.
rule reverse-reverse-is-identity
  seat xs, like roll
  show hold
    call is-equal
      call reverse, read xs
        link reverse
      read xs
  fold xs
    cite reverse-nil-is-nil
    cite reverse-cons-steps
    cite reverse-of-append

# helper plus laws (over the lengths) for the length-of-reverse theorem.
rule plus-zero-right-on-length
  seat n, like natural
  show hold
    call is-equal
      call plus
        read n
        make zero
      read n
  fold n

rule plus-succ-right-on-length
  seat a, like natural
  seat b, like natural
  show hold
    call is-equal
      call plus
        read a
        make succ
          bind prior
            read b
      make succ
        bind prior
          call plus
            read a
            read b
  fold a

# reverse preserves length: length (reverse xs) = length xs, for every list. By induction on xs, using the reverse step
# law, the length-of-append homomorphism, and the plus step laws.
rule length-of-reverse-is-length
  seat xs, like roll
  show hold
    call is-equal
      call reverse, read xs
        link length
      call length
        read xs
  fold xs
    cite reverse-cons-steps
    cite length-of-append-adds
    cite length-of-cons-steps
    cite length-of-nil-is-zero
    cite plus-succ-right-on-length
    cite plus-zero-right-on-length
