# The flag, a truth value: yes or no. This is the shared boolean used as the result of comparisons (equality, order)
# throughout the library. Defined once here and imported, never redefined. Conjunction and disjunction are given, with
# their identities.
form flag
  case yes
  case no

# Conjunction: both must be yes.
task both
  take a, like flag
  take b, like flag
  like flag
  fork case, read a
    case yes
      send back
        read b
    case no
      send back
        make no

# Disjunction: either may be yes.
task either
  take a, like flag
  take b, like flag
  like flag
  fork case, read a
    case yes
      send back
        make yes
    case no
      send back
        read b

# YES IS THE IDENTITY OF CONJUNCTION: both yes a = a.
rule both-yes-left-is-identity
  mark a, like flag
  show hold
    call is-equal
      call both
        make yes
        read a
      read a
  fold a

# NO IS THE IDENTITY OF DISJUNCTION: either no a = a.
rule either-no-left-is-identity
  mark a, like flag
  show hold
    call is-equal
      call either
        make no
        read a
      read a
  fold a

# Negation: yes and no trade places.
task not-flag
  take a, like flag
  like flag
  fork case, read a
    case yes
      send back
        make no
    case no
      send back
        make yes

# Implication: a implies b is no only when a is yes and b is no. A theorem "P implies Q" over a finite type can be
# stated as `implies P Q = yes` for every value, which needs no hypothesis handling.
task implies
  take a, like flag
  take b, like flag
  like flag
  fork case, read a
    case yes
      send back
        read b
    case no
      send back
        make yes

# NEGATION IS AN INVOLUTION.
rule not-flag-is-an-involution
  mark a, like flag
  show hold
    call is-equal
      call not-flag
        call not-flag
          read a
      read a
  fold a

# MODUS PONENS, as a table: if a holds and a implies b, then b holds.
rule implication-carries-truth
  mark a, like flag
  mark b, like flag
  have premise
    call is-equal
      read a
      make yes
  have implication
    call is-equal
      call implies
        read a
        read b
      make yes
  show hold
    call is-equal
      read b
      make yes
  fold a, b
