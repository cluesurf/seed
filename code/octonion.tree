# The octonions, the eight-dimensional normed division algebra at the foundation of vibe theory, modeled as a REAL
# COMPUTABLE ALGEBRA. One real unit e0 and seven imaginary units e1..e7; you can multiply any two, and the kernel proves
# the defining relations: each imaginary unit squares to minus one, e0 is the identity, and the property that makes the
# octonions the octonions and not the quaternions, they are NON-ASSOCIATIVE: (e1 e2) e4 and e1 (e2 e4) differ by a sign.
# Built by Cayley-Dickson doubling of the quaternions. The 64-entry multiplication table is generated by a single `tree`
# TEMPLATE fused once per entry, so each line `fuse mul-row, e_i, sign, e_k` reads as the product e_i times the row's unit,
# instead of a seven-line block repeated sixty-four times.

form sign
  case pos
  case neg

# The eight octonion units: one real, seven imaginary.
form gen
  case e0
  case e1
  case e2
  case e3
  case e4
  case e5
  case e6
  case e7

# An octonion basis element: a signed unit.
form octo
  case scaled
    link sign, like sign
    link gen, like gen

task mul-sign
  take a, like sign
  take b, like sign
  like sign
  fork case, read a
    case pos
      send back
        read b
    case neg
      fork case, read b
        case pos
          send back
            make neg
        case neg
          send back
            make pos

# TEMPLATE: one entry of the multiplication table. Given the second factor and the resulting signed unit, emit the case
# branch. This single definition replaces every repeated `case .. / send back / make scaled / ..` block.
tree mul-entry
  take col
  take s
  take res

  hook fuse
    case {col}
      send back
        make scaled
          bind sign
            make {s}
          bind gen
            make {res}

# THE MULTIPLICATION of the units, the Fano-plane product e_i e_j. Each row fuses the template eight times; the lines read
# straight off the octonion table.
task mul-gen
  take a, like gen
  take b, like gen
  like octo
  fork case, read a
    case e0
      fork case, read b
        fuse mul-entry, e0, pos, e0
        fuse mul-entry, e1, pos, e1
        fuse mul-entry, e2, pos, e2
        fuse mul-entry, e3, pos, e3
        fuse mul-entry, e4, pos, e4
        fuse mul-entry, e5, pos, e5
        fuse mul-entry, e6, pos, e6
        fuse mul-entry, e7, pos, e7
    case e1
      fork case, read b
        fuse mul-entry, e0, pos, e1
        fuse mul-entry, e1, neg, e0
        fuse mul-entry, e2, pos, e3
        fuse mul-entry, e3, neg, e2
        fuse mul-entry, e4, pos, e5
        fuse mul-entry, e5, neg, e4
        fuse mul-entry, e6, neg, e7
        fuse mul-entry, e7, pos, e6
    case e2
      fork case, read b
        fuse mul-entry, e0, pos, e2
        fuse mul-entry, e1, neg, e3
        fuse mul-entry, e2, neg, e0
        fuse mul-entry, e3, pos, e1
        fuse mul-entry, e4, pos, e6
        fuse mul-entry, e5, pos, e7
        fuse mul-entry, e6, neg, e4
        fuse mul-entry, e7, neg, e5
    case e3
      fork case, read b
        fuse mul-entry, e0, pos, e3
        fuse mul-entry, e1, pos, e2
        fuse mul-entry, e2, neg, e1
        fuse mul-entry, e3, neg, e0
        fuse mul-entry, e4, pos, e7
        fuse mul-entry, e5, neg, e6
        fuse mul-entry, e6, pos, e5
        fuse mul-entry, e7, neg, e4
    case e4
      fork case, read b
        fuse mul-entry, e0, pos, e4
        fuse mul-entry, e1, neg, e5
        fuse mul-entry, e2, neg, e6
        fuse mul-entry, e3, neg, e7
        fuse mul-entry, e4, neg, e0
        fuse mul-entry, e5, pos, e1
        fuse mul-entry, e6, pos, e2
        fuse mul-entry, e7, pos, e3
    case e5
      fork case, read b
        fuse mul-entry, e0, pos, e5
        fuse mul-entry, e1, pos, e4
        fuse mul-entry, e2, neg, e7
        fuse mul-entry, e3, pos, e6
        fuse mul-entry, e4, neg, e1
        fuse mul-entry, e5, neg, e0
        fuse mul-entry, e6, neg, e3
        fuse mul-entry, e7, pos, e2
    case e6
      fork case, read b
        fuse mul-entry, e0, pos, e6
        fuse mul-entry, e1, pos, e7
        fuse mul-entry, e2, pos, e4
        fuse mul-entry, e3, neg, e5
        fuse mul-entry, e4, neg, e2
        fuse mul-entry, e5, pos, e3
        fuse mul-entry, e6, neg, e0
        fuse mul-entry, e7, neg, e1
    case e7
      fork case, read b
        fuse mul-entry, e0, pos, e7
        fuse mul-entry, e1, neg, e6
        fuse mul-entry, e2, pos, e5
        fuse mul-entry, e3, pos, e4
        fuse mul-entry, e4, neg, e3
        fuse mul-entry, e5, neg, e2
        fuse mul-entry, e6, pos, e1
        fuse mul-entry, e7, neg, e0

task fold-sign
  take sa, like sign
  take sb, like sign
  take prod, like octo
  like octo
  fork case, read prod
    case scaled
      link sp
      link gp
      send back
        make scaled
          bind sign
            call mul-sign
              call mul-sign
                read sa
                read sb
              read sp
          bind gen
            read gp

# THE PRODUCT of two octonions: multiply any two, the result is always an octonion (the algebra is closed).
task mul
  take x, like octo
  take y, like octo
  like octo
  fork case, read x
    case scaled
      link sx
      link gx
      fork case, read y
        case scaled
          link sy
          link gy
          send back
            call fold-sign
              read sx
              read sy
              call mul-gen
                read gx
                read gy

form flag
  case yes
  case no

task same-sign
  take a, like sign
  take b, like sign
  like flag
  fork case, read a
    case pos
      fork case, read b
        case pos
          send back
            make yes
        case neg
          send back
            make no
    case neg
      fork case, read b
        case pos
          send back
            make no
        case neg
          send back
            make yes

# TEMPLATE: one row of the unit-equality table. same-gen a b is yes iff a and b are the same unit.
tree same-entry
  take col
  take answer

  hook fuse
    case {col}
      send back
        make {answer}

task same-gen
  take a, like gen
  take b, like gen
  like flag
  fork case, read a
    case e0
      fork case, read b
        fuse same-entry, e0, yes
        fuse same-entry, e1, no
        fuse same-entry, e2, no
        fuse same-entry, e3, no
        fuse same-entry, e4, no
        fuse same-entry, e5, no
        fuse same-entry, e6, no
        fuse same-entry, e7, no
    case e1
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, yes
        fuse same-entry, e2, no
        fuse same-entry, e3, no
        fuse same-entry, e4, no
        fuse same-entry, e5, no
        fuse same-entry, e6, no
        fuse same-entry, e7, no
    case e2
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, no
        fuse same-entry, e2, yes
        fuse same-entry, e3, no
        fuse same-entry, e4, no
        fuse same-entry, e5, no
        fuse same-entry, e6, no
        fuse same-entry, e7, no
    case e3
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, no
        fuse same-entry, e2, no
        fuse same-entry, e3, yes
        fuse same-entry, e4, no
        fuse same-entry, e5, no
        fuse same-entry, e6, no
        fuse same-entry, e7, no
    case e4
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, no
        fuse same-entry, e2, no
        fuse same-entry, e3, no
        fuse same-entry, e4, yes
        fuse same-entry, e5, no
        fuse same-entry, e6, no
        fuse same-entry, e7, no
    case e5
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, no
        fuse same-entry, e2, no
        fuse same-entry, e3, no
        fuse same-entry, e4, no
        fuse same-entry, e5, yes
        fuse same-entry, e6, no
        fuse same-entry, e7, no
    case e6
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, no
        fuse same-entry, e2, no
        fuse same-entry, e3, no
        fuse same-entry, e4, no
        fuse same-entry, e5, no
        fuse same-entry, e6, yes
        fuse same-entry, e7, no
    case e7
      fork case, read b
        fuse same-entry, e0, no
        fuse same-entry, e1, no
        fuse same-entry, e2, no
        fuse same-entry, e3, no
        fuse same-entry, e4, no
        fuse same-entry, e5, no
        fuse same-entry, e6, no
        fuse same-entry, e7, yes

task and-flag
  take a, like flag
  take b, like flag
  like flag
  fork case, read a
    case yes
      send back
        read b
    case no
      send back
        make no

# Octonion equality: same sign and same unit.
task same-octo
  take x, like octo
  take y, like octo
  like flag
  fork case, read x
    case scaled
      link sx
      link gx
      fork case, read y
        case scaled
          link sy
          link gy
          send back
            call and-flag
              call same-sign
                read sx
                read sy
              call same-gen
                read gx
                read gy

# TEMPLATE: a single-product fact, mul e_a e_b = (sign) e_c. The product rules below are one line each.
tree product
  take name
  take a
  take b
  take rs
  take rc

  hook fuse
    rule {name}
      show hold
        call is-equal
          call mul
            make scaled
              bind sign
                make pos
              bind gen
                make {a}
            make scaled
              bind sign
                make pos
              bind gen
                make {b}
          make scaled
            bind sign
              make {rs}
            bind gen
              make {rc}
      calm hold

# Each imaginary unit squares to minus one, and the products that witness non-associativity, as one-line fuses.
fuse product, e1-squared-is-minus-one, e1, e1, neg, e0
fuse product, e1-times-e2-is-e3, e1, e2, pos, e3
fuse product, e3-times-e4-is-e7, e3, e4, pos, e7
fuse product, e2-times-e4-is-e6, e2, e4, pos, e6
fuse product, e1-times-e6-is-minus-e7, e1, e6, neg, e7

# e0 IS THE IDENTITY: mul e0 q = q, for every octonion.
rule e0-is-the-identity
  seat q, like octo
  show hold
    call is-equal
      call mul
        make scaled
          bind sign
            make pos
          bind gen
            make e0
        read q
      read q
  fold q

# NON-ASSOCIATIVITY: by the products above, (e1 e2) e4 = e3 e4 = e7, while e1 (e2 e4) = e1 e6 = -e7. The two groupings are
# DIFFERENT octonions, so the equality of the groupings is false. This is what makes the octonions the LAST division
# algebra. Proved by computing that the two results are not equal.
rule octonions-are-non-associative
  show hold
    call is-equal
      call same-octo
        make scaled
          bind sign
            make pos
          bind gen
            make e7
        make scaled
          bind sign
            make neg
          bind gen
            make e7
      make no
  calm hold