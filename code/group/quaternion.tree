# The quaternion group Q8, the group at the heart of the 24-cell, modeled as a REAL COMPUTABLE GROUP. Its eight elements
# are plus and minus one, i, j, k. You can multiply any two and get a third (closed by construction), and the kernel proves
# the actual laws: each imaginary unit squares to minus one, the cyclic relations i j = k and k k = -1, the identity, and
# that every element has an INVERSE (its conjugate), which makes it a group. The sixteen-entry multiplication table is
# generated by a single `tree` TEMPLATE fused once per entry, so the table reads as one line each instead of a repeated
# seven-line block. The 24-cell is the binary tetrahedral group, this Q8 with the sixteen half-unit quaternions, the 24
# unit Hurwitz quaternions closed under exactly this multiplication.

form sign
  case pos
  case neg

form axis
  case one
  case eye
  case jay
  case kay

form quat
  case scaled
    link sign, like sign
    link part, like axis

task mul-sign
  take a, like sign
  take b, like sign
  like sign
  fork case, read a
    case pos
      send back
        read b
    case neg
      fork case, read b
        case pos
          send back
            make neg
        case neg
          send back
            make pos

task flip-sign
  take s, like sign
  like sign
  fork case, read s
    case pos
      send back
        make neg
    case neg
      send back
        make pos

# TEMPLATE: one entry of the quaternion multiplication table.
tree mul-entry
  take col
  take s
  take res

  hook fuse
    case {col}
      send back
        make scaled
          bind sign
            make {s}
          bind part
            make {res}

# THE MULTIPLICATION TABLE, i j = k and the rest, one fused line per entry.
task mul-axis
  take a, like axis
  take b, like axis
  like quat
  fork case, read a
    case one
      fork case, read b
        fuse mul-entry, one, pos, one
        fuse mul-entry, eye, pos, eye
        fuse mul-entry, jay, pos, jay
        fuse mul-entry, kay, pos, kay
    case eye
      fork case, read b
        fuse mul-entry, one, pos, eye
        fuse mul-entry, eye, neg, one
        fuse mul-entry, jay, pos, kay
        fuse mul-entry, kay, neg, jay
    case jay
      fork case, read b
        fuse mul-entry, one, pos, jay
        fuse mul-entry, eye, neg, kay
        fuse mul-entry, jay, neg, one
        fuse mul-entry, kay, pos, eye
    case kay
      fork case, read b
        fuse mul-entry, one, pos, kay
        fuse mul-entry, eye, pos, jay
        fuse mul-entry, jay, neg, eye
        fuse mul-entry, kay, neg, one

task fold-sign
  take sa, like sign
  take sb, like sign
  take prod, like quat
  like quat
  fork case, read prod
    case scaled
      link sp
      link bp
      send back
        make scaled
          bind sign
            call mul-sign
              call mul-sign
                read sa
                read sb
              read sp
          bind part
            read bp

# THE GROUP MULTIPLICATION: multiply any two quaternions; the result is always a quaternion.
task mul
  take x, like quat
  take y, like quat
  like quat
  fork case, read x
    case scaled
      link sx
      link bx
      fork case, read y
        case scaled
          link sy
          link by
          send back
            call fold-sign
              read sx
              read sy
              call mul-axis
                read bx
                read by

# Conjugate: the inverse of a unit quaternion. The real unit keeps its sign, the imaginary units flip.
task conj
  take x, like quat
  like quat
  fork case, read x
    case scaled
      link s
      link u
      fork case, read u
        case one
          send back
            make scaled
              bind sign
                read s
              bind part
                make one
        case eye
          send back
            make scaled
              bind sign
                call flip-sign
                  read s
              bind part
                make eye
        case jay
          send back
            make scaled
              bind sign
                call flip-sign
                  read s
              bind part
                make jay
        case kay
          send back
            make scaled
              bind sign
                call flip-sign
                  read s
              bind part
                make kay

# TEMPLATE: a single product fact, mul (pos a) (pos b) = (sign) c.
tree product
  take name
  take a
  take b
  take rs
  take rc

  hook fuse
    rule {name}
      show hold
        call is-equal
          call mul
            make scaled
              bind sign
                make pos
              bind part
                make {a}
            make scaled
              bind sign
                make pos
              bind part
                make {b}
          make scaled
            bind sign
              make {rs}
            bind part
              make {rc}
      calm hold

# The quaternion relations, one line each: i^2 = -1, i j = k, j k = i, k i = j, and k^2 = -1.
fuse product, eye-squared-is-minus-one, eye, eye, neg, one
fuse product, eye-times-jay-is-kay, eye, jay, pos, kay
fuse product, jay-times-kay-is-eye, jay, kay, pos, eye
fuse product, kay-times-eye-is-jay, kay, eye, pos, jay
fuse product, kay-squared-is-minus-one, kay, kay, neg, one

# THE IDENTITY: one times any quaternion is itself, over all eight elements.
rule one-is-the-identity
  seat q, like quat
  show hold
    call is-equal
      call mul
        make scaled
          bind sign
            make pos
          bind part
            make one
        read q
      read q
  fold q

# EVERY ELEMENT HAS AN INVERSE: a unit quaternion times its conjugate is one, over all eight elements. This is the group
# axiom that makes Q8 a group, proved, not asserted.
rule every-element-has-an-inverse
  seat q, like quat
  show hold
    call is-equal
      call mul
        read q
        call conj
          read q
      make scaled
        bind sign
          make pos
        bind part
          make one
  fold q