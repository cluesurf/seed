load @term/seed/group/homomorphism
  find group-homomorphism

# A group monomorphism: an injective group homomorphism, one that maps distinct elements to distinct images, so it
# embeds the source group as a subgroup of the target. Its kernel is trivial (only the identity maps to the identity).
# The form carries the underlying homomorphism; injectivity is the added condition.
form group-monomorphism
  link map, like group-homomorphism
