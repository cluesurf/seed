load @term/seed/structure/set
  find set

load @term/seed/structure/function/binary
  find binary-function

# A semigroup: a set with one associative operation, a magma with associativity added but still no identity and no
# inverses. It is the half-step between a magma and a monoid. The positive integers under addition are a semigroup. The
# form carries the set and the operation; associativity is the single law.
form semigroup
  link set, like set
  link operation, like binary-function
