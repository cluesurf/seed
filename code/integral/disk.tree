# THE COMPOSED STATEMENTS: the chain of integral/ and space/hyperbolic/ rules, closed into the theorems they serve.
#
#   THE DISK              integral/hyperbolic-functions puts the Riemann sum S of sinh_N over n strips of [0, r] within
#                         n tol of D = cosh_N(r) - 1, with tol = big (w^2 + w^3) + delta per step (cosh-has-derivative-
#                         sinh-up-to-an-error, the-riemann-sums-with-a-tolerance). integral/limits makes delta <= eps w
#                         for N large (each error term is a term of an exponential series past twice its argument). So
#                         with n w = r and w <= 1, |S - D| <= r (2 big w + eps): the Riemann sums of sinh tend to
#                         cosh r - 1 as the mesh w and eps shrink, and the disk's area (2 pi times them, the circumference
#                         being 2 pi sinh r) is 2 pi (cosh r - 1);
#   THE SWEPT AREA        the area swept from O along a geodesic is DEFINED as the integral over theta of cosh r - 1, the
#                         polar form of area (the disk theorem per unit of angle). Its increment over [theta, theta +
#                         dth], on a stretch where cosh r runs from ch to ch + dch, is a limit of Riemann sums each within
#                         [(ch - 1) dth, (ch + dch - 1) dth] (integral/angle, a-riemann-sum-lies-between-its-ends, with the
#                         integrand cosh r - 1 increasing along the stretch), which is space/hyperbolic/polar's squeeze.
#
# Every certificate is the product prover's, replayed (check/product.ts), over an ordered field.


# THE DISK. With q = big w, the step error is tol = q w + q w^2 + delta (big w^2 + big w^3 + delta), and over n strips
# with n w = r it sums to n tol = q r + q r w + n delta.
rule the-step-errors-sum
  seat n, like integer
  seat w, like integer
  seat r, like integer
  seat q, like integer
  seat delta, like integer
  seat tol, like integer
  have tol-is-the-step-error
    call is-equal
      read tol
      call add
        call add
          call multiply
            read q
            read w
          call multiply
            call multiply
              read q
              read w
            read w
        read delta
  have the-strips-cover-the-radius
    call is-equal
      call multiply
        read n
        read w
      read r
  show hold
    call is-equal
      call multiply
        read n
        read tol
      call add
        call add
          call multiply
            read q
            read r
          call multiply
            call multiply
              read q
              read r
            read w
        call multiply
          read n
          read delta


# The exponential's errors, each delta <= eps w (integral/limits), sum to n delta <= eps r.
rule the-exponential-errors-sum-to-eps-r
  seat n, like integer
  seat w, like integer
  seat r, like integer
  seat delta, like integer
  seat eps, like integer
  have delta-is-small
    call is-maximum
      read delta
      call multiply
        read eps
        read w
  have n-is-a-count
    call is-minimum
      read n
      code 0
  have the-strips-cover-the-radius
    call is-equal
      call multiply
        read n
        read w
      read r
  show hold
    call is-maximum
      call multiply
        read n
        read delta
      call multiply
        read eps
        read r


# The mesh errors q r + q r w are at most 2 p, p = q r = big w r, as w <= 1.
rule the-mesh-errors-sum-to-twice-big-w-r
  seat q, like integer
  seat r, like integer
  seat w, like integer
  seat p, like integer
  have p-is-q-times-the-radius
    meet and
      call is-equal
        read p
        call multiply
          read q
          read r
      call is-minimum
        read p
        code 0
  have the-mesh-is-at-most-one
    meet and
      call is-minimum
        read w
        code 0
      call is-maximum
        read w
        code 1
  show hold
    call is-maximum
      call add
        call multiply
          read q
          read r
        call multiply
          call multiply
            read q
            read r
          read w
      call multiply
        code 2
        read p


# So the Riemann sum S of sinh_N, within n tol of D = cosh_N(r) - 1, is within 2 big w r + eps r of it: the error tends
# to 0 with the mesh w and the tolerance eps.
rule the-disk-area-within-an-error
  seat ss, like integer
  seat dd, like integer
  seat nt, like integer
  seat q, like integer
  seat r, like integer
  seat w, like integer
  seat nd, like integer
  seat eps, like integer
  seat p, like integer
  have the-sums-are-within-n-tol
    meet and
      call is-maximum
        call subtract
          read ss
          read dd
        read nt
      call is-maximum
        call subtract
          code 0
          call subtract
            read ss
            read dd
        read nt
  have the-step-errors-sum
    call is-equal
      read nt
      call add
        call add
          call multiply
            read q
            read r
          call multiply
            call multiply
              read q
              read r
            read w
        read nd
  have the-exponential-errors-sum
    call is-maximum
      read nd
      call multiply
        read eps
        read r
  have the-mesh-errors-sum
    call is-maximum
      call add
        call multiply
          read q
          read r
        call multiply
          call multiply
            read q
            read r
          read w
      call multiply
        code 2
        read p
  show hold
    meet and
      call is-maximum
        call subtract
          read ss
          read dd
        call add
          call multiply
            code 2
            read p
          call multiply
            read eps
            read r
      call is-maximum
        call subtract
          code 0
          call subtract
            read ss
            read dd
        call add
          call multiply
            code 2
            read p
          call multiply
            read eps
            read r


# THE SAME, COMPOSED: from the per-step facts alone, citing the three rules above rather than assuming what they prove.
# Each citation proves the cited rule's hypotheses here and uses its conclusion, at this rule's n, w, r, q, delta, tol,
# eps and p (a cited rule's marks are read by name).
rule the-disk-area-from-the-steps
  seat ss, like integer
  seat dd, like integer
  seat n, like integer
  seat w, like integer
  seat r, like integer
  seat q, like integer
  seat delta, like integer
  seat tol, like integer
  seat eps, like integer
  seat p, like integer
  have the-sums-are-within-n-tol
    meet and
      call is-maximum
        call subtract
          read ss
          read dd
        call multiply
          read n
          read tol
      call is-maximum
        call subtract
          code 0
          call subtract
            read ss
            read dd
        call multiply
          read n
          read tol
  have tol-is-the-step-error
    call is-equal
      read tol
      call add
        call add
          call multiply
            read q
            read w
          call multiply
            call multiply
              read q
              read w
            read w
        read delta
  have the-strips-cover-the-radius
    call is-equal
      call multiply
        read n
        read w
      read r
  have delta-is-small
    call is-maximum
      read delta
      call multiply
        read eps
        read w
  have n-is-a-count
    call is-minimum
      read n
      code 0
  have p-is-q-times-the-radius
    meet and
      call is-equal
        read p
        call multiply
          read q
          read r
      call is-minimum
        read p
        code 0
  have the-mesh-is-at-most-one
    meet and
      call is-minimum
        read w
        code 0
      call is-maximum
        read w
        code 1
  show hold
    meet and
      call is-maximum
        call subtract
          read ss
          read dd
        call add
          call multiply
            code 2
            read p
          call multiply
            read eps
            read r
      call is-maximum
        call subtract
          code 0
          call subtract
            read ss
            read dd
        call add
          call multiply
            code 2
            read p
          call multiply
            read eps
            read r
  cite the-step-errors-sum
  cite the-exponential-errors-sum-to-eps-r
  cite the-mesh-errors-sum-to-twice-big-w-r


# THE SWEPT AREA: a Riemann sum of g = cosh r - 1 over m strips of width w covering dth = m w, with every value of g in
# [ch - 1, ch + dch - 1], lies in [(ch - 1) dth, (ch + dch - 1) dth]: a-riemann-sum-lies-between-its-ends at
# fa = ch + dch - 1 and fb = ch - 1, for an increasing integrand.
rule the-swept-area-sum-is-squeezed
  seat sm, like integer
  seat m, like integer
  seat w, like integer
  seat dth, like integer
  seat ch, like integer
  seat dch, like integer
  have the-riemann-sum-bound
    meet and
      call is-maximum
        read sm
        call multiply
          call multiply
            read m
            read w
          call subtract
            call add
              read ch
              read dch
            code 1
      call is-minimum
        read sm
        call multiply
          call multiply
            read m
            read w
          call subtract
            read ch
            code 1
  have the-strips-cover-the-angle
    call is-equal
      call multiply
        read m
        read w
      read dth
  show hold
    meet and
      call is-maximum
        read sm
        call multiply
          call subtract
            call add
              read ch
              read dch
            code 1
          read dth
      call is-minimum
        read sm
        call multiply
          call subtract
            read ch
            code 1
          read dth
