# RADIAN MEASURE, as the integral of 1 / (1 + s^2): the angle whose tangent is t is
#   theta(t) = integral from 0 to t of f,   f(s) = 1 / (1 + s^2),
# the arctangent, built from Riemann sums with no series and no trigonometric function assumed. Every bound is a
# polynomial inequality once the reciprocal is named (f (1 + s^2) = 1), so the product prover decides each step.
#
#   THE INTEGRAND FALLS   on s >= 0, f(s + h) <= f(s), and slowly: f(s) - f(s + h) <= (2 s + h) h;
#   THE SUMS SQUEEZE      for a falling f on the grid pt(i + 1) = pt(i) + w, the upper sum (left points) minus the
#                         lower sum (right points) telescopes to (f(pt(0)) - f(pt(n))) w, which tends to 0 with w;
#   REFINEMENT            halving the mesh raises the lower sum and lowers the upper one, so the sums at meshes
#                         w / 2^k are nested intervals, and number/completeness makes their limit a real: theta;
#   THE INCREMENT         every Riemann sum over [t, t + h] lies in [h f(t + h), h f(t)], so the limit does;
#   THE DERIVATIVE        so |theta(t + h) - theta(t) - f(t) h| <= (2 t + h) h^2: theta is uniformly differentiable
#                         with derivative f on every [0, R], the hypothesis integral/fundamental's area-equals-defect
#                         takes of the polar angle.
#
# Every certificate is the product prover's, replayed (check/product.ts), over an ordered field.


# THE INTEGRAND FALLS: with f1 (1 + s^2) = 1 and f2 (1 + (s + h)^2) = 1, f1 - f2 = f1 f2 (2 s h + h^2).
rule the-integrand-difference
  mark s, like integer
  mark h, like integer
  mark f1, like integer
  mark f2, like integer
  have f1-inverts
    call is-equal
      call multiply
        read f1
        call add
          code 1
          call multiply
            read s
            read s
      code 1
  have f2-inverts
    call is-equal
      call multiply
        read f2
        call add
          code 1
          call multiply
            call add
              read s
              read h
            call add
              read s
              read h
      code 1
  show hold
    call is-equal
      call subtract
        read f1
        read f2
      call multiply
        call multiply
          read f1
          read f2
        call add
          call multiply
            call multiply
              code 2
              read s
            read h
          call multiply
            read h
            read h


# The factor 2 s h + h^2 is not negative on s, h >= 0.
rule the-growth-is-not-negative
  mark s, like integer
  mark h, like integer
  mark g, like integer
  have g-is-the-growth
    call is-equal
      read g
      call add
        call multiply
          call multiply
            code 2
            read s
          read h
        call multiply
          read h
          read h
  have s-and-h-are-not-negative
    meet and
      call is-minimum
        read s
        code 0
      call is-minimum
        read h
        code 0
  show hold
    call is-minimum
      read g
      code 0


# So, with pp = f1 f2 > 0 and g = 2 s h + h^2 >= 0, f2 <= f1.
rule the-integrand-falls
  mark f1, like integer
  mark f2, like integer
  mark pp, like integer
  mark g, like integer
  have the-integrand-difference
    call is-equal
      call subtract
        read f1
        read f2
      call multiply
        read pp
        read g
  have pp-is-positive
    call is-above
      read pp
      code 0
  have g-is-not-negative
    call is-minimum
      read g
      code 0
  show hold
    call is-maximum
      read f2
      read f1


# and 0 < f <= 1.
rule the-integrand-is-at-most-one
  mark s, like integer
  mark f1, like integer
  have f1-inverts
    call is-equal
      call multiply
        read f1
        call add
          code 1
          call multiply
            read s
            read s
      code 1
  have f1-is-positive
    call is-above
      read f1
      code 0
  show hold
    call is-maximum
      read f1
      code 1


# and their product pp = f1 f2 is in (0, 1].
rule the-product-of-two-integrands-is-at-most-one
  mark f1, like integer
  mark f2, like integer
  mark pp, like integer
  have pp-is-the-product
    call is-equal
      read pp
      call multiply
        read f1
        read f2
  have f1-is-in-the-unit-interval
    meet and
      call is-above
        read f1
        code 0
      call is-maximum
        read f1
        code 1
  have f2-is-in-the-unit-interval
    meet and
      call is-above
        read f2
        code 0
      call is-maximum
        read f2
        code 1
  show hold
    meet and
      call is-above
        read pp
        code 0
      call is-maximum
        read pp
        code 1


# so it falls slowly: f1 - f2 = pp g <= g = (2 s + h) h.
rule the-integrand-falls-slowly
  mark f1, like integer
  mark f2, like integer
  mark pp, like integer
  mark g, like integer
  have the-integrand-difference
    call is-equal
      call subtract
        read f1
        read f2
      call multiply
        read pp
        read g
  have pp-is-at-most-one
    meet and
      call is-above
        read pp
        code 0
      call is-maximum
        read pp
        code 1
  have g-is-not-negative
    call is-minimum
      read g
      code 0
  show hold
    call is-maximum
      call subtract
        read f1
        read f2
      read g


# THE SUMS SQUEEZE: with fl(i) = f(pt(i)), up(i + 1) = up(i) + fl(i) w and lo(i + 1) = lo(i) + fl(i + 1) w, from 0,
# differ by (fl(0) - fl(n)) w, by induction on n.
rule the-upper-sum-minus-the-lower-sum-telescopes
  mark fl
    like task
      take a0, like integer
      like integer
  mark up
    like task
      take a0, like integer
      like integer
  mark lo
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark w, like integer
  have up-starts-at-zero
    call is-equal
      call up
        code 0
      code 0
  have lo-starts-at-zero
    call is-equal
      call lo
        code 0
      code 0
  have up-adds-a-left-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call up
          call add
            read i
            code 1
        call add
          call up
            read i
          call multiply
            call fl
              read i
            read w
  have lo-adds-a-right-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call lo
          call add
            read i
            code 1
        call add
          call lo
            read i
          call multiply
            call fl
              call add
                read i
                code 1
            read w
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-equal
      call subtract
        call up
          read n
        call lo
          read n
      call multiply
        call subtract
          call fl
            code 0
          call fl
            read n
        read w
  fold n


# REFINEMENT. At mesh w / 2 a sum adds f(q(j + 1)) w / 2 per strip (written doubled), so two half strips add
# (f(q(2 i + 1)) + f(q(2 i + 2))) w / 2.
rule two-half-strips-make-a-strip
  mark f
    like task
      take a0, like integer
      like integer
  mark q
    like task
      take a0, like integer
      like integer
  mark mm
    like task
      take a0, like integer
      like integer
  mark i, like integer
  mark w, like integer
  have mm-adds-a-half-strip
    mark j, like integer
    meet or
      call is-below
        read j
        code 0
      call is-equal
        call multiply
          code 2
          call mm
            call add
              read j
              code 1
        call add
          call multiply
            code 2
            call mm
              read j
          call multiply
            call f
              call q
                call add
                  read j
                  code 1
            read w
  have i-is-a-count
    call is-minimum
      read i
      code 0
  show hold
    call is-equal
      call multiply
        code 2
        call mm
          call add
            call multiply
              code 2
              read i
            code 2
      call add
        call multiply
          code 2
          call mm
            call multiply
              code 2
              read i
        call multiply
          call add
            call f
              call q
                call add
                  call multiply
                    code 2
                    read i
                  code 1
            call f
              call q
                call add
                  call multiply
                    code 2
                    read i
                  code 2
          read w


# A value of f at least another stays so times the width w >= 0.
rule a-falling-strip-scales
  mark fo, like integer
  mark fp, like integer
  mark w, like integer
  have fo-is-at-least-fp
    call is-minimum
      read fo
      read fp
  have the-width-is-not-negative
    call is-minimum
      read w
      code 0
  show hold
    call is-minimum
      call multiply
        read fo
        read w
      call multiply
        read fp
        read w


# Indexed by the coarse strip i: the lower sum ll at mesh w adds fp(i + 1) = f(p(i + 1)) w, and the refined sum
# mm(i) = the sum at mesh w / 2 up to q(2 i) adds (fo(i) + fe(i)) w / 2, with fo(i) = f(q(2 i + 1)) and
# fe(i) = f(q(2 i + 2)) = fp(i + 1), as q(2 i + 2) = p(i + 1), written in. As f falls, fp(i + 1) <= fo(i). So
# ll(n) <= mm(n), by induction on n. The fall enters as fo(i) w >= fp(i + 1) w (a-falling-strip-scales), so each step
# is linear.
rule halving-the-mesh-raises-the-lower-sum
  mark fp
    like task
      take a0, like integer
      like integer
  mark fo
    like task
      take a0, like integer
      like integer
  mark ll
    like task
      take a0, like integer
      like integer
  mark mm
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark w, like integer
  have ll-adds-a-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call ll
          call add
            read i
            code 1
        call add
          call ll
            read i
          call multiply
            call fp
              call add
                read i
                code 1
            read w
  have mm-adds-two-half-strips
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call multiply
          code 2
          call mm
            call add
              read i
              code 1
        call add
          call add
            call multiply
              code 2
              call mm
                read i
            call multiply
              call fo
                read i
              read w
          call multiply
            call fp
              call add
                read i
                code 1
            read w
  have the-odd-strip-is-at-least-the-right-end
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-minimum
        call multiply
          call fo
            read i
          read w
        call multiply
          call fp
            call add
              read i
              code 1
          read w
  have ll-starts-at-zero
    call is-equal
      call ll
        code 0
      code 0
  have mm-starts-at-zero
    call is-equal
      call mm
        code 0
      code 0
  have the-width-is-not-negative
    call is-minimum
      read w
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-maximum
      call ll
        read n
      call mm
        read n
  fold n


# and the upper sum uu (left points, fp(i)) is at least the refined upper sum vv, which adds (fp(i) + fo(i)) w / 2, as
# f(q(2 i)) = fp(i), with fo(i) w <= fp(i) w as f falls. By induction on n.
rule halving-the-mesh-lowers-the-upper-sum
  mark fp
    like task
      take a0, like integer
      like integer
  mark fo
    like task
      take a0, like integer
      like integer
  mark uu
    like task
      take a0, like integer
      like integer
  mark vv
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark w, like integer
  have uu-adds-a-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call uu
          call add
            read i
            code 1
        call add
          call uu
            read i
          call multiply
            call fp
              read i
            read w
  have vv-adds-two-half-strips
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call multiply
          code 2
          call vv
            call add
              read i
              code 1
        call add
          call add
            call multiply
              code 2
              call vv
                read i
            call multiply
              call fp
                read i
              read w
          call multiply
            call fo
              read i
            read w
  have the-odd-strip-is-at-most-the-left-end
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-maximum
        call multiply
          call fo
            read i
          read w
        call multiply
          call fp
            read i
          read w
  have uu-starts-at-zero
    call is-equal
      call uu
        code 0
      code 0
  have vv-starts-at-zero
    call is-equal
      call vv
        code 0
      code 0
  have the-width-is-not-negative
    call is-minimum
      read w
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-maximum
      call vv
        read n
      call uu
        read n
  fold n


# THE LIMIT: the lower sums lo(k) and upper sums up(k) at mesh w / 2^k are nested, lo rising, up falling, lo <= up.
# So for every j, lo(n) <= lo(n + j) <= up(n + j) <= up(n), by induction on j: the sums past n stay within the gap
# up(n) - lo(n) = (f(t) - f(t + h)) h / 2^n of each other, a regular sequence, and number/completeness gives its
# limit, theta(t + h) - theta(t).
rule the-refined-sums-are-nested
  mark lo
    like task
      take a0, like integer
      like integer
  mark up
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark j, like integer
  have lo-rises
    mark k, like integer
    meet or
      call is-below
        read k
        code 0
      call is-maximum
        call lo
          read k
        call lo
          call add
            read k
            code 1
  have up-falls
    mark k, like integer
    meet or
      call is-below
        read k
        code 0
      call is-maximum
        call up
          call add
            read k
            code 1
        call up
          read k
  have lo-is-below-up
    mark k, like integer
    meet or
      call is-below
        read k
        code 0
      call is-maximum
        call lo
          read k
        call up
          read k
  have n-is-a-count
    call is-minimum
      read n
      code 0
  have j-is-a-count
    call is-minimum
      read j
      code 0
  show hold
    meet and
      call is-maximum
        call lo
          read n
        call lo
          call add
            read n
            read j
      call is-maximum
        call lo
          call add
            read n
            read j
        call up
          call add
            read n
            read j
      call is-maximum
        call up
          call add
            read n
            read j
        call up
          read n
  fold j


# and REGULAR: with the gap (up(n) - lo(n)) p(n) = G, p(n) = 2^n >= n + 1, any later lower sum lo(m) is within G / n
# of lo(n). That is completeness.tree's regular sequence with modulus G / n, so its limit is a real.
rule the-refined-sums-are-regular
  mark n, like integer
  mark lon, like integer
  mark lom, like integer
  mark upn, like integer
  mark pn, like integer
  mark gg, like integer
  have the-sums-are-nested
    meet and
      call is-maximum
        read lon
        read lom
      call is-maximum
        read lom
        read upn
  have the-gap-halves
    call is-equal
      call multiply
        call subtract
          read upn
          read lon
        read pn
      read gg
  have the-power-passes-the-count
    call is-minimum
      read pn
      call add
        read n
        code 1
  have n-is-a-precision
    call is-minimum
      read n
      code 1
  show hold
    meet and
      call is-maximum
        call multiply
          read n
          call subtract
            read lom
            read lon
        read gg
      call is-minimum
        call multiply
          read n
          call subtract
            read lom
            read lon
        code 0


# THE INCREMENT: a Riemann sum of a falling f over the first n of m strips of [t, t + h], at any points q(i) in the
# strips, lies between n w f(t + h) and n w f(t), written fb and fa, by induction on n. At n = m, n w = h.
rule a-riemann-sum-lies-between-its-ends
  mark f
    like task
      take a0, like integer
      like integer
  mark q
    like task
      take a0, like integer
      like integer
  mark sum
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark m, like integer
  mark w, like integer
  mark fa, like integer
  mark fb, like integer
  have f-at-a-strip-point-is-within-the-ends
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-minimum
        read i
        read m
      meet and
        call is-maximum
          call f
            call q
              read i
          read fa
        call is-minimum
          call f
            call q
              read i
          read fb
  have the-sum-starts-at-zero
    call is-equal
      call sum
        code 0
      code 0
  have the-sum-adds-a-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call sum
          call add
            read i
            code 1
        call add
          call sum
            read i
          call multiply
            call f
              call q
                read i
            read w
  have the-width-is-not-negative
    call is-minimum
      read w
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  have n-is-within-the-strips
    call is-maximum
      read n
      read m
  show hold
    meet and
      call is-maximum
        call sum
          read n
        call multiply
          call multiply
            read n
            read w
          read fa
      call is-minimum
        call sum
          read n
        call multiply
          call multiply
            read n
            read w
          read fb
  fold n


# THE DERIVATIVE: an increment dt of theta over [t, t + h] within [h f2, h f1], with f1 - f2 <= (2 t + h) h, is
# f1 h up to (2 t + h) h^2.
rule the-angle-has-derivative-the-integrand
  mark t, like integer
  mark h, like integer
  mark f1, like integer
  mark f2, like integer
  mark dt, like integer
  have the-increment-is-squeezed
    meet and
      call is-maximum
        read dt
        call multiply
          read h
          read f1
      call is-minimum
        read dt
        call multiply
          read h
          read f2
  have the-integrand-falls-slowly
    meet and
      call is-maximum
        call subtract
          read f1
          read f2
        call multiply
          call add
            call multiply
              code 2
              read t
            read h
          read h
      call is-maximum
        read f2
        read f1
  have h-is-not-negative
    call is-minimum
      read h
      code 0
  show hold
    meet and
      call is-maximum
        call subtract
          read dt
          call multiply
            read f1
            read h
        call multiply
          call multiply
            call add
              call multiply
                code 2
                read t
              read h
            read h
          read h
      call is-maximum
        call subtract
          call multiply
            read f1
            read h
          read dt
        call multiply
          call multiply
            call add
              call multiply
                code 2
                read t
              read h
            read h
          read h
