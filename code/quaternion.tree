load @term/seed/algebra/cayley-dickson
  find cayley-dickson-double

load @term/seed/algebra/normed-division
  find normed-division-algebra

# The quaternions, the Cayley-Dickson double of the complex numbers, dimension four. A normed division algebra, still associative, but losing commutativity: the product of two quaternions depends on the order. This is the second loss of the tower. The unit quaternions of integer coordinates are the twenty-four points of the 24-cell, the binary tetrahedral group, which is why the directions of the substrate compose exactly and associatively.
form quaternion
  link source, like cayley-dickson-double
  link algebra, like normed-division-algebra

# The quaternions, proof-checked by `seed test`.

# Dimension four, the double of the complex plane: 4 = 2 * 2.
hold quaternions-have-dimension-four
  call is-equal
    code 4
    call multiply
      code 2
      code 2

# The norm is multiplicative for EVERY pair of quaternions, Euler's four-square identity: with q = a + b i + c j + d k
# and r = e + f i + g j + h k, the squared norm of the product equals the product of the squared norms. A universal
# law over all eight coordinates, proved by the commutative-ring normalizer.
rule quaternion-norm-is-multiplicative
  mark a, like integer
  mark b, like integer
  mark c, like integer
  mark d, like integer
  mark e, like integer
  mark f, like integer
  mark g, like integer
  mark h, like integer
  show hold
    call is-equal
      call multiply
        call add
          call add
            call add
              call multiply
                read a
                read a
              call multiply
                read b
                read b
            call multiply
              read c
              read c
          call multiply
            read d
            read d
        call add
          call add
            call add
              call multiply
                read e
                read e
              call multiply
                read f
                read f
            call multiply
              read g
              read g
          call multiply
            read h
            read h
      call add
        call add
          call add
            call multiply
              call subtract
                call subtract
                  call subtract
                    call multiply
                      read a
                      read e
                    call multiply
                      read b
                      read f
                  call multiply
                    read c
                    read g
                call multiply
                  read d
                  read h
              call subtract
                call subtract
                  call subtract
                    call multiply
                      read a
                      read e
                    call multiply
                      read b
                      read f
                  call multiply
                    read c
                    read g
                call multiply
                  read d
                  read h
            call multiply
              call subtract
                call add
                  call add
                    call multiply
                      read a
                      read f
                    call multiply
                      read b
                      read e
                  call multiply
                    read c
                    read h
                call multiply
                  read d
                  read g
              call subtract
                call add
                  call add
                    call multiply
                      read a
                      read f
                    call multiply
                      read b
                      read e
                  call multiply
                    read c
                    read h
                call multiply
                  read d
                  read g
          call multiply
            call add
              call add
                call subtract
                  call multiply
                    read a
                    read g
                  call multiply
                    read b
                    read h
                call multiply
                  read c
                  read e
              call multiply
                read d
                read f
            call add
              call add
                call subtract
                  call multiply
                    read a
                    read g
                  call multiply
                    read b
                    read h
                call multiply
                  read c
                  read e
              call multiply
                read d
                read f
        call multiply
          call add
            call subtract
              call add
                call multiply
                  read a
                  read h
                call multiply
                  read b
                  read g
              call multiply
                read c
                read f
            call multiply
              read d
