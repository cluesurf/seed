load @term/seed/code/structure/set
  find set

# Second-order logic: first-order logic extended to quantify over predicates and sets, not just individuals, so it can
# say "for all properties P". It is far more expressive (it pins down the natural numbers up to isomorphism) but loses
# completeness and compactness. The form carries the signature; quantification over relations is the added power.
form second-order-logic
  link symbols, like set
