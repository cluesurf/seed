load @term/seed/octonion
  find octonion

load @term/seed/algebra/cayley-dickson
  find cayley-dickson-double

# The sedenions, the Cayley-Dickson double of the octonions, dimension sixteen. They are the cliff. Because the octonions are not associative, doubling them loses the norm, so the sedenions are not a composition algebra and they have zero divisors, two nonzero sedenions whose product is zero. So reversibility fails here, which is why the reversible tower stops one rung below, at the octonions. This is the lower wall the pinch-point sits just above.
form sedenion
  link source, like cayley-dickson-double
  link base, like octonion

# The sedenions, proof-checked by `seed test`.

# Dimension sixteen, the double of the octonions: 16 = 2 * 8.
hold sedenions-have-dimension-sixteen
  call is-equal
    code 16
    call multiply
      code 2
      code 8

# Sixteen is past the reversible ceiling of eight, so the norm dies and zero divisors appear: reversibility fails here.
hold sedenions-lie-past-reversible-ceiling
  call is-above
    code 16
    code 8
