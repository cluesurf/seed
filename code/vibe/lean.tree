# The lean, the order on the tone: fear below calm below love. The field F3 (vibe/tone) has no order compatible with its
# addition, so the lean is extra structure, not something the residues carry: it is what reads a tone as a SIGNED value
# (-1 < 0 < +1) and gives creation its direction outward from calm toward the two poles.
#
# This file defines the order as a comparison and proves it is a total order (reflexive, antisymmetric, transitive,
# total), that charge conjugation REVERSES it, and that the residue addition does NOT respect it, so a signed count of
# vibes must be an integer (vibe/tone `balance`) and never a residue.

load @term/seed/atom/flag
  find flag
  find either

load @term/seed/vibe/law
  find order
  find involution

load @term/seed/vibe/tone
  find tone
  find tone-row
  find tone-sum
  find tone-conjugate

# at-most a b is yes when a sits no higher than b: fear < calm < love.
task at-most
  take a, like tone
  take b, like tone
  like flag
  fork case, read a
    fuse tone-row, fear, yes, yes, yes
    fuse tone-row, calm, no, yes, yes
    fuse tone-row, love, no, no, yes

fuse order, lean, tone, at-most

# C REVERSES THE ORDER: a <= b exactly when C b <= C a. Conjugation is antitone, so the two poles are mirror images
# about calm.
rule conjugation-reverses-the-lean
  mark a, like tone
  mark b, like tone
  show hold
    call is-equal
      call at-most
        read a
        read b
      call at-most
        call tone-conjugate
          read b
        call tone-conjugate
          read a
  fold a, b

# THE RESIDUE SUM IGNORES THE LEAN: calm <= love, yet calm + love = love is NOT at most love + love = fear. Adding the
# same tone to both sides can reverse the order, so the lean is not an order of the field.
rule the-residue-sum-breaks-the-lean
  show hold
    call is-equal
      call at-most
        call tone-sum
          make calm
          make love
        call tone-sum
          make love
          make love
      make no
  calm hold
