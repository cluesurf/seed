# The tone, one trit, the only kind of value the substrate holds. A slot holds fear (-1), calm (0) or love (+1). A slot
# holding love or fear holds a VIBE, and calm is the empty value. Read as residues modulo three, with fear standing for
# -1 = 2, the three tones are the field F3: they add and multiply, every nonzero tone has an inverse, and negation is
# charge conjugation C, which swaps love and fear and fixes calm.
#
# This file DEFINES the two operations by their tables and PROVES the field axioms over every tone, plus the facts the
# rest of the theory leans on: every vibe squares to love (so each is its own inverse), three of anything is calm
# (characteristic three), every tone is its own cube (Frobenius), and there are no zero divisors. It then models
# BALANCED TERNARY, the positional numeral the substrate counts in: a full adder whose carry and digit are tones, proved
# to satisfy a + b + c = 3 carry + digit as integers, for all twenty-seven inputs.
#
# Three is forced: the smallest alphabet with an empty value and a sign flip is {-1, 0, +1}, and the sign flip must be an
# order-two symmetry fixing the empty value, which is `tone-conjugate` below.

load @term/seed/code/atom/flag
  find flag
  find both
  find either

load @term/seed/code/vibe/law
  find associative
  find commutative
  find identity
  find inverse
  find distributive
  find involution
  find homomorphism

form tone
  case fear
  case calm
  case love

# TEMPLATE: one row of a two-argument table on tones, for a fixed first tone `row`, the result against each second tone.
tree tone-row
  take row
  take at-fear
  take at-calm
  take at-love

  hook fuse
    case {row}
      fork case, read b
        case fear
          send back
            make {at-fear}
        case calm
          send back
            make {at-calm}
        case love
          send back
            make {at-love}

# TEMPLATE: one entry of a one-argument map on tones.
tree tone-entry
  take from
  take to

  hook fuse
    case {from}
      send back
        make {to}

# Addition modulo three on the balanced residues: love + love = 2 = fear, fear + fear = -2 = love.
task tone-sum
  take a, like tone
  take b, like tone
  like tone
  fork case, read a
    fuse tone-row, fear, love, fear, calm
    fuse tone-row, calm, fear, calm, love
    fuse tone-row, love, calm, love, fear

# Multiplication modulo three: love is the unit, calm absorbs, fear negates.
task tone-product
  take a, like tone
  take b, like tone
  like tone
  fork case, read a
    fuse tone-row, fear, love, calm, fear
    fuse tone-row, calm, calm, calm, calm
    fuse tone-row, love, fear, calm, love

# Charge conjugation C: the additive inverse, love and fear swap, calm stays.
task tone-conjugate
  take a, like tone
  like tone
  fork case, read a
    fuse tone-entry, fear, love
    fuse tone-entry, calm, calm
    fuse tone-entry, love, fear

# a - b = a + C b.
task tone-difference
  take a, like tone
  take b, like tone
  like tone
  send back
    call tone-sum
      read a
      call tone-conjugate
        read b

# The two identities, as constants for the law kit.
task calm-tone
  like tone
  send back
    make calm

task love-tone
  like tone
  send back
    make love

# Is the tone a vibe (love or fear), rather than calm.
task is-vibe
  take a, like tone
  like flag
  fork case, read a
    fuse tone-entry, fear, yes
    fuse tone-entry, calm, no
    fuse tone-entry, love, yes

# Equality of tones, as a flag.
task same-tone
  take a, like tone
  take b, like tone
  like flag
  fork case, read a
    fuse tone-row, fear, yes, no, no
    fuse tone-row, calm, no, yes, no
    fuse tone-row, love, no, no, yes

# THE ADDITIVE GROUP: (tone, tone-sum, calm, tone-conjugate) is an abelian group.
fuse associative, tone-sum, tone, tone-sum
fuse commutative, tone-sum, tone, tone-sum
fuse identity, tone-sum, tone, tone-sum, calm-tone
fuse inverse, tone-sum, tone, tone-sum, tone-conjugate, calm-tone

# THE MULTIPLICATIVE MONOID, and the ring: tone-product is associative, commutative, has love as its unit, and
# distributes over tone-sum. With the field rules below, the tones are the field F3.
fuse associative, tone-product, tone, tone-product
fuse commutative, tone-product, tone, tone-product
fuse identity, tone-product, tone, tone-product, love-tone
fuse distributive, tone-product, tone, tone-product, tone-sum

# C is an involution, and an automorphism of the additive group: C (a + b) = C a + C b.
fuse involution, tone-conjugate, tone, tone-conjugate
fuse homomorphism, tone-conjugate, tone, tone-conjugate, tone-sum, tone-sum

# C is NEGATION: tone-conjugate a = fear a. Charge conjugation is multiplication by -1.
rule conjugate-is-multiplying-by-fear
  mark a, like tone
  show hold
    call is-equal
      call tone-conjugate
        read a
      call tone-product
        make fear
        read a
  fold a

# C passes through a product onto either factor: C (a b) = (C a) b. It is linear, not multiplicative.
rule conjugate-passes-through-a-product
  mark a, like tone
  mark b, like tone
  show hold
    call is-equal
      call tone-conjugate
        call tone-product
          read a
          read b
      call tone-product
        call tone-conjugate
          read a
        read b
  fold a, b

# THE FIELD: every vibe is a unit, its own inverse, because it squares to love. A vibe times itself is love, whatever its
# sign, which is why the charge of a pair of like vibes and of a love-fear pair differ only in sign.
rule every-vibe-squares-to-love
  mark a, like tone
  have vibe
    call is-equal
      call is-vibe
        read a
      make yes
  show hold
    call is-equal
      call tone-product
        read a
        read a
      make love
  fold a

# NO ZERO DIVISORS: if a b = calm then a = calm or b = calm.
rule a-product-is-calm-only-through-a-calm-factor
  mark a, like tone
  mark b, like tone
  have calm-product
    call is-equal
      call tone-product
        read a
        read b
      make calm
  show hold
    call is-equal
      call either
        call same-tone
          read a
          make calm
        call same-tone
          read b
          make calm
      make yes
  fold a, b

# CHARACTERISTIC THREE: a + a + a = calm for every tone.
rule three-of-a-tone-is-calm
  mark a, like tone
  show hold
    call is-equal
      call tone-sum
        call tone-sum
          read a
          read a
        read a
      make calm
  fold a

# FROBENIUS: every tone is its own cube, a a a = a, the identity x^3 = x that holds for every element of F3.
rule every-tone-is-its-own-cube
  mark a, like tone
  show hold
    call is-equal
      call tone-product
        call tone-product
          read a
          read a
        read a
      read a
  fold a

# NO SQUARE IS FEAR: a a is calm or love, never fear (-1 is not a square modulo three). This is the residue fact that
# makes two inert in the Eisenstein integers and keeps the qutrit symplectic form nondegenerate (vibe/eisenstein,
# vibe/role).
rule no-square-is-fear
  mark a, like tone
  show hold
    call is-equal
      call same-tone
        call tone-product
          read a
          read a
        make fear
      make no
  fold a

# A SUM OF TWO SQUARES IS CALM ONLY AT CALM: a a + b b = calm forces a = b = calm, since -1 is not a square.
rule two-squares-vanish-only-at-calm
  mark a, like tone
  mark b, like tone
  have calm-sum
    call is-equal
      call tone-sum
        call tone-product
          read a
          read a
        call tone-product
          read b
          read b
      make calm
  show hold
    call is-equal
      call both
        call same-tone
          read a
          make calm
        call same-tone
          read b
          make calm
      make yes
  fold a, b

# BALANCED TERNARY. A count from -4 to +4, wide enough for the sum of three tones and for 3 carry + digit.
form balance
  case minus-four
  case minus-three
  case minus-two
  case minus-one
  case even
  case plus-one
  case plus-two
  case plus-three
  case plus-four

# TEMPLATE: one row of the shift table: a balance moved down by one, kept, or moved up by one.
tree shift-row
  take row
  take down
  take up

  hook fuse
    case {row}
      fork case, read t
        case fear
          send back
            make {down}
        case calm
          send back
            make {row}
        case love
          send back
            make {up}

# Add a tone's integer value (-1, 0, +1) to a balance. The ends are never reached by the sums below and saturate.
task balance-shift
  take n, like balance
  take t, like tone
  like balance
  fork case, read n
    fuse shift-row, minus-four, minus-four, minus-three
    fuse shift-row, minus-three, minus-four, minus-two
    fuse shift-row, minus-two, minus-three, minus-one
    fuse shift-row, minus-one, minus-two, even
    fuse shift-row, even, minus-one, plus-one
    fuse shift-row, plus-one, even, plus-two
    fuse shift-row, plus-two, plus-one, plus-three
    fuse shift-row, plus-three, plus-two, plus-four
    fuse shift-row, plus-four, plus-three, plus-four

# The integer value of three tones added, as a balance from -3 to +3.
task total-of-three
  take a, like tone
  take b, like tone
  take c, like tone
  like balance
  send back
    call balance-shift
      call balance-shift
        call balance-shift
          make even
          read a
        read b
      read c

# The carry of a half adder: love + love overflows to (carry love, digit fear) since 1 + 1 = 3 - 1, fear + fear to
# (carry fear, digit love), and every other pair fits in one digit.
task half-carry
  take a, like tone
  take b, like tone
  like tone
  fork case, read a
    fuse tone-row, fear, fear, calm, calm
    fuse tone-row, calm, calm, calm, calm
    fuse tone-row, love, calm, calm, love

# The full adder: two half adders. Its digit is the residue sum, its carry the residue sum of the two half carries
# (they are never both the same vibe, so the carry stays one trit).
task full-digit
  take a, like tone
  take b, like tone
  take c, like tone
  like tone
  send back
    call tone-sum
      call tone-sum
        read a
        read b
      read c

task full-carry
  take a, like tone
  take b, like tone
  take c, like tone
  like tone
  send back
    call tone-sum
      call half-carry
        read a
        read b
      call half-carry
        call tone-sum
          read a
          read b
        read c

# THE CARRY LAW: a + b + c = 3 carry + digit, as integers, for all twenty-seven triples of tones. Three times the carry
# is the carry shifted three times, then the digit is added. Balanced ternary addition is exact with one-trit carries.
rule the-full-adder-is-exact
  mark a, like tone
  mark b, like tone
  mark c, like tone
  show hold
    call is-equal
      call total-of-three
        read a
        read b
        read c
      call balance-shift
        call total-of-three
          call full-carry
            read a
            read b
            read c
          call full-carry
            read a
            read b
            read c
          call full-carry
            read a
            read b
            read c
        call full-digit
          read a
          read b
          read c
  fold a, b, c
