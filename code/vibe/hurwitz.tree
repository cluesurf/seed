# The 24 Hurwitz units, the binary tetrahedral group 2T: +-1, +-i, +-j, +-k and the sixteen 1/2(+-1 +-i +-j +-k). They
# are the dock's 24 slots read as quaternions (vibe/dock), and the group they form under quaternion multiplication is
# the symmetry that turns the dock.
#
# This file BUILDS 2T from its structure rather than from a 576-entry table. The quaternion group Q8 = {+-1, +-i, +-j,
# +-k} is a normal subgroup, and w = 1/2(-1 + i + j + k) has order three and turns the axes by conjugation:
# w i w^-1 = k, w k w^-1 = j, w j w^-1 = i. Every unit is q w^t for one q in Q8 and one turn t in Z3, and
#
#   (q w^t)(r w^s) = q (w^t r w^-t) w^(t+s),
#
# so 2T = Q8 x| Z3, with the turn read as a tone (calm 0, love 1, fear 2). The file proves Q8 a group and the turn an
# automorphism of it of order three, then proves 2T a group and the facts the theory uses: -1 is central and is the
# only element of order two (a 2 pi turn), the center is exactly {1, -1}, the turn is a homomorphism onto Z3 whose
# kernel Q8 cuts the dock into its three FRAMES, left multiplication by w cycles the frames, and every element has order
# dividing 12.
#
# It then CHECKS THE MODEL AGAINST THE QUATERNIONS. Each element gets its four coordinates in {-1, -1/2, 0, 1/2, 1}, the
# 24 coordinate vectors are distinct unit vectors, and the relations that define the semidirect product (i^2 = j^2 =
# k^2 = ijk = -1, w^3 = 1, and the three conjugations) are verified with the Hamilton product over the integers, which
# is also proved associative and norm-multiplicative for all integer quaternions. So the group built here is the
# subgroup of the quaternions generated by i, j and w, and it has 24 elements.

load @term/seed/atom/flag
  find flag
  find both
  find either

load @term/seed/atom/sign
  find sign
  find flip-sign
  find same-sign

load @term/seed/vibe/law
  find associative
  find identity
  find inverse
  find homomorphism

load @term/seed/vibe/tone
  find tone
  find tone-sum
  find tone-conjugate
  find same-tone
  find calm-tone

# THE QUATERNION GROUP Q8.

form hurwitz-axis
  case real-axis
  case i-axis
  case j-axis
  case k-axis

form q8
  case signed
    link sign, like sign
    link axis, like hurwitz-axis

task q8-of
  take sign, like sign
  take axis, like hurwitz-axis
  like q8
  send back
    make signed
      bind sign
        read sign
      bind axis
        read axis

task q8-sign
  take q, like q8
  like sign
  fork case, read q
    case signed
      send back
        read sign

task q8-axis
  take q, like q8
  like hurwitz-axis
  fork case, read q
    case signed
      send back
        read axis

task sign-times
  take a, like sign
  take b, like sign
  like sign
  fork case, read a
    case positive
      send back
        read b
    case negative
      send back
        call flip-sign
          read b

# TEMPLATE: one row of the axis product, the signed unit e_row e_col against each column.
tree axis-row
  take row
  take real-s
  take real-a
  take i-s
  take i-a
  take j-s
  take j-a
  take k-s
  take k-a

  hook fuse
    case {row}
      fork case, read b
        case real-axis
          send back
            call q8-of
              make {real-s}
              make {real-a}
        case i-axis
          send back
            call q8-of
              make {i-s}
              make {i-a}
        case j-axis
          send back
            call q8-of
              make {j-s}
              make {j-a}
        case k-axis
          send back
            call q8-of
              make {k-s}
              make {k-a}

# Hamilton's table: i^2 = j^2 = k^2 = -1, ij = k, jk = i, ki = j, and reversing a product flips its sign.
task axis-product
  take a, like hurwitz-axis
  take b, like hurwitz-axis
  like q8
  fork case, read a
    fuse axis-row, real-axis, positive, real-axis, positive, i-axis, positive, j-axis, positive, k-axis
    fuse axis-row, i-axis, positive, i-axis, negative, real-axis, positive, k-axis, negative, j-axis
    fuse axis-row, j-axis, positive, j-axis, negative, k-axis, negative, real-axis, positive, i-axis
    fuse axis-row, k-axis, positive, k-axis, positive, j-axis, negative, i-axis, negative, real-axis

task q8-product
  take x, like q8
  take y, like q8
  like q8
  send back
    call q8-of
      call sign-times
        call sign-times
          call q8-sign
            read x
          call q8-sign
            read y
        call q8-sign
          call axis-product
            call q8-axis
              read x
            call q8-axis
              read y
      call q8-axis
        call axis-product
          call q8-axis
            read x
          call q8-axis
            read y

# The inverse: the real units are their own inverses, an imaginary unit's inverse is its negative.
task q8-inverse
  take q, like q8
  like q8
  fork case, read q
    case signed
      fork case, read axis
        case real-axis
          send back
            read q
        case i-axis
          send back
            call q8-of
              call flip-sign
                read sign
              make i-axis
        case j-axis
          send back
            call q8-of
              call flip-sign
                read sign
              make j-axis
        case k-axis
          send back
            call q8-of
              call flip-sign
                read sign
              make k-axis

task q8-unit
  like q8
  send back
    call q8-of
      make positive
      make real-axis

fuse associative, q8-product, q8, q8-product
fuse identity, q8-product, q8, q8-product, q8-unit
fuse inverse, q8-product, q8, q8-product, q8-inverse, q8-unit

# THE TURN, conjugation by w: i -> k -> j -> i, the real axis and the sign kept.
task turn-axis
  take a, like hurwitz-axis
  like hurwitz-axis
  fork case, read a
    case real-axis
      send back
        make real-axis
    case i-axis
      send back
        make k-axis
    case j-axis
      send back
        make i-axis
    case k-axis
      send back
        make j-axis

task q8-turn
  take q, like q8
  like q8
  send back
    call q8-of
      call q8-sign
        read q
      call turn-axis
        call q8-axis
          read q

# The turn applied t times, t a residue modulo three.
task q8-turn-by
  take t, like tone
  take q, like q8
  like q8
  fork case, read t
    case calm
      send back
        read q
    case love
      send back
        call q8-turn
          read q
    case fear
      send back
        call q8-turn
          call q8-turn
            read q

# THE TURN IS AN AUTOMORPHISM OF Q8 OF ORDER THREE.
fuse homomorphism, q8-turn, q8, q8-turn, q8-product, q8-product

rule the-turn-has-order-three
  seat q, like q8
  show hold
    call is-equal
      call q8-turn
        call q8-turn
          call q8-turn
            read q
      read q
  fold q

# Turning by s then by t is turning by s + t: the turns are an action of Z3 on Q8.
rule turns-compose-by-adding
  seat s, like tone
  seat t, like tone
  seat q, like q8
  show hold
    call is-equal
      call q8-turn-by
        read t
        call q8-turn-by
          read s
          read q
      call q8-turn-by
        call tone-sum
          read t
          read s
        read q
  fold s, t, q

# THE BINARY TETRAHEDRAL GROUP 2T = Q8 x| Z3: an element q w^t.

form hurwitz-element
  case unit-of
    link core, like q8
    link turn, like tone

task hurwitz-of
  take core, like q8
  take turn, like tone
  like hurwitz-element
  send back
    make unit-of
      bind core
        read core
      bind turn
        read turn

task hurwitz-core
  take g, like hurwitz-element
  like q8
  fork case, read g
    case unit-of
      send back
        read core

task hurwitz-turn
  take g, like hurwitz-element
  like tone
  fork case, read g
    case unit-of
      send back
        read turn

# (q w^t)(r w^s) = (q . w^t r w^-t) w^(t + s).
task hurwitz-product
  take g, like hurwitz-element
  take h, like hurwitz-element
  like hurwitz-element
  send back
    call hurwitz-of
      call q8-product
        call hurwitz-core
          read g
        call q8-turn-by
          call hurwitz-turn
            read g
          call hurwitz-core
            read h
      call tone-sum
        call hurwitz-turn
          read g
        call hurwitz-turn
          read h

# (q w^t)^-1 = w^-t q^-1 = (w^-t q^-1 w^t) w^-t.
task hurwitz-inverse
  take g, like hurwitz-element
  like hurwitz-element
  send back
    call hurwitz-of
      call q8-turn-by
        call tone-conjugate
          call hurwitz-turn
            read g
        call q8-inverse
          call hurwitz-core
            read g
      call tone-conjugate
        call hurwitz-turn
          read g

task hurwitz-unit
  like hurwitz-element
  send back
    call hurwitz-of
      call q8-unit
      make calm

fuse associative, hurwitz-product, hurwitz-element, hurwitz-product
fuse identity, hurwitz-product, hurwitz-element, hurwitz-product, hurwitz-unit
fuse inverse, hurwitz-product, hurwitz-element, hurwitz-product, hurwitz-inverse, hurwitz-unit

# Named elements.
task minus-one-unit
  like hurwitz-element
  send back
    call hurwitz-of
      call q8-of
        make negative
        make real-axis
      make calm

task unit-i
  like hurwitz-element
  send back
    call hurwitz-of
      call q8-of
        make positive
        make i-axis
      make calm

task unit-omega
  like hurwitz-element
  send back
    call hurwitz-of
      call q8-unit
      make love

task same-q8
  take x, like q8
  take y, like q8
  like flag
  send back
    call both
      call same-sign
        call q8-sign
          read x
        call q8-sign
          read y
      call same-axis
        call q8-axis
          read x
        call q8-axis
          read y

task same-axis
  take a, like hurwitz-axis
  take b, like hurwitz-axis
  like flag
  fork case, read a
    case real-axis
      fork case, read b
        case real-axis
          send back
            make yes
        case i-axis
          send back
            make no
        case j-axis
          send back
            make no
        case k-axis
          send back
            make no
    case i-axis
      fork case, read b
        case real-axis
          send back
            make no
        case i-axis
          send back
            make yes
        case j-axis
          send back
            make no
        case k-axis
          send back
            make no
    case j-axis
      fork case, read b
        case real-axis
          send back
            make no
        case i-axis
          send back
            make no
        case j-axis
          send back
            make yes
        case k-axis
          send back
            make no
    case k-axis
      fork case, read b
        case real-axis
          send back
            make no
        case i-axis
          send back
            make no
        case j-axis
          send back
            make no
        case k-axis
          send back
            make yes

task same-hurwitz
  take g, like hurwitz-element
  take h, like hurwitz-element
  like flag
  send back
    call both
      call same-q8
        call hurwitz-core
          read g
        call hurwitz-core
          read h
      call same-tone
        call hurwitz-turn
          read g
        call hurwitz-turn
          read h

# Is the element +-1: a real core and no turn.
task is-plus-or-minus-one
  take g, like hurwitz-element
  like flag
  send back
    call both
      call same-axis
        call q8-axis
          call hurwitz-core
            read g
        make real-axis
      call same-tone
        call hurwitz-turn
          read g
        make calm

# W HAS ORDER THREE: w w w = 1, and w is not 1.
rule omega-cubed-is-the-identity
  show hold
    call is-equal
      call hurwitz-product
        call hurwitz-product
          call unit-omega
          call unit-omega
        call unit-omega
      call hurwitz-unit
  calm hold

# -1 IS CENTRAL: it commutes with every unit.
rule minus-one-is-central
  seat g, like hurwitz-element
  show hold
    call is-equal
      call hurwitz-product
        call minus-one-unit
        read g
      call hurwitz-product
        read g
        call minus-one-unit
  fold g

# THE CENTER IS EXACTLY {1, -1}: a unit that commutes with i and with w is +-1.
rule the-center-is-plus-or-minus-one
  seat g, like hurwitz-element
  have with-i
    call is-equal
      call hurwitz-product
        read g
        call unit-i
      call hurwitz-product
        call unit-i
        read g
  have with-omega
    call is-equal
      call hurwitz-product
        read g
        call unit-omega
      call hurwitz-product
        call unit-omega
        read g
  show hold
    call is-equal
      call is-plus-or-minus-one
        read g
      make yes
  fold g

# THE 2 PI TURN: the only units that square to 1 are 1 and -1. So -1 is the unique element of order two, the image of
# a full turn of space, and a vibe that is a doublet of 2T changes sign under it.
rule only-plus-or-minus-one-square-to-one
  seat g, like hurwitz-element
  have square
    call is-equal
      call same-hurwitz
        call hurwitz-product
          read g
          read g
        call hurwitz-unit
      make yes
  show hold
    call is-equal
      call is-plus-or-minus-one
        read g
      make yes
  fold g

# i squares to -1, so i has order four.
rule i-squared-is-minus-one
  show hold
    call is-equal
      call hurwitz-product
        call unit-i
        call unit-i
      call minus-one-unit
  calm hold

# THE ORDERS. A unit of the first frame (Q8) has order dividing 4, a unit of the other two frames order dividing 6, so
# every unit has order dividing 12. (Counted out, the orders are 1 once, 2 once, 4 six times, 3 eight times and 6
# eight times: the identity, -1, the six imaginary units, and the sixteen halves split by the sign of the real part.)
task hurwitz-square
  take g, like hurwitz-element
  like hurwitz-element
  send back
    call hurwitz-product
      read g
      read g

task hurwitz-cube
  take g, like hurwitz-element
  like hurwitz-element
  send back
    call hurwitz-product
      call hurwitz-square
        read g
      read g

rule a-unit-of-the-first-frame-has-order-dividing-four
  seat q, like q8
  show hold
    call is-equal
      call hurwitz-square
        call hurwitz-square
          call hurwitz-of
            read q
            make calm
      call hurwitz-unit
  fold q

rule a-turned-unit-has-order-dividing-six
  seat q, like q8
  seat t, like tone
  have turned
    call is-equal
      call same-tone
        read t
        make calm
      make no
  show hold
    call is-equal
      call hurwitz-square
        call hurwitz-cube
          call hurwitz-of
            read q
            read t
      call hurwitz-unit
  fold q, t

# THE FRAMES. The turn is a homomorphism of 2T onto Z3. Its kernel, the units with no turn, is Q8, the first frame
# (the 16-cell of the slots +-e1 +-e2, +-e3 +-e4), and its two cosets are the other two frames.
fuse homomorphism, hurwitz-turn, hurwitz-element, hurwitz-turn, hurwitz-product, tone-sum

# Q8 IS NORMAL: conjugating a unit with no turn gives a unit with no turn.
rule the-first-frame-is-a-normal-subgroup
  seat g, like hurwitz-element
  seat q, like q8
  show hold
    call is-equal
      call hurwitz-turn
        call hurwitz-product
          call hurwitz-product
            read g
            call hurwitz-of
              read q
              make calm
          call hurwitz-inverse
            read g
      make calm
  fold g, q

# LEFT MULTIPLICATION BY w CYCLES THE FRAMES: the frame of w g is the frame of g advanced by one.
rule omega-cycles-the-frames
  seat g, like hurwitz-element
  show hold
    call is-equal
      call hurwitz-turn
        call hurwitz-product
          call unit-omega
          read g
      call tone-sum
        make love
        call hurwitz-turn
          read g
  fold g

# THE QUATERNION COORDINATES. A coordinate of a Hurwitz unit is one of -1, -1/2, 0, 1/2, 1.
form half
  case minus-whole
  case minus-half
  case naught
  case plus-half
  case plus-whole

task half-negate
  take a, like half
  like half
  fork case, read a
    case minus-whole
      send back
        make plus-whole
    case minus-half
      send back
        make plus-half
    case naught
      send back
        make naught
    case plus-half
      send back
        make minus-half
    case plus-whole
      send back
        make minus-whole

form quaternion-point
  case coordinates
    link r, like half
    link i, like half
    link j, like half
    link k, like half

task point-of
  take r, like half
  take i, like half
  take j, like half
  take k, like half
  like quaternion-point
  send back
    make coordinates
      bind r
        read r
      bind i
        read i
      bind j
        read j
      bind k
        read k

# 1, w = 1/2(-1 + i + j + k) and w^2 = w^-1 = 1/2(-1 - i - j - k).
task omega-power-point
  take t, like tone
  like quaternion-point
  fork case, read t
    case calm
      send back
        call point-of
          make plus-whole
          make naught
          make naught
          make naught
    case love
      send back
        call point-of
          make minus-half
          make plus-half
          make plus-half
          make plus-half
    case fear
      send back
        call point-of
          make minus-half
          make minus-half
          make minus-half
          make minus-half

# Left multiplication by a unit of Q8 on coordinates (a, b, c, d) = a + b i + c j + d k:
#   i q = (-b, a, -d, c),  j q = (-c, d, a, -b),  k q = (-d, -c, b, a),  and -q negates every coordinate.
task axis-times-point
  take a, like hurwitz-axis
  take p, like quaternion-point
  like quaternion-point
  fork case, read p
    case coordinates
      fork case, read a
        case real-axis
          send back
            read p
        case i-axis
          send back
            call point-of
              call half-negate
                read i
              read r
              call half-negate
                read k
              read j
        case j-axis
          send back
            call point-of
              call half-negate
                read j
              read k
              read r
              call half-negate
                read i
        case k-axis
          send back
            call point-of
              call half-negate
                read k
              call half-negate
                read j
              read i
              read r

task sign-times-point
  take s, like sign
  take p, like quaternion-point
  like quaternion-point
  fork case, read s
    case positive
      send back
        read p
    case negative
      fork case, read p
        case coordinates
          send back
            call point-of
              call half-negate
                read r
              call half-negate
                read i
              call half-negate
                read j
              call half-negate
                read k

# The coordinates of q w^t: the point of w^t, multiplied on the left by q.
task hurwitz-point
  take g, like hurwitz-element
  like quaternion-point
  send back
    call sign-times-point
      call q8-sign
        call hurwitz-core
          read g
      call axis-times-point
        call q8-axis
          call hurwitz-core
            read g
        call omega-power-point
          call hurwitz-turn
            read g

task same-half
  take a, like half
  take b, like half
  like flag
  fork case, read a
    case minus-whole
      fork case, read b
        case minus-whole
          send back
            make yes
        case minus-half
          send back
            make no
        case naught
          send back
            make no
        case plus-half
          send back
            make no
        case plus-whole
          send back
            make no
    case minus-half
      fork case, read b
        case minus-whole
          send back
            make no
        case minus-half
          send back
            make yes
        case naught
          send back
            make no
        case plus-half
          send back
            make no
        case plus-whole
          send back
            make no
    case naught
      fork case, read b
        case minus-whole
          send back
            make no
        case minus-half
          send back
            make no
        case naught
          send back
            make yes
        case plus-half
          send back
            make no
        case plus-whole
          send back
            make no
    case plus-half
      fork case, read b
        case minus-whole
          send back
            make no
        case minus-half
          send back
            make no
        case naught
          send back
            make no
        case plus-half
          send back
            make yes
        case plus-whole
          send back
            make no
    case plus-whole
      fork case, read b
        case minus-whole
          send back
            make no
        case minus-half
          send back
            make no
        case naught
          send back
            make no
        case plus-half
          send back
            make no
        case plus-whole
          send back
            make yes

task same-point
  take p, like quaternion-point
  take q, like quaternion-point
  like flag
  fork case, read p
    case coordinates
      link pr
      link pi
      link pj
      link pk
      fork case, read q
        case coordinates
          link qr
          link qi
          link qj
          link qk
          send back
            call both
              call both
                call same-half
                  read pr
                  read qr
                call same-half
                  read pi
                  read qi
              call both
                call same-half
                  read pj
                  read qj
                call same-half
                  read pk
                  read qk

# THE 24 COORDINATE VECTORS ARE DISTINCT: two units with the same coordinates are the same unit.
rule distinct-units-have-distinct-coordinates
  seat g, like hurwitz-element
  seat h, like hurwitz-element
  have same
    call is-equal
      call same-point
        call hurwitz-point
          read g
        call hurwitz-point
          read h
      make yes
  show hold
    call is-equal
      call same-hurwitz
        read g
        read h
      make yes
  fold g, h

# Is a point a unit vector of the Hurwitz shape: one whole coordinate and three zeros, or four halves.
task is-whole
  take a, like half
  like flag
  fork case, read a
    case minus-whole
      send back
        make yes
    case minus-half
      send back
        make no
    case naught
      send back
        make no
    case plus-half
      send back
        make no
    case plus-whole
      send back
        make yes

task is-half
  take a, like half
  like flag
  fork case, read a
    case minus-whole
      send back
        make no
    case minus-half
      send back
        make yes
    case naught
      send back
        make no
    case plus-half
      send back
        make yes
    case plus-whole
      send back
        make no

task is-naught
  take a, like half
  like flag
  send back
    call same-half
      read a
      make naught

task one-whole-three-naught
  take a, like half
  take b, like half
  take c, like half
  take d, like half
  like flag
  send back
    call either
      call either
        call both
          call is-whole
            read a
          call both
            call is-naught
              read b
            call both
              call is-naught
                read c
              call is-naught
                read d
        call both
          call is-whole
            read b
          call both
            call is-naught
              read a
            call both
              call is-naught
                read c
              call is-naught
                read d
      call either
        call both
          call is-whole
            read c
          call both
            call is-naught
              read a
            call both
              call is-naught
                read b
              call is-naught
                read d
        call both
          call is-whole
            read d
          call both
            call is-naught
              read a
            call both
              call is-naught
                read b
              call is-naught
                read c

task is-unit-point
  take p, like quaternion-point
  like flag
  fork case, read p
    case coordinates
      send back
        call either
          call one-whole-three-naught
            read r
            read i
            read j
            read k
          call both
            call both
              call is-half
                read r
              call is-half
                read i
            call both
              call is-half
                read j
              call is-half
                read k

# EVERY ELEMENT IS A UNIT QUATERNION of the Hurwitz shape (so its norm is 1 + 0 + 0 + 0 or 4 x 1/4).
rule every-element-is-a-hurwitz-unit-vector
  seat g, like hurwitz-element
  show hold
    call is-equal
      call is-unit-point
        call hurwitz-point
          read g
      make yes
  fold g

# THE HAMILTON PRODUCT over the integers, coordinate by coordinate, for (a0 + a1 i + a2 j + a3 k)(b0 + b1 i + b2 j + b3 k).
# The relations below use doubled coordinates, so 2 w = -1 + i + j + k is an integer quaternion.

task hamilton-real
  take a0, like integer
  take a1, like integer
  take a2, like integer
  take a3, like integer
  take b0, like integer
  take b1, like integer
  take b2, like integer
  take b3, like integer
  like integer
  send back
    call subtract
      call subtract
        call subtract
          call multiply
            read a0
            read b0
          call multiply
            read a1
            read b1
        call multiply
          read a2
          read b2
      call multiply
        read a3
        read b3

task hamilton-i
  take a0, like integer
  take a1, like integer
  take a2, like integer
  take a3, like integer
  take b0, like integer
  take b1, like integer
  take b2, like integer
  take b3, like integer
  like integer
  send back
    call subtract
      call add
        call add
          call multiply
            read a0
            read b1
          call multiply
            read a1
            read b0
        call multiply
          read a2
          read b3
      call multiply
        read a3
        read b2

task hamilton-j
  take a0, like integer
  take a1, like integer
  take a2, like integer
  take a3, like integer
  take b0, like integer
  take b1, like integer
  take b2, like integer
  take b3, like integer
  like integer
  send back
    call add
      call add
        call subtract
          call multiply
            read a0
            read b2
          call multiply
            read a1
            read b3
        call multiply
          read a2
          read b0
      call multiply
        read a3
        read b1

task hamilton-k
  take a0, like integer
  take a1, like integer
  take a2, like integer
  take a3, like integer
  take b0, like integer
  take b1, like integer
  take b2, like integer
  take b3, like integer
  like integer
  send back
    call add
      call subtract
        call add
          call multiply
            read a0
            read b3
          call multiply
            read a1
            read b2
        call multiply
          read a2
          read b1
      call multiply
        read a3
        read b0

task quaternion-norm
  take a0, like integer
  take a1, like integer
  take a2, like integer
  take a3, like integer
  like integer
  send back
    call add
      call add
        call multiply
          read a0
          read a0
        call multiply
          read a1
          read a1
      call add
        call multiply
          read a2
          read a2
        call multiply
          read a3
          read a3

# THE HAMILTON PRODUCT IS ASSOCIATIVE, for all integer quaternions, coordinate by coordinate.

rule the-hamilton-product-is-associative-real
  seat a0, like integer
  seat a1, like integer
  seat a2, like integer
  seat a3, like integer
  seat b0, like integer
  seat b1, like integer
  seat b2, like integer
  seat b3, like integer
  seat c0, like integer
  seat c1, like integer
  seat c2, like integer
  seat c3, like integer
  show hold
    call is-equal
      call hamilton-real
        call hamilton-real
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        call hamilton-i
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        call hamilton-j
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        call hamilton-k
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        read c0
        read c1
        read c2
        read c3
      call hamilton-real
        read a0
        read a1
        read a2
        read a3
        call hamilton-real
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-i
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-j
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-k
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3

rule the-hamilton-product-is-associative-i
  seat a0, like integer
  seat a1, like integer
  seat a2, like integer
  seat a3, like integer
  seat b0, like integer
  seat b1, like integer
  seat b2, like integer
  seat b3, like integer
  seat c0, like integer
  seat c1, like integer
  seat c2, like integer
  seat c3, like integer
  show hold
    call is-equal
      call hamilton-i
        call hamilton-real
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        call hamilton-i
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        call hamilton-j
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        call hamilton-k
          read a0
          read a1
          read a2
          read a3
          read b0
          read b1
          read b2
          read b3
        read c0
        read c1
        read c2
        read c3
      call hamilton-i
        read a0
        read a1
        read a2
        read a3
        call hamilton-real
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-i
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-j
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-k
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3

rule the-hamilton-product-is-associative-j
  seat a0, like integer
  seat a1, like integer
  seat a2, like integer
  seat a3, like integer
  seat b0, like integer
  seat b1, like integer
  seat b2, like integer
  seat b3, like integer
