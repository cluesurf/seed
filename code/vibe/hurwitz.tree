        read a0
        read a1
        read a2
        read a3
        call hamilton-real
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
          read c3
        call hamilton-i
          read b0
          read b1
          read b2
          read b3
          read c0
          read c1
          read c2
