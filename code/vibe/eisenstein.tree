# The Eisenstein integers Z[w], w = e^(2 pi i / 3), the ring every amplitude of the rule lives in once 2 is inverted. An
# element is a + b w with integers a, b, and w is pinned by w^2 + w + 1 = 0, so w^2 = -1 - w. Every three in the model
# lives here: charge comes in thirds, the knot 1 + w + w^2 = 0, and the residue field Z[w]/(1 - w) is F3, the field of
# the tone itself.
#
# This file DEFINES the product, the conjugate and the norm as polynomials in the two integer coordinates, then PROVES,
# for all integers, that the product is a commutative ring law, that w is a primitive cube root of unity, that the norm
# is multiplicative and positive definite, that conjugation is a ring automorphism, and that reduction modulo 1 - w is a
# ring map onto F3 (the residue is a + b mod 3). It then proves the arithmetic of the primes the rule's numbers meet:
# 3 ramifies, 7 splits, and 2 stays prime, and pins the unit group as the six sixth roots of unity, generated by 1 + w.
#
# Each statement is a polynomial identity over the integers, closed by the ring normalizer after the named tasks unfold.

# (a + b w)(c + d w) = (ac - bd) + (ad + bc - bd) w, using w^2 = -1 - w.
task omega-real
  take a, like integer
  take b, like integer
  take c, like integer
  take d, like integer
  like integer
  send back
    call subtract
      call multiply
        read a
        read c
      call multiply
        read b
        read d

task omega-part
  take a, like integer
  take b, like integer
  take c, like integer
  take d, like integer
  like integer
  send back
    call subtract
      call add
        call multiply
          read a
          read d
        call multiply
          read b
          read c
      call multiply
        read b
        read d

# The complex conjugate of a + b w is a + b w^2 = (a - b) - b w.
task bar-real
  take a, like integer
  take b, like integer
  like integer
  send back
    call subtract
      read a
      read b

task bar-part
  take a, like integer
  take b, like integer
  like integer
  send back
    call subtract
      code 0
      read b

# The norm N(a + b w) = (a + b w)(a + b w^2) = a^2 - ab + b^2, the squared absolute value.
task eisenstein-norm
  take a, like integer
  take b, like integer
  like integer
  send back
    call add
      call subtract
        call multiply
          read a
          read a
        call multiply
          read a
          read b
      call multiply
        read b
        read b

# The residue of a + b w modulo the prime 1 - w: since w = 1 there, a + b w becomes a + b, read modulo three.
task residue
  take a, like integer
  take b, like integer
  like integer
  send back
    call add
      read a
      read b

# THE PRODUCT IS COMMUTATIVE.
rule eisenstein-product-commutes-real
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call omega-real
        read a
        read b
        read c
        read d
      call omega-real
        read c
        read d
        read a
        read b

rule eisenstein-product-commutes-part
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call omega-part
        read a
        read b
        read c
        read d
      call omega-part
        read c
        read d
        read a
        read b

# THE PRODUCT IS ASSOCIATIVE: ((a + b w)(c + d w))(e + f w) = (a + b w)((c + d w)(e + f w)), both coordinates.
rule eisenstein-product-associates-real
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  seat e, like integer
  seat f, like integer
  show hold
    call is-equal
      call omega-real
        call omega-real
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read c
          read d
        read e
        read f
      call omega-real
        read a
        read b
        call omega-real
          read c
          read d
          read e
          read f
        call omega-part
          read c
          read d
          read e
          read f

rule eisenstein-product-associates-part
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  seat e, like integer
  seat f, like integer
  show hold
    call is-equal
      call omega-part
        call omega-real
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read c
          read d
        read e
        read f
      call omega-part
        read a
        read b
        call omega-real
          read c
          read d
          read e
          read f
        call omega-part
          read c
          read d
          read e
          read f

# THE PRODUCT DISTRIBUTES over coordinate addition: x (y + z) = x y + x z.
rule eisenstein-product-distributes-real
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  seat e, like integer
  seat f, like integer
  show hold
    call is-equal
      call omega-real
        read a
        read b
        call add
          read c
          read e
        call add
          read d
          read f
      call add
        call omega-real
          read a
          read b
          read c
          read d
        call omega-real
          read a
          read b
          read e
          read f

rule eisenstein-product-distributes-part
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  seat e, like integer
  seat f, like integer
  show hold
    call is-equal
      call omega-part
        read a
        read b
        call add
          read c
          read e
        call add
          read d
          read f
      call add
        call omega-part
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read e
          read f

# ONE IS THE UNIT: (1 + 0 w)(c + d w) = c + d w.
rule one-is-the-eisenstein-unit-real
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call omega-real
        code 1
        code 0
        read c
        read d
      read c

rule one-is-the-eisenstein-unit-part
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call omega-part
        code 1
        code 0
        read c
        read d
      read d

# W SQUARED IS -1 - W: the defining relation w^2 + w + 1 = 0.
rule omega-squared-real
  show hold
    call is-equal
      call omega-real
        code 0
        code 1
        code 0
        code 1
      code -1

rule omega-squared-part
  show hold
    call is-equal
      call omega-part
        code 0
        code 1
        code 0
        code 1
      code -1

# W IS A CUBE ROOT OF UNITY: w^3 = w^2 w = (-1 - w) w = 1.
rule omega-cubed-real
  show hold
    call is-equal
      call omega-real
        code -1
        code -1
        code 0
        code 1
      code 1

rule omega-cubed-part
  show hold
    call is-equal
      call omega-part
        code -1
        code -1
        code 0
        code 1
      code 0

# THE NORM IS MULTIPLICATIVE: N(x y) = N(x) N(y), for all integers.
rule eisenstein-norm-is-multiplicative
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call eisenstein-norm
        call omega-real
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read c
          read d
      call multiply
        call eisenstein-norm
          read a
          read b
        call eisenstein-norm
          read c
          read d

# THE NORM IS z TIMES ITS CONJUGATE: (a + b w)(a + b w^2) = N, with no w part left.
rule a-number-times-its-conjugate-is-its-norm
  seat a, like integer
  seat b, like integer
  show hold
    call is-equal
      call omega-real
        read a
        read b
        call bar-real
          read a
          read b
        call bar-part
          read a
          read b
      call eisenstein-norm
        read a
        read b

rule a-number-times-its-conjugate-is-real
  seat a, like integer
  seat b, like integer
  show hold
    call is-equal
      call omega-part
        read a
        read b
        call bar-real
          read a
          read b
        call bar-part
          read a
          read b
      code 0

# CONJUGATION IS A RING AUTOMORPHISM: conj(x y) = conj(x) conj(y), and conjugating twice returns x.
rule conjugation-is-multiplicative-real
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call bar-real
        call omega-real
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read c
          read d
      call omega-real
        call bar-real
          read a
          read b
        call bar-part
          read a
          read b
        call bar-real
          read c
          read d
        call bar-part
          read c
          read d

rule conjugation-is-multiplicative-part
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call bar-part
        call omega-real
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read c
          read d
      call omega-part
        call bar-real
          read a
          read b
        call bar-part
          read a
          read b
        call bar-real
          read c
          read d
        call bar-part
          read c
          read d

rule conjugation-is-an-involution-real
  seat a, like integer
  seat b, like integer
  show hold
    call is-equal
      call bar-real
        call bar-real
          read a
          read b
        call bar-part
          read a
          read b
      read a

rule conjugation-is-an-involution-part
  seat a, like integer
  seat b, like integer
  show hold
    call is-equal
      call bar-part
        call bar-real
          read a
          read b
        call bar-part
          read a
          read b
      read b

# THE NORM IS POSITIVE DEFINITE: 4 N(a + b w) = (2a - b)^2 + 3 b^2, a sum of squares, so N >= 0 and N = 0 only at 0.
rule four-norms-are-a-sum-of-squares
  seat a, like integer
  seat b, like integer
  show hold
    call is-equal
      call multiply
        code 4
        call eisenstein-norm
          read a
          read b
      call add
        call multiply
          call subtract
            call multiply
              code 2
              read a
            read b
          call subtract
            call multiply
              code 2
              read a
            read b
        call multiply
          code 3
          call multiply
            read b
            read b

rule the-eisenstein-norm-is-never-negative
  seat a, like integer
  seat b, like integer
  show hold
    call is-minimum
      call eisenstein-norm
        read a
        read b
      code 0

# REDUCTION MODULO 1 - W IS A RING MAP ONTO F3. The residue of a product is the product of the residues up to a multiple
# of three: res(x y) = res(x) res(y) - 3 b d. Sums reduce coordinate-wise, so the residue is additive on the nose.
rule the-residue-of-a-product-is-the-product-of-residues
  seat a, like integer
  seat b, like integer
  seat c, like integer
  seat d, like integer
  show hold
    call is-equal
      call residue
        call omega-real
          read a
          read b
          read c
          read d
        call omega-part
          read a
          read b
          read c
          read d
      call subtract
        call multiply
          call residue
            read a
            read b
          call residue
            read c
            read d
        call multiply
          code 3
          call multiply
            read b
            read d

# The norm reduces to the square of the residue: N = (a + b)^2 - 3 a b. With vibe/tone `no-square-is-fear`, a norm is
# never 2 modulo 3, so no Eisenstein integer has norm 2: TWO IS INERT, it stays prime in Z[w].
rule the-norm-is-the-square-of-the-residue-modulo-three
  seat a, like integer
  seat b, like integer
  show hold
    call is-equal
      call eisenstein-norm
        read a
        read b
      call subtract
        call multiply
          call residue
            read a
            read b
          call residue
            read a
            read b
        call multiply
          code 3
          call multiply
            read a
            read b

# THREE RAMIFIES: (1 - w)^2 = -3 w, so 3 = -w^2 (1 - w)^2 is a unit times a square. Real part 0, w part -3.
rule one-minus-omega-squared-is-minus-three-omega-real
  show hold
    call is-equal
      call omega-real
        code 1
        code -1
        code 1
        code -1
      code 0

rule one-minus-omega-squared-is-minus-three-omega-part
  show hold
    call is-equal
      call omega-part
        code 1
        code -1
        code 1
        code -1
      code -3

rule one-minus-omega-has-norm-three
  show hold
    call is-equal
      call eisenstein-norm
        code 1
        code -1
      code 3

# SEVEN SPLITS: (3 + w)(3 + w^2) = (3 + w)(2 - w) = 7, a product of two conjugate primes of norm 7.
rule seven-is-three-plus-omega-times-its-conjugate-real
  show hold
    call is-equal
      call omega-real
        code 3
        code 1
        call bar-real
          code 3
          code 1
        call bar-part
          code 3
          code 1
      code 7

rule seven-is-three-plus-omega-times-its-conjugate-part
  show hold
    call is-equal
      call omega-part
        code 3
        code 1
        call bar-real
          code 3
          code 1
        call bar-part
          code 3
          code 1
      code 0

rule three-plus-omega-has-norm-seven
  show hold
    call is-equal
      call eisenstein-norm
        code 3
        code 1
      code 7

# THE ANGLE THAT INVERTING SEVEN FREES: (3 + w)^2 = 8 + 5 w has norm 49 = 7^2, so u = (8 + 5 w)/7 has absolute value 1
# without being a root of unity. The rule's chosen unit -(360 + 37 w)/343 has norm 343^2 = 117649.
rule three-plus-omega-squared-is-eight-plus-five-omega-real
  show hold
    call is-equal
      call omega-real
        code 3
        code 1
        code 3
        code 1
      code 8

rule three-plus-omega-squared-is-eight-plus-five-omega-part
  show hold
    call is-equal
      call omega-part
        code 3
        code 1
        code 3
        code 1
      code 5

rule eight-plus-five-omega-has-norm-forty-nine
  show hold
    call is-equal
      call eisenstein-norm
        code 8
        code 5
      code 49

rule the-mixer-unit-has-norm-three-hundred-forty-three-squared
  show hold
    call is-equal
      call eisenstein-norm
        code 360
        code 37
      call multiply
        code 343
        code 343

# THE UNITS ARE THE SIXTH ROOTS OF UNITY, generated by 1 + w = -w^2 = e^(i pi / 3). Its square is w, its cube is -1, so it
# has order six, and every unit has norm 1.
rule one-plus-omega-squared-is-omega-real
  show hold
    call is-equal
      call omega-real
        code 1
        code 1
        code 1
        code 1
      code 0

rule one-plus-omega-squared-is-omega-part
  show hold
    call is-equal
      call omega-part
        code 1
        code 1
        code 1
        code 1
      code 1

rule one-plus-omega-cubed-is-minus-one-real
  show hold
    call is-equal
      call omega-real
        code 0
        code 1
        code 1
        code 1
      code -1

rule one-plus-omega-cubed-is-minus-one-part
  show hold
    call is-equal
      call omega-part
        code 0
        code 1
        code 1
        code 1
      code 0

rule one-plus-omega-is-a-unit
  show hold
    call is-equal
      call eisenstein-norm
        code 1
        code 1
      code 1
