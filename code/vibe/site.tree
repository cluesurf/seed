# The site, the third base element: one of a dock's twenty-four directions, each pointing out through one face to the
# neighbor on the other side, where a single tone lives. The twenty-four sites pair into twelve lines, a site and its
# opposite, and the line, not the single site, is what the knit's collision acts on.
#
# This file MODELS the pairing using the shared `sign` and `flag` atoms (imported, not redefined). A direction's
# orientation is its two signs (a D4 root has two nonzero slots, each positive or negative). The opposite direction flips
# both signs. The opposite map is proved an INVOLUTION and FIXED-POINT-FREE (no direction is its own opposite), which is
# what makes the twenty-four sites pair cleanly into twelve lines with none left over.

load @term/seed/atom/sign
  find sign
  find flip-sign
  find same-sign

load @term/seed/atom/flag
  find flag
  find both

# A way, a direction's orientation: the two signs of its two nonzero slots.
form way
  case pair
    link one, like sign
    link two, like sign

# The opposite direction: flip both signs. This is the antipodal site across the dock, the other end of the line.
task opposite
  take w, like way
  like way
  fork case, read w
    case pair
      link one
      link two
      send back
        make pair
          bind one
            call flip-sign
              read one
          bind two
            call flip-sign
              read two

# Are two ways the same? Equal on both signs.
task same-way
  take a, like way
  take b, like way
  like flag
  fork case, read a
    case pair
      link one
      link two
      fork case, read b
        case pair
          link three
          link four
          send back
            call both
              call same-sign
                read one
                read three
              call same-sign
                read two
                read four

# THE OPPOSITE MAP IS AN INVOLUTION: opposite (opposite w) = w. The other end of the line points back.
rule opposite-is-an-involution
  mark w, like way
  show hold
    call is-equal
      call opposite
        call opposite
          read w
      read w
  fold w

# THE OPPOSITE IS FIXED-POINT-FREE: no direction is its own opposite, same-way w (opposite w) = no, because the opposite
# flips both signs and a flipped sign always differs. This makes the twenty-four sites pair into twelve genuine lines.
rule opposite-has-no-fixed-point
  mark w, like way
  show hold
    call is-equal
      call same-way
        read w
        call opposite
          read w
      make no
  fold w
