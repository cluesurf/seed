# The continuant of a chain of 2 mirrors: det 2G with x_i = 4 cos^2(pi / m_i).
task chain-2
  take x1, like integer
  like integer
  send back
    call subtract
      call multiply
        code 2
        code 2
      call multiply
        read x1
        code 1

# The continuant of a chain of 3 mirrors: det 2G with x_i = 4 cos^2(pi / m_i).
task chain-3
  take x1, like integer
  take x2, like integer
  like integer
  send back
    call subtract
      call multiply
        code 2
        call chain-2
          read x1
      call multiply
        read x2
        code 2

# The continuant of a chain of 4 mirrors: det 2G with x_i = 4 cos^2(pi / m_i).
task chain-4
  take x1, like integer
  take x2, like integer
  take x3, like integer
  like integer
  send back
    call subtract
      call multiply
        code 2
        call chain-3
          read x1
          read x2
      call multiply
        read x3
        call chain-2
          read x1

# The continuant of a chain of 5 mirrors: det 2G with x_i = 4 cos^2(pi / m_i).
task chain-5
  take x1, like integer
  take x2, like integer
  take x3, like integer
  take x4, like integer
  like integer
  send back
    call subtract
      call multiply
        code 2
        call chain-4
          read x1
          read x2
          read x3
      call multiply
        read x4
        call chain-3
          read x1
          read x2

# THE DETERMINANT OF A CHAIN OF 3 MIRRORS IS ITS CONTINUANT, for every set of off-diagonal entries.
rule the-determinant-of-a-chain-of-3-is-its-continuant
  mark u1, like integer
  mark u2, like integer
  show hold
    call is-equal
      call determinant-three
        code 2
        call subtract
          code 0
          read u1
        code 0
        call subtract
          code 0
          read u1
        code 2
        call subtract
          code 0
          read u2
        code 0
        call subtract
          code 0
          read u2
        code 2
      call chain-3
        call multiply
          read u1
          read u1
        call multiply
          read u2
          read u2

# THE DETERMINANT OF A CHAIN OF 4 MIRRORS IS ITS CONTINUANT, for every set of off-diagonal entries.
rule the-determinant-of-a-chain-of-4-is-its-continuant
  mark u1, like integer
  mark u2, like integer
  mark u3, like integer
  show hold
    call is-equal
      call determinant-four
        code 2
        call subtract
          code 0
          read u1
        code 0
        code 0
        call subtract
          code 0
          read u1
        code 2
        call subtract
          code 0
          read u2
        code 0
        code 0
        call subtract
          code 0
          read u2
        code 2
        call subtract
          code 0
          read u3
        code 0
        code 0
        call subtract
          code 0
          read u3
        code 2
      call chain-4
        call multiply
          read u1
          read u1
        call multiply
          read u2
          read u2
        call multiply
          read u3
          read u3

# THE DETERMINANT OF A CHAIN OF 5 MIRRORS IS ITS CONTINUANT, for every set of off-diagonal entries.
rule the-determinant-of-a-chain-of-5-is-its-continuant
  mark u1, like integer
  mark u2, like integer
  mark u3, like integer
  mark u4, like integer
  show hold
    call is-equal
      call determinant-five
        code 2
        call subtract
          code 0
          read u1
        code 0
        code 0
        code 0
        call subtract
          code 0
          read u1
        code 2
        call subtract
          code 0
          read u2
        code 0
        code 0
        code 0
        call subtract
          code 0
          read u2
        code 2
        call subtract
          code 0
          read u3
        code 0
        code 0
        code 0
        call subtract
          code 0
          read u3
        code 2
        call subtract
          code 0
          read u4
        code 0
        code 0
        code 0
        call subtract
          code 0
          read u4
        code 2
      call chain-5
        call multiply
          read u1
          read u1
        call multiply
          read u2
          read u2
        call multiply
          read u3
          read u3
        call multiply
          read u4
          read u4

# THE 24-CELL {3,4,3}: minors 2, 3, 2, 1, all positive, so its mirrors bound a sphere chamber.
rule the-24-cell-chain-of-two-is-three
  show hold
    call is-equal
      call chain-2
        code 1
      code 3

rule the-24-cell-chain-of-three-is-two
  show hold
    call is-equal
      call chain-3
        code 1
        code 2
      code 2

rule the-24-cell-chain-of-four-is-one
  show hold
    call is-equal
      call chain-4
        code 1
        code 2
        code 1
      code 1

# THE CUBIC HONEYCOMB {4,3,4}: minors 2, 2, 2 then 0, flat. This is the horosphere at every vertex of {3,4,3,4}.
rule the-cubic-chain-of-two-is-two
  show hold
    call is-equal
      call chain-2
        code 2
      code 2

rule the-cubic-chain-of-three-is-two
  show hold
    call is-equal
      call chain-3
        code 2
        code 1
      code 2

rule the-cubic-chain-of-four-is-zero
  show hold
    call is-equal
      call chain-4
        code 2
        code 1
        code 2
      code 0

# THE MESH {3,4,3,4}: the first four minors are those of {3,4,3} (2, 3, 2, 1), the fifth is -2. One sign change:
# signature (4, 1), hyperbolic 4-space, and det G = -2 / 2^5 = -1/16.
rule the-mesh-chain-of-five-is-minus-two
  show hold
    call is-equal
      call chain-5
        code 1
        code 2
        code 1
        code 2
      code -2

# THE CARTAN DETERMINANTS: A4 (the 5-cell {3,3,3}) is 5, B4 (the tesseract {4,3,3}) is 2, F4 is 1 (above).
rule the-five-cell-has-cartan-determinant-five
  show hold
    call is-equal
      call chain-4
        code 1
        code 1
        code 1
      code 5

rule the-tesseract-has-cartan-determinant-two
  show hold
    call is-equal
      call chain-4
        code 2
        code 1
        code 1
      code 2

# THE DISTANCE BETWEEN NEIGHBOURING CELLS. For the mirror opposite the cell, (G^-1)_55 = det G_1234 / det G
# = (D4 / 2^4) / (D5 / 2^5) = 2 D4 / D5, which is -1 here, so cosh d = 1 - 2 / (G^-1)_55 = 3 and d = 1.7627...
rule the-distance-between-adjacent-cells-has-cosh-three
  show hold
    call is-equal
      call multiply
        code 2
        call chain-4
          code 1
          code 2
          code 1
      call subtract
        code 0
        call chain-5
          code 1
          code 2
          code 1
          code 2

# THE PLANE CRITERION: 2pq (1/p + 1/q - 1/2) = 2q + 2p - pq = 4 - (p - 2)(q - 2). So {p, q} tiles the sphere,
# the plane or the hyperbolic plane as (p - 2)(q - 2) is below, at or above 4: {7,3} gives 5, hyperbolic.
rule the-plane-criterion
  mark p, like integer
  mark q, like integer
  show hold
    call is-equal
      call subtract
        call add
          call multiply
            code 2
            read p
          call multiply
            code 2
            read q
        call multiply
          read p
          read q
      call subtract
        code 4
        call multiply
          call subtract
            read p
            code 2
          call subtract
            read q
            code 2

