# The four roots +-e_i +-e_j of one pair of axes, x = k_i, y = k_j: sum of (+-x +-y)^6.
task pair-moment-6
  take x, like integer
  take y, like integer
  like integer
  send back
    call add
      call add
        call add
          call power-6
            call add
              read x
              read y
          call power-6
            call add
              read x
              call subtract
                code 0
                read y
        call power-6
          call add
            call subtract
              code 0
              read x
            read y
      call power-6
        call add
          call subtract
            code 0
            read x
          call subtract
            code 0
            read y

# sum over all 24 roots of (k . r)^2.
task root-moment-2
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call add
        call add
          call add
            call add
              call pair-moment-2
                read k1
                read k2
              call pair-moment-2
                read k1
                read k3
            call pair-moment-2
              read k1
              read k4
          call pair-moment-2
            read k2
            read k3
        call pair-moment-2
          read k2
          read k4
      call pair-moment-2
        read k3
        read k4

# sum over all 24 roots of (k . r)^3.
task root-moment-3
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call add
        call add
          call add
            call add
              call pair-moment-3
                read k1
                read k2
              call pair-moment-3
                read k1
                read k3
            call pair-moment-3
              read k1
              read k4
          call pair-moment-3
            read k2
            read k3
        call pair-moment-3
          read k2
          read k4
      call pair-moment-3
        read k3
        read k4

# sum over all 24 roots of (k . r)^4.
task root-moment-4
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call add
        call add
          call add
            call add
              call pair-moment-4
                read k1
                read k2
              call pair-moment-4
                read k1
                read k3
            call pair-moment-4
              read k1
              read k4
          call pair-moment-4
            read k2
            read k3
        call pair-moment-4
          read k2
          read k4
      call pair-moment-4
        read k3
        read k4

# sum over all 24 roots of (k . r)^5.
task root-moment-5
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call add
        call add
          call add
            call add
              call pair-moment-5
                read k1
                read k2
              call pair-moment-5
                read k1
                read k3
            call pair-moment-5
              read k1
              read k4
          call pair-moment-5
            read k2
            read k3
        call pair-moment-5
          read k2
          read k4
      call pair-moment-5
        read k3
        read k4

# sum over all 24 roots of (k . r)^6.
task root-moment-6
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call add
        call add
          call add
            call add
              call pair-moment-6
                read k1
                read k2
              call pair-moment-6
                read k1
                read k3
            call pair-moment-6
              read k1
              read k4
          call pair-moment-6
            read k2
            read k3
        call pair-moment-6
          read k2
          read k4
      call pair-moment-6
        read k3
        read k4

# sum over the 8 roots of the frame {12|34} of (k . r)^2.
task frame-moment-2
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call pair-moment-2
        read k1
        read k2
      call pair-moment-2
        read k3
        read k4

# sum over the 8 roots of the frame {12|34} of (k . r)^4.
task frame-moment-4
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call pair-moment-4
        read k1
        read k2
      call pair-moment-4
        read k3
        read k4

task norm-squared
  take k1, like integer
  take k2, like integer
  take k3, like integer
  take k4, like integer
  like integer
  send back
    call add
      call add
        call power-2
          read k1
        call power-2
          read k2
      call add
        call power-2
          read k3
        call power-2
          read k4

# THE SECOND MOMENT IS ISOTROPIC: sum (k . r)^2 = 12 |k|^2.
rule the-second-moment-of-the-roots-is-isotropic
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  seat k4, like integer
  show hold
    call is-equal
      call root-moment-2
        read k1
        read k2
        read k3
        read k4
      call multiply
        code 12
        call norm-squared
          read k1
          read k2
          read k3
          read k4

# THE FOURTH MOMENT IS ISOTROPIC: sum (k . r)^4 = 12 |k|^4. With the vanishing odd moments, a 5-design.
rule the-fourth-moment-of-the-roots-is-isotropic
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  seat k4, like integer
  show hold
    call is-equal
      call root-moment-4
        read k1
        read k2
        read k3
        read k4
      call multiply
        code 12
        call multiply
          call norm-squared
            read k1
            read k2
            read k3
            read k4
          call norm-squared
            read k1
            read k2
            read k3
            read k4

# THE ODD MOMENTS VANISH (the roots come in opposite pairs).
rule the-third-moment-of-the-roots-vanishes
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  seat k4, like integer
  show hold
    call is-equal
      call root-moment-3
        read k1
        read k2
        read k3
        read k4
      code 0

rule the-fifth-moment-of-the-roots-vanishes
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  seat k4, like integer
  show hold
    call is-equal
      call root-moment-5
        read k1
        read k2
        read k3
        read k4
      code 0

# NOT A 6-DESIGN: along e1 the sixth moment is 12 |k|^6, along e1 + e2 it is 144 = 18 |k|^6.
rule the-sixth-moment-along-an-axis-is-twelve
  show hold
    call is-equal
      call root-moment-6
        code 1
        code 0
        code 0
        code 0
      code 12

rule the-sixth-moment-along-a-root-is-one-hundred-forty-four
  show hold
    call is-equal
      call root-moment-6
        code 1
        code 1
        code 0
        code 0
      code 144

# ONE FRAME IS ONLY A 3-DESIGN: its second moment is 4 |k|^2, but its fourth is 4 along e1 and 32 = 8 |k|^4
# along e1 + e2.
rule one-frame-has-an-isotropic-second-moment
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  seat k4, like integer
  show hold
    call is-equal
      call frame-moment-2
        read k1
        read k2
        read k3
        read k4
      call multiply
        code 4
        call norm-squared
          read k1
          read k2
          read k3
          read k4

rule one-frame-has-fourth-moment-four-along-an-axis
  show hold
    call is-equal
      call frame-moment-4
        code 1
        code 0
        code 0
        code 0
      code 4

rule one-frame-has-fourth-moment-thirty-two-along-a-root
  show hold
    call is-equal
      call frame-moment-4
        code 1
        code 1
        code 0
        code 0
      code 32

# sum over the husk's 9 weighted directions of g (k . u)^2.
task husk-moment-2
  take k1, like integer
  take k2, like integer
  take k3, like integer
  like integer
  send back
    call add
      call multiply
        code 2
        call add
          call add
            call power-2
              read k1
            call power-2
              read k2
          call power-2
            read k3
      call add
        call add
          call add
            call power-2
              call add
                read k1
                read k2
            call power-2
              call subtract
                read k1
                read k2
          call add
            call power-2
              call add
                read k1
                read k3
            call power-2
              call subtract
                read k1
                read k3
        call add
          call power-2
            call add
              read k2
              read k3
          call power-2
            call subtract
              read k2
              read k3

# sum over the husk's 9 weighted directions of g (k . u)^4.
task husk-moment-4
  take k1, like integer
  take k2, like integer
  take k3, like integer
  like integer
  send back
    call add
      call multiply
        code 2
        call add
          call add
            call power-4
              read k1
            call power-4
              read k2
          call power-4
            read k3
      call add
        call add
          call add
            call power-4
              call add
                read k1
                read k2
            call power-4
              call subtract
                read k1
                read k2
          call add
            call power-4
              call add
                read k1
                read k3
            call power-4
              call subtract
                read k1
                read k3
        call add
          call power-4
            call add
              read k2
              read k3
          call power-4
            call subtract
              read k2
              read k3

# sum over the husk's 9 weighted directions of g (k . u)^6.
task husk-moment-6
  take k1, like integer
  take k2, like integer
  take k3, like integer
  like integer
  send back
    call add
      call multiply
        code 2
        call add
          call add
            call power-6
              read k1
            call power-6
              read k2
          call power-6
            read k3
      call add
        call add
          call add
            call power-6
              call add
                read k1
                read k2
            call power-6
              call subtract
                read k1
                read k2
          call add
            call power-6
              call add
                read k1
                read k3
            call power-6
              call subtract
                read k1
                read k3
        call add
          call power-6
            call add
              read k2
              read k3
          call power-6
            call subtract
              read k2
              read k3

# THE HUSK: sum g (k . u)^2 = 6 |k|^2, the coefficient that sets the potential 1/(24 pi r).
rule the-husk-second-moment-is-six-k-squared
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  show hold
    call is-equal
      call husk-moment-2
        read k1
        read k2
        read k3
      call multiply
        code 6
        call add
          call add
            call power-2
              read k1
            call power-2
              read k2
          call power-2
            read k3

# sum g (k . u)^4 = 6 |k|^4: the quartic correction is isotropic, so no 1/r^3 term.
rule the-husk-fourth-moment-is-isotropic
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  show hold
    call is-equal
      call husk-moment-4
        read k1
        read k2
        read k3
      call multiply
        code 6
        call multiply
          call add
            call add
              call power-2
                read k1
              call power-2
                read k2
            call power-2
              read k3
          call add
            call add
              call power-2
                read k1
              call power-2
                read k2
            call power-2
              read k3

# sum g (k . u)^6 = 30 p4 p2 - 24 p6: the first anisotropic term, the 1/r^5 correction.
rule the-husk-sixth-moment
  seat k1, like integer
  seat k2, like integer
  seat k3, like integer
  show hold
    call is-equal
      call husk-moment-6
        read k1
        read k2
        read k3
      call subtract
        call multiply
          code 30
          call multiply
            call add
              call add
                call power-4
                  read k1
                call power-4
                  read k2
              call power-4
                read k3
            call add
              call add
                call power-2
                  read k1
                call power-2
                  read k2
              call power-2
                read k3
        call multiply
          code 24
          call add
            call add
              call power-6
                read k1
              call power-6
                read k2
            call power-6
              read k3

