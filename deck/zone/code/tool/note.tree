
# The note on a stored secret: the ONE place that knows its shape.
#
# A provider's secret carries a free-text note beside its value, and in
# `note` mode that note is what says which zone owns the value. It is
# the whole mechanism that replaces a project per zone: Bitwarden caps
# projects by plan, and notes are free and unlimited.
#
# THE NOTE IS A `host` DATA DOCUMENT, and it is read by the COMPILER:
#
#   list zone, <cluesurf>, <mesh>
#
# One field. A list, because one stored value can belong to several
# zones and storing it twice is the drift this system exists to end.
#
# WHY THE COMPILER AND NOT A LINE READER. The note used to be an ad-hoc
# `key: value` block read by three separate hand-written parsers: one
# here, one in `task/zone/load.ts`, and a third nearly added to
# `hold/runtime/vault.ts`. A second implementation of a grammar
# disagrees with the grammar eventually, and the disagreement is
# silent. This package has paid for that twice already, most recently
# with a reader that kept one `<...>` per line so `time <made>, <toss>`
# lost its first value and every cache read as stale the instant it was
# written. `mine-tree` is the compiler's own parser, bundled by the
# mill shim, and it is what reads `zone.tree` and the cache too.
#
# IT IS NOT YAML AND NEVER WAS. `zone: cluesurf, mesh` looks like YAML
# and parses in YAML as the single string "cluesurf, mesh": the comma
# list was never YAML list syntax, so a real YAML parser would have
# bought a field split and left the comma to be hand-split anyway. The
# `host` dialect has a list.
#
# `env:` and `from:` are GONE. Both were written by the migration
# loader and read by nothing, anywhere, ever. `from:` named the `.env`
# file a value came from, and those files are being deleted, so the
# line would have outlived its subject and become a lie.

load @term/seed/code/text
  find text

load @term/seed/code/list
  find list
  find push
  find size

load @term/seed/code/boolean
  find boolean

load ../base
  find leaf

load ./read
  find mine-tree

load ./base
  find join-text
  find equal
  find note-field

# The zones a note names, in the order written.
#
# Reads the `host` form through the compiler, and falls back to the
# retired `zone: a, b` line for a note written before the migration.
# The fallback is TRANSITIONAL: `term zone trim --commit` rewrites every
# stored note, and once no note is left in the old shape the fallback
# and `note-field` go with it.
task note-zones
  take note, like text
  like list

  save out
    make list

  save rows
    call mine-tree
      read note

  walk list, read rows
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read one/head
            text <list>
        hook hold
          fork test
            hook test
              call equal
                read one/term/0
                text <zone>
            hook hold
              walk list, read one/more
                hook next
                  take site, name two
                  call push
                    bind list, read out
                    bind item, read two

  fork test
    hook test
      call is-above
        call size
          read out
        code 0
    hook hold
      send back
        read out

  send back
    call old-zones
      read note

# Whether a note names one zone.
task note-has
  take note, like text
  take want, like text
  like boolean

  walk list
    call note-zones
      read note
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read one
            read want
        hook hold
          send back, true

  send back, false

# The note text for a list of zones.
#
# The inline form, `list zone, <a>, <b>`, rather than a block. A note is
# read by people in the provider's web vault as well as by this, and one
# line says the whole thing.
task note-make
  take zones, like list
  like text

  save out
    make list
  call push
    bind list, read out
    bind item, text <list zone>

  walk list, read zones
    hook next
      take site, name one
      call push
        bind list, read out
        bind item, text <, \<>
      call push
        bind list, read out
        bind item, read one
      call push
        bind list, read out
        bind item, text <\>>

  send back
    call join-text
      read out

# A note with one zone ADDED to whatever it already named.
#
# NEVER REPLACED. `list zone, <cluesurf>, <mesh>` means one stored value
# two declarations both find, which is what `term zone share` writes.
# Rewriting that to the single zone being filed under drops the other,
# and every name shared that way reads as missing on the next
# `term zone read` from the other root.
task note-add
  take note, like text
  take want, like text
  like text

  save zones
    call note-zones
      read note

  fork test
    hook test
      call note-has
        bind note, read note
        bind want, read want
    hook miss
      call push
        bind list, read zones
        bind item, read want

  send back
    call note-make
      read zones

# THE RETIRED SHAPE, read so a note written before the migration still
# resolves. Goes when `term zone trim` has rewritten them all.
task old-zones
  take note, like text
  like list

  save out
    make list

  save body
    call note-field
      bind note, read note
      bind name, text <zone>

  fork test
    hook test
      call equal
        read body
        text <>
    hook hold
      send back
        read out

  walk list
    call split-list
      read body
    hook next
      take site, name one
      call push
        bind list, read out
        bind item, read one

  send back
    read out

# Split a comma list and trim each part.
#
# The ONE piece of string work left, and it is here rather than in three
# places because the retired format's list was a comma inside a scalar
# and nothing but a split can undo that. The `host` form above needs no
# such thing: its commas are the grammar's.
bind split-list
  take body, like text
  like list
  case node
    text <String($body).split(",").map(function (one) \{ return one.trim() \}).filter(Boolean)>
