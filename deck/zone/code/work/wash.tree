
# `term zone wash` — rewrite every stored note into the `host` shape.
#
# THE ONE-TIME MIGRATION. A secret's note used to be an ad-hoc
# `key: value` block and is now a `host` data document read by the
# compiler:
#
#   zone: cluesurf, mesh          ->   list zone, <cluesurf>, <mesh>
#   env: ARCJET_KEY                    (dropped)
#   from: mesh/.env                    (dropped)
#
# `env:` and `from:` go because nothing has ever read them back. `from:`
# named the `.env` file a value came from, and those files are being
# deleted, so the line would outlive its subject and become a lie.
#
# REPORTS BY DEFAULT, WRITES ONLY ON `--commit`. Local development
# points at production, so forgetting the flag has to be the safe
# direction.
#
# THE VALUE IS NEVER TOUCHED. This reads every secret's NOTE and writes
# a note back. It never reads, writes, moves or deletes a value, and it
# never prints one.
#
# When this reports nothing left to do on every machine, the retired
# reader (`old-zones` and `note-field`) can go.

load @term/seed/code/text
  find text

load @term/seed/code/list
  find list
  find push
  find size

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe
  find is-none
  find unwrap

load ../base
  find spot
  find gear

load ./one
  find gear-up

load ../hold/bitwarden
  find bitwarden-notes
  find bitwarden-mark

load ../tool/note
  find note-zones
  find note-make
  find note-plain

load ../tool/base
  find join-text
  find show-line
  find halt
  find equal
  find not-equal
  find read-file
  find here
  find show-size

task wash
  note async
  take commit, like boolean
  like number

  # The declaration, the machine binding and the provider credential,
  # with every refusal already worded. The same entry point `put-one`
  # uses, so `wash` and `save --name` cannot disagree about which
  # declaration or which organization is in force.
  save it
    call gear-up
      wait true

  # EVERY SECRET IN THE ORGANIZATION, metadata only. The note comes back
  # on the listing, so the REPORT fetches no value at all.
  save rows
    call bitwarden-notes
      bind body, read it/token
      bind team, read it/root/team
      wait true

  save moved
    make list
  save kept
    make list
  # Notes naming no zone at all. NEVER REWRITTEN.
  save loose
    make list
  # Notes carrying something a person wrote. NEVER REWRITTEN.
  save owned
    make list

  walk list, read rows
    hook next
      take site, name one

      save zones
        call note-zones
          read one/note

      save want
        call note-make
          read zones

      # THREE REFUSALS BEFORE ANY REWRITE, because the first version of
      # this wanted to rewrite all 878 secrets in the organization and
      # would have destroyed two kinds of note doing it.
      fork test
        hook test
          call is-equal
            call size
              read zones
            code 0
        hook hold
          # NAMES NO ZONE. `note-make` on an empty list is the bare text
          # `list zone`, so rewriting would replace whatever is there
          # with a line that owns the secret to nobody. A note with no
          # zone is either a person's writing or a secret nothing
          # declares, and both want eyes rather than a migration.
          call push
            bind list, read loose
            bind item, read one/name
        hook miss
          fork test
            hook test
              call note-plain
                read one/note
            hook miss
              # CARRIES A PERSON'S WRITING beside the zone line. The
              # zones would survive the rewrite and the sentence would
              # not, so this is reported instead.
              call push
                bind list, read owned
                bind item, read one/name
            hook hold
              fork test
                hook test
                  call equal
                    read want
                    read one/note
                hook hold
                  call push
                    bind list, read kept
                    bind item, read one/name
                hook miss
                  call push
                    bind list, read moved
                    bind item, read one/name
                  fork test
                    hook test
                      read commit
                    hook hold
                      call bitwarden-mark
                        bind body, read it/token
                        bind team, read it/root/team
                        bind name, read one/name
                        bind mind, read want
                        wait true

  call show-line
    call join-text
      make list
        call show-size
          read kept
        text < already in the `host` shape>

  call show-line
    call join-text
      make list
        call show-size
          read moved
        text < to rewrite>

  walk list, read moved
    hook next
      take site, name one
      call show-line
        call join-text
          make list
            text <  >
            read one

  # THE TWO PILES THIS WILL NOT TOUCH, named out loud. A migration that
  # silently skipped them would read as complete while leaving the thing
  # a person has to decide about invisible.
  fork test
    hook test
      call is-above
        call size
          read loose
        code 0
    hook hold
      call show-line
        text <>
      call show-line
        call join-text
          make list
            call show-size
              read loose
            text < name no zone, so nothing here can own them. NOT touched>
      walk list, read loose
        hook next
          take site, name one
          call show-line
            call join-text
              make list
                text <  >
                read one

  fork test
    hook test
      call is-above
        call size
          read owned
        code 0
    hook hold
      call show-line
        text <>
      call show-line
        call join-text
          make list
            call show-size
              read owned
            text < carry writing of somebody's beside the zone. NOT touched>
      walk list, read owned
        hook next
          take site, name one
          call show-line
            call join-text
              make list
                text <  >
                read one

  fork test
    hook test
      read commit
    hook miss
      fork test
        hook test
          call is-above
            call size
              read moved
            code 0
        hook hold
          call show-line
            text <>
          call show-line
            text <Nothing was written. Re-run with `--commit` to rewrite them.>

  send back
    code 0
