# NEGATIVE CONTROL: coin, role, heisenberg. Every rule here is a perturbed true theorem and must be refused.

load @term/seed/atom/flag
  find flag

load @term/seed/vibe/tone
  find tone
  find tone-sum
  find tone-product
  find tone-conjugate
  find is-vibe

load @term/seed/vibe/eisenstein
  find eisenstein-norm
  find omega-real
  find omega-part

load @term/seed/vibe/coin
  find circulant-real
  find circulant-part

load @term/seed/vibe/role
  find role
  find role-shift
  find role-clock
  find wedge
  find direction
  find direction-vector
  find on-line
  find meeting-point
  find same-direction
  find stabilizer-line

load @term/seed/vibe/heisenberg
  find weyl
  find weyl-product
  find weyl-place
  find scalar

# a symmetric form is not alternating: u_s v_c + u_c v_s on (u, u) is 2 u_s u_c
task symmetric-form
  take u, like role
  take v, like role
  like tone
  send back
    call tone-sum
      call tone-product
        call role-shift
          read u
        call role-clock
          read v
      call tone-product
        call role-clock
          read u
        call role-shift
          read v

rule control-a-symmetric-form-is-alternating
  mark u, like role
  show hold
    call is-equal
      call symmetric-form
        read u
        read u
      make calm
  fold u

# two lines of the SAME direction do not meet (claimed here for all pairs of directions)
rule control-all-lines-meet
  mark d, like direction
  mark c, like tone
  mark e, like direction
  mark k, like tone
  show hold
    call is-equal
      call on-line
        make through
          bind direction
            read e
          bind offset
            read k
        call meeting-point
          read d
          read c
          read e
          read k
      make yes
  fold d, c, e, k

# the commutator without its sign flip
rule control-commutator-with-the-wrong-sign
  mark g, like weyl
  mark k, like weyl
  show hold
    call is-equal
      call weyl-product
        read g
        read k
      call weyl-product
        call scalar
          call wedge
            call weyl-place
              read g
            call weyl-place
              read k
        call weyl-product
          read k
          read g
  fold g, k

# the Weyl operators do not commute
rule control-weyl-operators-commute
  mark g, like weyl
  mark k, like weyl
  show hold
    call is-equal
      call weyl-product
        read g
        read k
      call weyl-product
        read k
        read g
  fold g, k
