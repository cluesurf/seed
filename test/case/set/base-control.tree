# NEGATIVE CONTROL for code/set/base.tree: each set law there with one thing changed, so some membership makes it false.
# Every one must be refused. A build that accepted one would mean the truth table decides a set law that does not hold.
# Expected: 8 refusals.
load @term/seed/atom/flag
  find flag

load @term/seed/set/base
  find set
  find has
  find empty
  find union
  find intersection
  find complement
  find difference
  find preimage
  find within

# false where x is in s and not in t
rule control-union-is-intersection
  head a
  seat s, like set a
  seat t, like set a
  seat x, like a
  show hold, is-equal has(union(s, t), x), has(intersection(t, s), x)

# false where x is in s and not in t: De Morgan without swapping the operation
rule control-de-morgan-without-the-swap
  head a
  seat s, like set a
  seat t, like set a
  seat x, like a
  show hold, is-equal has(complement(union(s, t)), x), has(union(complement(s), complement(t)), x)

# false everywhere: one complement taken for two
rule control-complement-is-the-set
  head a
  seat s, like set a
  seat x, like a
  show hold, is-equal has(complement(s), x), has(s, x)

# false where x is in s and not in t: the difference turned around
rule control-difference-the-wrong-way
  head a
  seat s, like set a
  seat t, like set a
  seat x, like a
  show hold, is-equal has(difference(s, t), x), has(intersection(complement(s), t), x)

# false where x is in t and not in s: subset is not symmetric
rule control-within-is-symmetric
  head a
  seat s, like set a
  seat t, like set a
  seat x, like a
  have s-within-t, is-equal within(s, t, x), make yes
  show hold, is-equal within(t, s, x), make yes

# false where f(x) is in s and not in t: a preimage of a union taken as one of an intersection
rule control-preimage-of-union-is-intersection
  head a
  head b
  seat f
    like task
      take y, like a
      like b
  seat s, like set b
  seat t, like set b
  seat x, like a
  show hold, is-equal has(preimage(f, union(s, t)), x), has(intersection(preimage(f, s), preimage(f, t)), x)

# false where x is in s and not in t: absorption keeping the other set
rule control-absorption-keeps-t
  head a
  seat s, like set a
  seat t, like set a
  seat x, like a
  show hold, is-equal has(intersection(s, union(s, t)), x), has(t, x)

# false everywhere: something in the empty set
rule control-empty-has-everything
  head a
  seat x, like a
  show hold, is-equal has(empty(), x), make yes
