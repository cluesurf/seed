# NEGATIVE CONTROL for hyperbolic 4-space in space/hyperbolic/hyperboloid. Expected refusals: 3.

task lorentz-form-four
  take u0, like integer
  take u1, like integer
  take u2, like integer
  take u3, like integer
  take u4, like integer
  take v0, like integer
  take v1, like integer
  take v2, like integer
  take v3, like integer
  take v4, like integer
  like integer
  send back
    call subtract
      call subtract
        call subtract
          call subtract
            call multiply
              read u0
              read v0
            call multiply
              read u1
              read v1
          call multiply
            read u2
            read v2
        call multiply
          read u3
          read v3
      call multiply
        read u4
        read v4

rule control-the-ball-distance-formula-in-four-dimensions
  seat p1, like integer
  seat p2, like integer
  seat p3, like integer
  seat p4, like integer
  seat q1, like integer
  seat q2, like integer
  seat q3, like integer
  seat q4, like integer
  show hold
    call is-equal
      call subtract
        call lorentz-form-four
          call add
            code 1
            call add
              call add
                call multiply
                  read p1
                  read p1
                call multiply
                  read p2
                  read p2
              call add
                call multiply
                  read p3
                  read p3
                call multiply
                  read p4
                  read p4
          call multiply
            code 3
            read p1
          call multiply
            code 2
            read p2
          call multiply
            code 2
            read p3
          call multiply
            code 2
            read p4
          call add
            code 1
            call add
              call add
                call multiply
                  read q1
                  read q1
                call multiply
                  read q2
                  read q2
              call add
                call multiply
                  read q3
                  read q3
                call multiply
                  read q4
                  read q4
          call multiply
            code 2
            read q1
          call multiply
            code 2
            read q2
          call multiply
            code 2
            read q3
          call multiply
            code 2
            read q4
        call multiply
          call subtract
            code 1
            call add
              call add
                call multiply
                  read p1
                  read p1
                call multiply
                  read p2
                  read p2
              call add
                call multiply
                  read p3
                  read p3
                call multiply
                  read p4
                  read p4
          call subtract
            code 1
            call add
              call add
                call multiply
                  read q1
                  read q1
                call multiply
                  read q2
                  read q2
              call add
                call multiply
                  read q3
                  read q3
                call multiply
                  read q4
                  read q4
      call multiply
        code 2
        call add
          call add
            call multiply
              call subtract
                read p1
                read q1
              call subtract
                read p1
                read q1
            call multiply
              call subtract
                read p2
                read q2
              call subtract
                read p2
                read q2
          call add
            call multiply
              call subtract
                read p3
                read q3
              call subtract
                read p3
                read q3
            call multiply
              call subtract
                read p4
                read q4
              call subtract
                read p4
                read q4

