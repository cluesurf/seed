# NEGATIVE CONTROL for space/hyperbolic/metric: 8 perturbed theorems, each must be refused. Expected: 8.

load @term/seed/space/hyperbolic/hyperboloid
  find lorentz-form
  find lorentz-cross-t
  find lorentz-cross-x
  find lorentz-cross-y

task coordinate-determinant
  take x0, like integer
  take x1, like integer
  take x2, like integer
  take y0, like integer
  take y1, like integer
  take y2, like integer
  take z0, like integer
  take z1, like integer
  take z2, like integer
  like integer
  send back
    call subtract
      call add
        call add
          call multiply
            read x0
            call multiply
              read y1
              read z2
          call multiply
            read x1
            call multiply
              read y2
              read z0
        call multiply
          read x2
          call multiply
            read y0
            read z1
      call add
        call add
          call multiply
            read x2
            call multiply
              read y1
              read z0
          call multiply
            read x1
            call multiply
              read y0
              read z2
        call multiply
          read x0
          call multiply
            read y2
            read z1

task gram-determinant
  take ga, like integer
  take gg, like integer
  take gc, like integer
  take gp, like integer
  take gq, like integer
  take gr, like integer
  like integer
  send back
    call subtract
      call add
        call multiply
          read ga
          call multiply
            read gg
            read gc
        call multiply
          code 2
          call multiply
            read gp
            call multiply
              read gq
              read gr
      call add
        call add
          call multiply
            read ga
            call multiply
              read gq
              read gq
          call multiply
            read gg
            call multiply
              read gr
              read gr
        call multiply
          read gc
          call multiply
            read gp
            read gp

rule control-side-angle-side-and-side-side-side
  mark a0, like integer
  mark a1, like integer
  mark a2, like integer
  mark b0, like integer
  mark b1, like integer
  mark b2, like integer
  mark c0, like integer
  mark c1, like integer
  mark c2, like integer
  mark p0, like integer
  mark p1, like integer
  mark p2, like integer
  mark q0, like integer
  mark q1, like integer
  mark q2, like integer
  mark r0, like integer
  mark r1, like integer
  mark r2, like integer
  show hold
    call is-equal
      call subtract
        call lorentz-form
          read b0
          read b1
          read b2
          read c0
          read c1
          read c2
        call lorentz-form
          read q0
          read q1
          read q2
          read r0
          read r1
          read r2
      call subtract
        call add
          call add
            call subtract
              call lorentz-form
                call subtract
                  read b0
                  call multiply
                    call lorentz-form
                      read b0
                      read b1
                      read b2
                      read a0
                      read a1
                      read a2
                    read a0
                call subtract
                  read b1
                  call multiply
                    call lorentz-form
                      read b0
                      read b1
                      read b2
                      read a0
                      read a1
                      read a2
                    read a1
                call subtract
                  read b2
                  call multiply
                    call lorentz-form
                      read b0
                      read b1
                      read b2
                      read a0
                      read a1
                      read a2
                    read a2
                call subtract
                  read c0
                  call multiply
                    call lorentz-form
                      read c0
                      read c1
                      read c2
                      read a0
                      read a1
                      read a2
                    read a0
                call subtract
                  read c1
                  call multiply
                    call lorentz-form
                      read c0
                      read c1
                      read c2
                      read a0
                      read a1
                      read a2
                    read a1
                call subtract
                  read c2
                  call multiply
                    call lorentz-form
                      read c0
                      read c1
                      read c2
                      read a0
                      read a1
                      read a2
                    read a2
              call lorentz-form
                call subtract
                  read q0
                  call multiply
                    call lorentz-form
                      read q0
                      read q1
                      read q2
                      read p0
                      read p1
                      read p2
                    read p0
                call subtract
                  read q1
                  call multiply
                    call lorentz-form
                      read q0
                      read q1
                      read q2
                      read p0
                      read p1
                      read p2
                    read p1
                call subtract
                  read q2
                  call multiply
                    call lorentz-form
                      read q0
                      read q1
                      read q2
                      read p0
                      read p1
                      read p2
                    read p2
                call subtract
                  read r0
                  call multiply
                    call lorentz-form
                      read r0
                      read r1
                      read r2
                      read p0
                      read p1
                      read p2
                    read p0
                call subtract
                  read r1
                  call multiply
                    call lorentz-form
                      read r0
                      read r1
                      read r2
                      read p0
                      read p1
                      read p2
                    read p1
                call subtract
                  read r2
                  call multiply
                    call lorentz-form
                      read r0
                      read r1
                      read r2
                      read p0
                      read p1
                      read p2
                    read p2
            call add
              call multiply
                call lorentz-form
                  read a0
                  read a1
                  read a2
                  read b0
                  read b1
                  read b2
                call subtract
                  call lorentz-form
                    read a0
                    read a1
                    read a2
                    read c0
                    read c1
                    read c2
                  call lorentz-form
                    read p0
                    read p1
                    read p2
                    read r0
                    read r1
                    read r2
              call multiply
                call lorentz-form
                  read p0
                  read p1
                  read p2
                  read r0
                  read r1
                  read r2
                call subtract
                  call lorentz-form
                    read a0
                    read a1
                    read a2
                    read b0
                    read b1
                    read b2
                  call lorentz-form
                    read p0
                    read p1
                    read p2
                    read q0
                    read q1
                    read q2
          call multiply
            call multiply
              call lorentz-form
                read p0
                read p1
                read p2
                read q0
                read q1
                read q2
              call lorentz-form
                read p0
                read p1
                read p2
                read r0
                read r1
                read r2
            call subtract
              call lorentz-form
                read p0
                read p1
                read p2
                read p0
                read p1
                read p2
              code 2
        call multiply
          call multiply
            call lorentz-form
              read a0
              read a1
              read a2
              read b0
              read b1
              read b2
            call lorentz-form
              read a0
              read a1
              read a2
              read c0
              read c1
              read c2
          call subtract
            call lorentz-form
              read a0
              read a1
              read a2
              read a0
              read a1
              read a2
            code 1

rule control-the-gram-determinant-is-the-square-of-the-determinant
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark y0, like integer
  mark y1, like integer
  mark y2, like integer
  mark z0, like integer
  mark z1, like integer
  mark z2, like integer
  show hold
    call is-equal
      call gram-determinant
        call lorentz-form
          read x0
          read x1
          read x2
          read x0
          read x1
          read x2
        call lorentz-form
          read y0
          read y1
          read y2
          read y0
          read y1
          read y2
        call lorentz-form
          read z0
          read z1
          read z2
          read z0
          read z1
          read z2
        call lorentz-form
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
        call lorentz-form
          read y0
          read y1
          read y2
          read z0
          read z1
          read z2
        call lorentz-form
          read x0
          read x1
          read x2
          read z0
          read z1
          read z2
      call add
        call coordinate-determinant
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
          read z0
          read z1
          read z2
        call coordinate-determinant
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
          read z0
          read z1
          read z2

rule control-the-triangle-inequality
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark y0, like integer
  mark y1, like integer
  mark y2, like integer
  mark z0, like integer
  mark z1, like integer
  mark z2, like integer
  have x-point
    call is-equal
      call lorentz-form
        read x0
        read x1
        read x2
        read x0
        read x1
        read x2
      code 2
  have y-point
    call is-equal
      call lorentz-form
        read y0
        read y1
        read y2
        read y0
        read y1
        read y2
      code 1
  have z-point
    call is-equal
      call lorentz-form
        read z0
        read z1
        read z2
        read z0
        read z1
        read z2
      code 1
  show hold
    call is-equal
      call subtract
        call multiply
          call subtract
            call multiply
              call lorentz-form
                read x0
                read x1
                read x2
                read y0
                read y1
                read y2
              call lorentz-form
                read x0
                read x1
                read x2
                read y0
                read y1
                read y2
            code 1
          call subtract
            call multiply
              call lorentz-form
                read y0
                read y1
                read y2
                read z0
                read z1
                read z2
              call lorentz-form
                read y0
                read y1
                read y2
                read z0
                read z1
                read z2
            code 1
        call multiply
          call subtract
            call lorentz-form
              read x0
              read x1
              read x2
              read z0
              read z1
              read z2
            call multiply
              call lorentz-form
                read x0
                read x1
                read x2
                read y0
                read y1
                read y2
              call lorentz-form
                read y0
                read y1
                read y2
                read z0
                read z1
                read z2
          call subtract
            call lorentz-form
              read x0
              read x1
              read x2
              read z0
              read z1
              read z2
            call multiply
              call lorentz-form
                read x0
                read x1
                read x2
                read y0
                read y1
                read y2
              call lorentz-form
                read y0
                read y1
                read y2
                read z0
                read z1
                read z2
      call multiply
        call coordinate-determinant
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
          read z0
          read z1
          read z2
        call coordinate-determinant
          read x0
          read x1
          read x2
          read y0
          read y1
          read y2
          read z0
          read z1
          read z2

rule control-between-is-additive
  mark x0, like integer
  mark x1, like integer
  mark x2, like integer
  mark z0, like integer
  mark z1, like integer
  mark z2, like integer
  mark lam, like integer
  mark mu, like integer
  show hold
    call is-equal
      call subtract
        call multiply
          call lorentz-form
            read x0
            read x1
            read x2
            read z0
            read z1
            read z2
          call lorentz-form
            call add
              call multiply
                read mu
                read x0
              call multiply
                read mu
                read z0
            call add
              call multiply
                read lam
                read x1
              call multiply
                read mu
                read z1
            call add
              call multiply
                read lam
                read x2
              call multiply
                read mu
                read z2
            call add
              call multiply
                read lam
                read x0
              call multiply
                read mu
                read z0
            call add
              call multiply
                read lam
                read x1
              call multiply
                read mu
                read z1
            call add
              call multiply
                read lam
                read x2
              call multiply
                read mu
                read z2
        call multiply
          call lorentz-form
            read x0
            read x1
            read x2
            call add
              call multiply
                read lam
                read x0
              call multiply
                read mu
                read z0
            call add
              call multiply
                read lam
                read x1
              call multiply
                read mu
                read z1
            call add
              call multiply
                read lam
                read x2
              call multiply
                read mu
                read z2
          call lorentz-form
            call add
              call multiply
                read lam
                read x0
              call multiply
                read mu
                read z0
            call add
              call multiply
                read lam
                read x1
              call multiply
                read mu
                read z1
            call add
              call multiply
                read lam
                read x2
              call multiply
                read mu
                read z2
            read z0
            read z1
            read z2
      call multiply
        call multiply
          read lam
          read mu
        call subtract
          call multiply
            call lorentz-form
              read x0
              read x1
              read x2
              read z0
              read z1
              read z2
            call lorentz-form
              read x0
              read x1
              read x2
              read z0
              read z1
              read z2
          call multiply
            call lorentz-form
              read x0
              read x1
              read x2
              read x0
              read x1
              read x2
            call lorentz-form
              read z0
              read z1
              read z2
              read z0
              read z1
              read z2

rule control-the-fixed-point-discriminant-is-the-trace-squared-minus-four
  mark ma, like integer
  mark mb, like integer
  mark mc, like integer
  mark md, like integer
  show hold
    call is-equal
      call add
        call multiply
          call subtract
            read md
            read ma
          call subtract
            read md
            read ma
        call multiply
          code 3
          call multiply
            read mb
            read mc
      call subtract
        call multiply
          call add
            read ma
            read md
          call add
            read ma
            read md
        call multiply
          code 4
          call subtract
            call multiply
              read ma
              read md
            call multiply
              read mb
              read mc

rule control-the-cayley-map-scales-differences
  mark z1, like integer
  mark z2, like integer
  mark i, like integer
  show hold
    call is-equal
      call subtract
        call multiply
          call subtract
            read z1
            read i
          call add
            read z2
            read i
        call multiply
          call subtract
            read z2
            read i
          call add
            read z1
            read i
      call multiply
        call multiply
          code 3
          read i
        call subtract
          read z1
          read z2

rule control-lobachevsky-cos-of-the-angle-of-parallelism-is-tanh-d
  mark ch, like integer
  mark sh, like integer
  mark co, like integer
  mark si, like integer
  show hold
    call is-equal
      call subtract
        call multiply
          call multiply
            read ch
            read ch
          call multiply
            read si
            read si
        call multiply
          read sh
          read sh
      call subtract
        call subtract
          call multiply
            call multiply
              read ch
              read ch
            call subtract
              call add
                call multiply
                  read si
                  read si
                call multiply
                  read co
                  read co
              code 1
          call subtract
            call multiply
              call multiply
                read ch
                read ch
              call multiply
                read co
                read co
            code 1
        call subtract
          call subtract
            call multiply
              read ch
              read ch
            call multiply
              read sh
              read sh
          code 1

rule control-a-circle-is-traced-at-speed-sinh-r
  mark sr, like integer
  mark co, like integer
  mark si, like integer
  have unit-direction
    call is-equal
      call add
        call multiply
          read co
          read co
        call multiply
          read si
          read si
      code 1
  show hold
    call is-equal
      call subtract
        code 0
        call lorentz-form
          code 0
          call subtract
            code 0
            call multiply
              read sr
              read si
          call multiply
            read sr
            read co
          code 0
          call subtract
            code 0
            call multiply
              read sr
              read si
          call multiply
            read sr
            read co
      call multiply
        read sr
        read co
