# NEGATIVE CONTROLS for integral/hyperbolic-functions: each must be REFUSED. Expected: 3.

# false: cosh(w) - 1 is about w^2 / 2, not below w^2 / 4
rule control-cosh-near-zero-too-tight
  seat w, like integer
  seat ee, like integer
  seat rr, like integer
  have w-is-in-the-unit-interval
    meet and
      call is-minimum
        read w
        code 0
      call is-maximum
        read w
        code 1
  have e-is-above-its-second-order-part
    call is-minimum
      call subtract
        call multiply
          code 2
          read ee
        call add
          call add
            code 2
            call multiply
              code 2
              read w
          call multiply
            read w
            read w
      code 0
  have e-is-below-its-third-order-bound
    call is-maximum
      call subtract
        call multiply
          code 6
          read ee
        call add
          call add
            code 6
            call multiply
              code 6
              read w
          call multiply
            call multiply
              code 3
              read w
            read w
      call multiply
        call multiply
          call multiply
            code 2
            read w
          read w
        read w
  have rr-is-its-reciprocal
    call is-equal
      call multiply
        read ee
        read rr
      code 1
  have rr-is-positive
    call is-above
      read rr
      code 0
  show hold
    call is-maximum
      call multiply
        code 4
        call subtract
          call add
            read ee
            read rr
          code 2
      call multiply
        call multiply
          code 2
          read w
        read w


# false: an inverse of a number below 1 exceeds 1
rule control-an-inverse-without-a-lower-bound
  seat ee, like integer
  seat rr, like integer
  have rr-inverts
    call is-equal
      call multiply
        read ee
        read rr
      code 1
  have rr-is-positive
    call is-above
      read rr
      code 0
  show hold
    call is-maximum
      read rr
      code 1


# false: the reciprocal part adds its own delta
rule control-cosh-addition-with-half-the-error
  seat ex, like integer
  seat ew, like integer
  seat es, like integer
  seat rs, like integer
  seat pp, like integer
  seat q, like integer
  seat dd, like integer
  seat delta, like integer
  have dd-is-the-error-of-e
    call is-equal
      read dd
      call subtract
        call multiply
          read ex
          read ew
        read es
  have the-reciprocal-difference
    call is-equal
      call subtract
        read rs
        read pp
      call multiply
        read q
        read dd
  have the-error-scaled
    meet and
      call is-maximum
        call multiply
          read q
          read dd
        read delta
      call is-maximum
        call subtract
          code 0
          call multiply
            read q
            read dd
        read delta
  have the-error-is-small
    meet and
      call is-maximum
        read dd
        read delta
      call is-maximum
        call subtract
          code 0
          read dd
        read delta
  show hold
    call is-maximum
      call subtract
        call add
          read es
          read rs
        call add
          call multiply
            read ex
            read ew
          read pp
      read delta
