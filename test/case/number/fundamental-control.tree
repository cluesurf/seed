# NEGATIVE CONTROLS for integral/fundamental: each must be REFUSED. Expected: 6.

# false: without the turning identity the angles say nothing about the area
rule control-gauss-bonnet-without-the-turning
  seat ar
    like task
      take a0, like integer
      like integer
  seat ps
    like task
      take a0, like integer
      like integer
  seat th
    like task
      take a0, like integer
      like integer
  seat c
    like task
      take a0, like integer
      like integer
  seat ia
    like task
      take a0, like integer
      like integer
  seat ip
    like task
      take a0, like integer
      like integer
  seat it
    like task
      take a0, like integer
      like integer
  seat n, like integer
  seat w, like integer
  seat eps, like integer
  have the-area-follows-its-increment
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      meet and
        call is-maximum
          call subtract
            call subtract
              call ar
                call add
                  read i
                  code 1
              call ar
                read i
            call ia
              read i
          call multiply
            read eps
            read w
        call is-maximum
          call subtract
            call ia
              read i
            call subtract
              call ar
                call add
                  read i
                  code 1
              call ar
                read i
          call multiply
            read eps
            read w
  have psi-follows-its-increment
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      meet and
        call is-maximum
          call subtract
            call subtract
              call ps
                call add
                  read i
                  code 1
              call ps
                read i
            call ip
              read i
          call multiply
            read eps
            read w
        call is-maximum
          call subtract
            call ip
              read i
            call subtract
              call ps
                call add
                  read i
                  code 1
              call ps
                read i
          call multiply
            read eps
            read w
  have theta-follows-its-increment
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      meet and
        call is-maximum
          call subtract
            call subtract
              call th
                call add
                  read i
                  code 1
              call th
                read i
            call it
              read i
          call multiply
            read eps
            read w
        call is-maximum
          call subtract
            call it
              read i
            call subtract
              call th
                call add
                  read i
                  code 1
              call th
                read i
          call multiply
            read eps
            read w
  have the-area-element
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call ia
          read i
        call subtract
          call multiply
            call c
              read i
            call it
              read i
          call it
            read i
  have the-width-is-positive
    call is-above
      read w
      code 0
  have the-tolerance-is-not-negative
    call is-minimum
      read eps
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    meet and
      call is-maximum
        call add
          call add
            call subtract
              call ar
                read n
              call ar
                code 0
            call subtract
              call ps
                read n
              call ps
                code 0
          call subtract
            call th
              read n
            call th
              code 0
        call multiply
          call multiply
            call multiply
              code 3
              read eps
            read n
          read w
      call is-maximum
        call subtract
          code 0
          call add
            call add
              call subtract
                call ar
                  read n
                call ar
                  code 0
              call subtract
                call ps
                  read n
                call ps
                  code 0
            call subtract
              call th
                read n
              call th
                code 0
        call multiply
          call multiply
            call multiply
              code 3
              read eps
            read n
          read w
  fold n


# false: big w^2 alone does not bound the step (cosh x = sinh x = big, cosh w - 1 = w^2, sinh w - w = w^3)
rule control-cosh-without-the-cube
  seat cc
    like task
      take a0, like integer
      like integer
  seat ss
    like task
      take a0, like integer
      like integer
  seat x, like integer
  seat w, like integer
  seat big, like integer
  have the-addition-formula
    seat a, like integer
    seat b, like integer
    call is-equal
      call cc
        call add
          read a
          read b
      call add
        call multiply
          call cc
            read a
          call cc
            read b
        call multiply
          call ss
            read a
          call ss
            read b
  have cosh-near-zero
    seat u, like integer
    meet or
      call is-below
        read u
        code 0
      call is-above
        read u
        code 1
      meet and
        call is-minimum
          call subtract
            call cc
              read u
            code 1
          code 0
        call is-maximum
          call subtract
            call cc
              read u
            code 1
          call multiply
            read u
            read u
  have sinh-near-zero
    seat u, like integer
    meet or
      call is-below
        read u
        code 0
      call is-above
        read u
        code 1
      meet and
        call is-minimum
          call subtract
            call ss
              read u
            read u
          code 0
        call is-maximum
          call subtract
            call ss
              read u
            read u
          call multiply
            call multiply
              read u
              read u
            read u
  have the-step-is-small
    meet and
      call is-minimum
        read w
        code 0
      call is-maximum
        read w
        code 1
  have cosh-is-bounded-here
    meet and
      call is-minimum
        call cc
          read x
        code 0
      call is-maximum
        call cc
          read x
        read big
  have sinh-is-bounded-here
    meet and
      call is-minimum
        call ss
          read x
        code 0
      call is-maximum
        call ss
          read x
        read big
  have the-bound-is-not-negative
    call is-minimum
      read big
      code 0
  show hold
    call is-maximum
      call subtract
        call subtract
          call cc
            call add
              read x
              read w
          call cc
            read x
        call multiply
          call ss
            read x
          read w
      call multiply
        call multiply
          read big
          read w
        read w


# false: eps n w / 2 is not enough
rule control-half-the-tolerance
  seat bigf
    like task
      take a0, like integer
      like integer
  seat f
    like task
      take a0, like integer
      like integer
  seat pt
    like task
      take a0, like integer
      like integer
  seat sum
    like task
      take a0, like integer
      like integer
  seat n, like integer
  seat w, like integer
  seat eps, like integer
  have the-points-are-evenly-spaced
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call subtract
          call pt
            call add
              read i
              code 1
          call pt
            read i
        read w
  have bigf-has-derivative-f-at-the-mesh
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      meet and
        call is-maximum
          call subtract
            call subtract
              call bigf
                call pt
                  call add
                    read i
                    code 1
              call bigf
                call pt
                  read i
            call multiply
              call f
                call pt
                  read i
              read w
          call multiply
            read eps
            read w
        call is-maximum
          call subtract
            call multiply
              call f
                call pt
                  read i
              read w
            call subtract
              call bigf
                call pt
                  call add
                    read i
                    code 1
              call bigf
                call pt
                  read i
          call multiply
            read eps
            read w
  have the-riemann-sum-starts-at-zero
    call is-equal
      call sum
        code 0
      code 0
  have the-riemann-sum-adds-a-strip
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call sum
          call add
            read i
            code 1
        call add
          call sum
            read i
          call multiply
            call f
              call pt
                read i
            read w
  have the-width-is-positive
    call is-above
      read w
      code 0
  have the-tolerance-is-not-negative
    call is-minimum
      read eps
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-maximum
      call subtract
        call sum
          read n
        call subtract
          call bigf
            call pt
              read n
          call bigf
            call pt
              code 0
      call subtract
        call multiply
          call multiply
            read eps
            read n
          read w
        call multiply
          read eps
          read w
  fold n


# false: without the derivative hypothesis the sum says nothing
rule control-without-the-derivative
  seat bigf
    like task
      take a0, like integer
      like integer
  seat f
    like task
      take a0, like integer
      like integer
  seat pt
    like task
      take a0, like integer
      like integer
  seat sum
    like task
      take a0, like integer
      like integer
  seat n, like integer
  seat w, like integer
  seat eps, like integer
  have the-points-are-evenly-spaced
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call subtract
          call pt
            call add
              read i
              code 1
          call pt
            read i
        read w
  have the-riemann-sum-starts-at-zero
    call is-equal
      call sum
        code 0
      code 0
  have the-riemann-sum-adds-a-strip
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call sum
          call add
            read i
            code 1
        call add
          call sum
            read i
          call multiply
            call f
              call pt
                read i
            read w
  have the-width-is-positive
    call is-above
      read w
      code 0
  have the-tolerance-is-not-negative
    call is-minimum
      read eps
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-maximum
      call subtract
        call sum
          read n
        call subtract
          call bigf
            call pt
              read n
          call bigf
            call pt
              code 0
      call multiply
        call multiply
          read eps
          read n
        read w
  fold n


# false: from 0 <= x(t) y <= 1 for every t nothing gives x(0) y >= 7. (A prover that assumed a hypothesis's NEGATION
# would hold x(0) y > 1 and x(0) y < 0 together, and prove this from the contradiction.)
rule control-a-two-sided-nonlinear-hypothesis
  seat x
    like task
      take a0, like integer
      like integer
  seat y, like integer
  have bounded
    seat t, like integer
    meet and
      call is-maximum
        call multiply
          call x
            read t
          read y
        code 1
      call is-minimum
        call multiply
          call x
            read t
          read y
        code 0
  show hold
    call is-minimum
      call multiply
        call x
          code 0
        read y
      code 7


# false: the telescoped sum is cc(n) - cc(0), not cc(n)
rule control-the-disk-sum-off-by-one
  seat cc
    like task
      take a0, like integer
      like integer
  seat mid
    like task
      take a0, like integer
      like integer
  seat acc
    like task
      take a0, like integer
      like integer
  seat n, like integer
  seat s, like integer
  have each-strip-is-a-difference
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call subtract
          call cc
            call add
              read i
              code 1
          call cc
            read i
        call multiply
          call multiply
            code 2
            read s
          call mid
            read i
  have the-sum-starts-at-zero
    call is-equal
      call acc
        code 0
      code 0
  have the-sum-adds-a-strip
    seat i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call acc
          call add
            read i
            code 1
        call add
          call acc
            read i
          call multiply
            call multiply
              code 2
              read s
            call mid
              read i
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-equal
      call acc
        read n
      call cc
        read n
  fold n
