# NEGATIVE CONTROLS for integral/disk: each must be REFUSED. Expected: 1.

# false: the error carries the mesh term 2 p
rule control-the-disk-area-without-the-mesh-error
  seat ss, like integer
  seat dd, like integer
  seat nt, like integer
  seat q, like integer
  seat r, like integer
  seat w, like integer
  seat nd, like integer
  seat eps, like integer
  seat p, like integer
  have the-sums-are-within-n-tol
    meet and
      call is-maximum
        call subtract
          read ss
          read dd
        read nt
      call is-maximum
        call subtract
          code 0
          call subtract
            read ss
            read dd
        read nt
  have the-step-errors-sum
    call is-equal
      read nt
      call add
        call add
          call multiply
            read q
            read r
          call multiply
            call multiply
              read q
              read r
            read w
        read nd
  have the-exponential-errors-sum
    call is-maximum
      read nd
      call multiply
        read eps
        read r
  have the-mesh-errors-sum
    call is-maximum
      call add
        call multiply
          read q
          read r
        call multiply
          call multiply
            read q
            read r
          read w
      call multiply
        code 2
        read p
  show hold
    call is-maximum
      call subtract
        read ss
        read dd
      call multiply
        read eps
        read r
