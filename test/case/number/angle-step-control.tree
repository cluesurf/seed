# NEGATIVE CONTROLS for integral/angle, false only in the induction step: each must be REFUSED. Expected: 2.
# Needs the fast refusal in check/product.ts in the build that runs it.

# false: the sums differ by the fall of f times w
rule control-the-upper-sum-equals-the-lower-sum-at-every-n
  mark fl
    like task
      take a0, like integer
      like integer
  mark up
    like task
      take a0, like integer
      like integer
  mark lo
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark w, like integer
  have up-starts-at-zero
    call is-equal
      call up
        code 0
      code 0
  have lo-starts-at-zero
    call is-equal
      call lo
        code 0
      code 0
  have up-adds-a-left-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call up
          call add
            read i
            code 1
        call add
          call up
            read i
          call multiply
            call fl
              read i
            read w
  have lo-adds-a-right-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call lo
          call add
            read i
            code 1
        call add
          call lo
            read i
          call multiply
            call fl
              call add
                read i
                code 1
            read w
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-equal
      call up
        read n
      call lo
        read n
  fold n


# false: refining raises the lower sum
rule control-halving-the-mesh-lowers-the-lower-sum-at-every-n
  mark fp
    like task
      take a0, like integer
      like integer
  mark fo
    like task
      take a0, like integer
      like integer
  mark ll
    like task
      take a0, like integer
      like integer
  mark mm
    like task
      take a0, like integer
      like integer
  mark n, like integer
  mark w, like integer
  have ll-adds-a-strip
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call ll
          call add
            read i
            code 1
        call add
          call ll
            read i
          call multiply
            call fp
              call add
                read i
                code 1
            read w
  have mm-adds-two-half-strips
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-equal
        call multiply
          code 2
          call mm
            call add
              read i
              code 1
        call add
          call add
            call multiply
              code 2
              call mm
                read i
            call multiply
              call fo
                read i
              read w
          call multiply
            call fp
              call add
                read i
                code 1
            read w
  have the-odd-strip-is-at-least-the-right-end
    mark i, like integer
    meet or
      call is-below
        read i
        code 0
      call is-minimum
        call multiply
          call fo
            read i
          read w
        call multiply
          call fp
            call add
              read i
              code 1
          read w
  have ll-starts-at-zero
    call is-equal
      call ll
        code 0
      code 0
  have mm-starts-at-zero
    call is-equal
      call mm
        code 0
      code 0
  have the-width-is-not-negative
    call is-minimum
      read w
      code 0
  have n-is-a-count
    call is-minimum
      read n
      code 0
  show hold
    call is-maximum
      call mm
        read n
      call ll
        read n
  fold n
